
---
/**
 * VentureBean Business Solutions
 * Route: /solutions-page-scalewise/
 */

import GlobalHero from "../../components/global/global-hero.astro";
import Idealfor from "../../components/solutions/Idealfor.astro";
import OutcomeSection from "../../components/solutions/OutcomeSection.astro";
import SolutionDetails from "../../components/solutions/SolutionDetails.astro";
import Layout from "../../layouts/Layout.astro";
import SolutionCTA from "../../components/solutions/SolutionCTA.astro";
---

<Layout page="case-studies">
  <main id="content" class="w-full min-w-0 overflow-x-clip">

    <!-- HERO -->
    <GlobalHero
      title="Structure Growth Without Losing Speed"
      subtitle="ScaleWise"
      image="/images/solutions/scalewise.jpg"
      showButton={false}
    />

    <!-- IDEAL FOR + BEST SUITED -->
    <Idealfor
      idealFor={[
        { title: "Growing SMEs and SMBs" },
        { title: "Founder-led businesses" },
        { title: "Scaling organisations" },
        { title: "Businesses seeking operational excellence" },
      ]}
      bestSuited="The business is growing rapidly but facing operational chaos, founder dependency, inconsistent delivery or team misalignment. OR the business growth is stagnant and/or issues are being faced with scaling, accountability, response time and quality."
    />

    <!-- CHALLENGES + WHAT'S INCLUDED -->
    <SolutionDetails
      challenges={[
        "Founder overload and bottlenecks",
        "Lack of systems and SOPs",
        "Weak accountability across functions",
        "Inconsistent execution and delivery",
        "Teams scaling faster than structure",
      ]}
      included={[
        "Gap-identification in current 'as-is' state",
        "Organisation and role structuring",
        "KPI/KRA framework development",
        "SOP and workflow design",
        "Strategic growth roadmap",
        "Profitability and operational review",
        "Governance and review cadence",
        "Leadership coaching for key managers and founders",
      ]}
    />

    <!-- OUTCOME -->
    <OutcomeSection
      heading="Outcome"
      description="Transform growth into a structured, scalable, and well-managed business."
      backgroundImage="/images/solutions/outcome-background.jpg"
      outcomes={[
        {
          icon: "structure",
          description: "Stronger operational systems that improve execution and consistency",
        },
        {
          icon: "direction",
          description: "Clear accountability across teams, functions, and leadership",
        },
        {
          icon: "growth",
          description: "Sustainable growth driven by disciplined processes and governance",
        },
      ]}
    />

    <!-- CALL TO ACTION -->
    <SolutionCTA
      heading="Ready to Strengthen Your Organisation?"
      description="Let's start with a simple, strategic conversation to understand what your business needs."
      ctaLabel="Book a Discovery Call"
      ctaHref="/contact/"
      backLabel="Back to Solutions"
      backHref="/solutions/"
    />

  </main>
</Layout>
