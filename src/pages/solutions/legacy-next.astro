
---
/**
 * VentureBean Business Solutions
 * Route: /legacynext/
 */

import GlobalHero from "../../components/global/global-hero.astro";
import ChallengesWeSolve from "../../components/solutions/ChallengesWeSolve.astro";
import Idealfor from "../../components/solutions/Idealfor.astro";
import OutcomeSection from "../../components/solutions/OutcomeSection.astro";
import SolutionDetails from "../../components/solutions/SolutionDetails.astro";
import Layout from "../../layouts/Layout.astro";
import SolutionCTA from "../../components/solutions/SolutionCTA.astro";

import VBButton from "../../components/global/VBButton.astro";
---

<Layout page="case-studies">
  <main id="content" class="w-full min-w-0 overflow-x-clip">

    <!-- HERO -->
    <GlobalHero
      title="Professionalise and Future-Proof Family Businesses"
      subtitle="LegacyNext"
      image="/images/solutions/legacynext.jpg"
      showButton={false}
    />

    <!-- IDEAL FOR + BEST SUITED -->
    <Idealfor
      idealHeading="Ideal for"
      idealFor={[
        { title: "Family-owned businesses" },
        { title: "Second-generation enterprises" },
        { title: "Succession-stage organisations" },
        { title: "Family business leadership teams" },
      ]}
      bestSuited="Leadership transition, governance gaps, role ambiguity, or generational differences begin affecting business continuity and decision-making."
    />

    <!-- CHALLENGES + WHAT'S INCLUDED -->
    <SolutionDetails
      challenges={[
        "Succession uncertainty",
        "Role overlap between family and business",
        "Lack of governance structures and poor functional processes",
        "Generational conflict and misalignment, lack of accountability",
        "Informal decision-making processes",
      ]}
      included={[
        "Family governance framework",
        "Succession and transition planning",
        "Role clarity and accountability mapping",
        "Leadership coaching for next-generation leaders",
        "Legacy and alignment workshops",
        "Governance review mechanisms",
        "Advisory and board structuring support",
      ]}
    />

    <!-- OUTCOME -->
    <OutcomeSection
      heading="Outcome"
      description="Strengthen continuity while preparing your family business for the future."
      backgroundImage="/images/solutions/outcome-background.jpg"
      outcomes={[
        {
          icon: "structure",
          description: "Clear governance, defined roles, and structured decision-making",
        },
        {
          icon: "direction",
          description: "Smooth leadership transition with greater succession readiness",
        },
        {
          icon: "growth",
          description: "A future-ready business that preserves family values and legacy",
        },
      ]}
    />

    <!-- CALL TO ACTION -->
    <SolutionCTA
      heading="Ready to Strengthen Your Organisation?"
      description="Let's start with a simple, strategic conversation to understand what your business needs."
      ctaLabel="Book a Discovery Call"
      ctaHref="/contact/"
      backLabel="Back to Solutions"
      backHref="/solutions/"
    />

  </main>
</Layout>
