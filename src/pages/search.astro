---
/**
 * Search results → /search/?s=<words>
 * Searches the site's pages and everything published in the Content Manager
 * (src/lib/search.ts). The header search box and old WordPress-style links
 * (/?s=…) land here.
 */
import Layout from '../layouts/Layout.astro';
import { search } from '../lib/search';

export const prerender = false;

const query = (Astro.url.searchParams.get('s') ?? Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const { results, total } = query ? await search(query, 60) : { results: [], total: 0 };

const fmt = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' }) : '';

const title = query ? `Search results for “${query}” | VentureBean` : 'Search | VentureBean';
---

<Layout
  page="knowledge-hub"
  title={title}
  description="Search VentureBean's services, case studies, blogs and Knowledge Hub."
  canonical="https://venturebean.com/search/"
>
  <main id="content" class="vb-search-page">
    <section class="vb-search-hero">
      <div class="vb-search-wrap">
        <p class="vb-search-eyebrow">Search VentureBean</p>
        <form class="vb-search-form" action="/search/" method="get" role="search">
          <label for="vb-search-q" class="vb-screen-only">Search</label>
          <i class="fas fa-search" aria-hidden="true"></i>
          <input id="vb-search-q" type="search" name="s" value={query} placeholder="Search services, blogs, case studies…" autocomplete="off" autofocus={!query} />
          <button type="submit">Search</button>
        </form>
        {
          query && (
            <p class="vb-search-count" aria-live="polite">
              {total === 0 ? 'No results' : total === 1 ? '1 result' : `${total} results`} for <strong>“{query}”</strong>
              {total > results.length && ` (showing the top ${results.length})`}
            </p>
          )
        }
      </div>
    </section>

    <section class="vb-search-body">
      <div class="vb-search-wrap">
        {
          results.length > 0 && (
            <ul class="vb-search-results">
              {results.map((r) => (
                <li class="vb-search-result">
                  <a href={r.url} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener' : undefined}>
                    {r.image && <img src={r.image} alt="" loading="lazy" decoding="async" />}
                    <div class="vb-search-text">
                      <p class="vb-search-meta">
                        <span class="vb-search-kind">{r.kind}</span>
                        {r.date && <span>{fmt(r.date)}</span>}
                        {r.external && (
                          <span>
                            External <i class="fas fa-external-link-alt" aria-hidden="true" />
                          </span>
                        )}
                      </p>
                      <h2>{r.title}</h2>
                      {r.excerpt && <p class="vb-search-excerpt">{r.excerpt}</p>}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        {
          query && results.length === 0 && (
            <div class="vb-search-empty">
              <h2>Nothing matched “{query}”</h2>
              <p>Try fewer or different words, or start from one of these:</p>
            </div>
          )
        }

        {
          (!query || results.length === 0) && (
            <ul class="vb-search-quick">
              <li><a href="/business-consulting/">Business Consulting</a></li>
              <li><a href="/coaching/">Coaching</a></li>
              <li><a href="/organisational-development/">Organisational Development</a></li>
              <li><a href="/assessments/">Assessment</a></li>
              <li><a href="/case-studies/">Case Studies</a></li>
              <li><a href="/knowledge-hub/insights/">Insights</a></li>
              <li><a href="/contact-us/">Contact Us</a></li>
            </ul>
          )
        }
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  .vb-search-page {
    --vb-navy: #100057;
    --vb-accent: #8b2332;
    font-family: inherit;
    color: #1d1d2c;
  }
  .vb-search-wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .vb-search-hero {
    background: var(--vb-navy);
    color: #fff;
    padding: 120px 0 44px;
  }
  .vb-search-eyebrow {
    margin: 0 0 14px;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .vb-search-form {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border-radius: 999px;
    padding: 6px 6px 6px 22px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
  }
  .vb-search-form > i {
    color: var(--vb-navy);
    opacity: 0.6;
  }
  .vb-search-form input {
    flex: 1;
    min-width: 0;
    border: 0 !important;
    outline: none;
    background: transparent !important;
    font: inherit;
    font-size: 17px;
    color: #1d1d2c;
    padding: 12px 4px !important;
    box-shadow: none !important;
  }
  .vb-search-form button {
    border: 0;
    border-radius: 999px;
    background: var(--vb-accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    padding: 12px 26px;
    cursor: pointer;
  }
  .vb-search-form button:hover {
    opacity: 0.9;
  }
  .vb-search-count {
    margin: 18px 0 0;
    font-size: 15px;
    opacity: 0.9;
  }
  .vb-search-body {
    padding: 40px 0 80px;
    background: #f7f7fb;
    min-height: 40vh;
  }
  .vb-search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .vb-search-result a {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    text-decoration: none;
    color: inherit;
    border: 1px solid #e8e8f0;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .vb-search-result a:hover {
    box-shadow: 0 10px 24px rgba(16, 0, 87, 0.1);
    transform: translateY(-2px);
  }
  .vb-search-result img {
    flex: 0 0 150px;
    width: 150px;
    height: 100px;
    object-fit: cover;
    border-radius: 8px;
  }
  .vb-search-text {
    min-width: 0;
  }
  .vb-search-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0 0 6px;
    font-size: 13px;
    color: #6b6b80;
  }
  .vb-search-kind {
    color: var(--vb-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .vb-search-result h2 {
    margin: 0 0 6px;
    font-size: 20px;
    line-height: 1.35;
    color: var(--vb-navy);
  }
  .vb-search-excerpt {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: #4a4a5c;
  }
  .vb-search-empty h2 {
    margin: 0 0 8px;
    color: var(--vb-navy);
    font-size: 24px;
  }
  .vb-search-empty p {
    margin: 0 0 20px;
    color: #4a4a5c;
  }
  .vb-search-quick {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .vb-search-quick a {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--vb-navy);
    color: var(--vb-navy);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    background: #fff;
  }
  .vb-search-quick a:hover {
    background: var(--vb-navy);
    color: #fff;
  }
  @media (max-width: 767px) {
    .vb-search-hero {
      padding: 96px 0 30px;
    }
    .vb-search-form {
      padding-left: 16px;
    }
    .vb-search-form button {
      padding: 12px 18px;
    }
    .vb-search-result a {
      flex-direction: column;
      padding: 16px;
    }
    .vb-search-result img {
      width: 100%;
      flex-basis: auto;
      height: 160px;
    }
    .vb-search-result h2 {
      font-size: 18px;
    }
  }
</style>
