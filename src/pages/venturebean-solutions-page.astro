 * Solutions page → /venturebean-solutions-page/
 * Each section lives in src/components/solutions/.
 */
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/solutions/HeroSlider.astro';
import ArchitectureOfScale from '../components/solutions/ArchitectureOfScale.astro';
import ChallengesWeSolve from '../components/solutions/ChallengesWeSolve.astro';
import OurSolutions from '../components/solutions/OurSolutions.astro';
