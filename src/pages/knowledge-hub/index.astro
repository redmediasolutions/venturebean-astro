---
/**
 * Knowledge Hub page → /knowledge-hub/
 */

import Layout from "../../layouts/Layout.astro";
import HeroSlider from "../../components/knowledge-hub/HeroSlider.astro";
import HubIntro from "../../components/knowledge-hub/HubIntro.astro";
import MediaSpotlight from "../../components/knowledge-hub/MediaSpotlight.astro";
import RecentUploadsHeading from "../../components/knowledge-hub/RecentUploadsHeading.astro";
import RecentUploads from "../../components/knowledge-hub/RecentUploads.astro";
import StayConnected from "../../components/knowledge-hub/StayConnected.astro";
import GlobalHero from "../../components/global/global-hero.astro";
---

<Layout page="knowledge-hub">
  <main
    id="content"
    class="w-full min-w-0 overflow-hidden bg-white"
  >
  <GlobalHero
      title="Strategic Intelligence Central"
      description="Your central repository for strategic insights, market analysis, and performance reports."
      subtitle="Knowledge Hub"
      image="https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1795028271274-solutions-banner-2.webp"
      showButton={true}
      buttonHref="/contact-us/"
      buttonText="Talk to Experts"
    />

    <HubIntro />

    <MediaSpotlight />

    <RecentUploadsHeading />

    <RecentUploads />

    <StayConnected />
  </main>
</Layout>
