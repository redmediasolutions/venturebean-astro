---
/**
 * Blog article → /<slug>/
 *
 * Handles published Coaching, Consulting, Industry Perspectives
 * and Framework (Toolkit) posts from the Content Manager.
 */

export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import ArticleHero from '../../../components/blog/article/ArticleHero.astro';
import ArticleHeroMobile from '../../../components/blog/article/ArticleHeroMobile.astro';
import ArticleBody from '../../../components/blog/article/ArticleBody.astro';
import RelatedPosts from '../../../components/blog/article/RelatedPosts.astro';

import {
  getPostBySlug,
  getArticlePosts,
  postPath,
  reportPdfOf,
} from '../../../lib/posts';

import { formatDate, prepareContent } from '../../../lib/article';

// Read the slug from the incoming URL.
const { slug } = Astro.params;

// Reserved static routes handled by separate pages.
const reserved = new Set([
  'about-us',
  'business-consulting',
  'case-studies',
  'clients',
  'coaching',
  'coaching-case-studies',
  'consulting-case-studies',
  'contact-us',
  'knowledge-hub',
  'testimonials',
  'venturebean-solutions-page',
  'insights',
  'media-spotlight',
  'industry-perspectives',
  'toolkit',
]);

if (!slug || reserved.has(slug)) {
  return Astro.redirect('/404');
}

// Fetch the requested article.
const post = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect('/404');
}

// Prepare article content and table of contents.
const { html: content, toc } = prepareContent(post.content);

// Determine the category for related articles.
const postCategorySlugs = post.categorySlugs.map((s) =>
  s.toLowerCase().trim()
);

const category =
  ['coaching', 'consulting'].find((c) =>
    postCategorySlugs.includes(c)
  ) ??
  postCategorySlugs[0] ??
  'consulting';

// Fetch related articles from the same category.
const all = (await getArticlePosts()) ?? [];

const related = all
  .filter(
    (p) =>
      p.slug !== post.slug &&
      p.categorySlugs.some(
        (s) => s.toLowerCase().trim() === category
      )
  )
  .slice(0, 4);

// Article metadata.
const date = formatDate(post.publishedAt);
const reportPdf = reportPdfOf(post);

const download = reportPdf
  ? {
      pdf: reportPdf,
      postId: post.id,
      slug: post.slug,
      title: post.title,
    }
  : null;

// Featured image.
const image = post.featuredImage?.url;
---

<Layout
  page="post"
  title={post.seoTitle || post.title}
  description={post.seoDescription || post.excerpt}
  canonical={`https://venturebean.com${postPath(post.slug)}`}
  image={image}
>
  <main
    id="content"
    class="w-full min-w-0 overflow-hidden bg-white"
    style={image ? `--article-hero-image: url("${image}")` : undefined}
  >
    <ArticleHero
      title={post.title}
      date={date}
    />

    <ArticleHeroMobile
      title={post.title}
      date={date}
    />

    <ArticleBody
      content={content}
      toc={toc}
      download={download}
    />

    <RelatedPosts
      related={related}
      category={category}
    />
  </main>
</Layout>
