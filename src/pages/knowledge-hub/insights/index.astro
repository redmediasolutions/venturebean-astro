---
/**
 * Insights page (Knowledge Hub → Insights)
 * Route: /knowledge-hub/insights/
 *
 * Each section lives in src/components/knowledge-hub/insights/.
 */

export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import InsightsTabs from '../../../components/knowledge-hub/insights/InsightsTabs.astro';
import GlobalHero from '../../../components/global/global-hero.astro';
---

<Layout page="insights">
  <main
    id="content"
    class="w-full min-w-0 overflow-hidden bg-white"
  >
    <GlobalHero
      title="Insights"
      subtitle="Knowledge Hub"
      description="Insights that drive smarter decisions. Actionable Insights & Industry Trends"
      image="https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1795030457796-insights.jpg"
      showButton={true}
      buttonText="Book a Discovery Call"
    />
    <InsightsTabs />
  </main>
</Layout>