---
/**
 * Blog article → /<slug>/
 *
 * One page per published Coaching, Consulting,
 * Industry Perspectives and Framework posts.
 *
 * Components:
 * src/components/blog/article/
 */

import Layout from "../../../layouts/Layout.astro";
import ArticleHero from "../../../components/blog/article/ArticleHero.astro";
import ArticleHeroMobile from "../../../components/blog/article/ArticleHeroMobile.astro";
import ArticleBody from "../../../components/blog/article/ArticleBody.astro";
import RelatedPosts from "../../../components/blog/article/RelatedPosts.astro";

import {
  getArticlePosts,
  postPath,
  reportPdfOf,
  type BlogPost,
} from "../../../lib/posts";

import { formatDate, prepareContent } from "../../../lib/article";

export async function getStaticPaths() {
  // Slugs already used by site pages.
  const reserved = new Set([
    "about-us",
    "business-consulting",
    "case-studies",
    "clients",
    "coaching",
    "coaching-case-studies",
    "consulting-case-studies",
    "contact-us",
    "knowledge-hub",
    "testimonials",
    "venturebean-solutions-page",
    "insights",
    "media-spotlight",
    "industry-perspectives",
    "toolkit",
  ]);

  const posts = await getArticlePosts();

  return posts
    .filter((post) => !reserved.has(post.slug))
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const all = await getArticlePosts();

const { html: content, toc } = prepareContent(post.content);

// Determine the article category.
const category =
  ["coaching", "consulting"].find((category) =>
    post.categorySlugs.includes(category)
  ) ??
  post.categorySlugs.find((category) =>
    all.some(
      (otherPost) =>
        otherPost.slug !== post.slug &&
        otherPost.categorySlugs.includes(category)
    )
  ) ??
  post.categorySlugs[0] ??
  "consulting";

// Related articles from the same category.
const related = all
  .filter(
    (otherPost) =>
      otherPost.slug !== post.slug &&
      otherPost.categorySlugs.includes(category)
  )
  .slice(0, 4);

const date = formatDate(post.publishedAt);

const reportPdf = reportPdfOf(post);

const download = reportPdf
  ? {
      pdf: reportPdf,
      postId: post.id,
      slug: post.slug,
      title: post.title,
    }
  : null;

// Featured image backgrounds for desktop and mobile article heroes.
const image = post.featuredImage?.url;

const heroCss = image
  ? `
    <style>
      .vb-element-474937f,
      .vb-element-bd88443 {
        background-image: url(${JSON.stringify(image)}) !important;
      }
    </style>
  `
  : "";
---

<Layout
  page="post"
  title={post.seoTitle || post.title}
  description={post.seoDescription || post.excerpt}
  canonical={`https://venturebean.com${postPath(post.slug)}`}
  image={image}
>
  <main
    id="content"
    class="article-page w-full min-w-0 overflow-hidden bg-white"
  >
    {heroCss && <Fragment set:html={heroCss} />}

    <ArticleHero
      title={post.title}
      date={date}
    />

    <ArticleHeroMobile
      title={post.title}
      date={date}
    />

    <ArticleBody
      content={content}
      toc={toc}
      download={download}
    />

    <RelatedPosts
      related={related}
      category={category}
    />
  </main>
</Layout>
