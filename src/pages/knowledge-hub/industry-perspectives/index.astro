
---
/**
 * Industry Perspectives page
 * Knowledge Hub → Industry Perspectives
 * Route: /knowledge-hub/industry-perspectives/
 *
 * Each section lives in:
 * src/components/knowledge-hub/industry-perspectives/
 */

export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import HeroSlider from "../../../components/knowledge-hub/industry-perspectives/HeroSlider.astro";
import FeaturedInsightsHeading from "../../../components/knowledge-hub/industry-perspectives/FeaturedInsightsHeading.astro";
import PerspectiveList from "../../../components/knowledge-hub/industry-perspectives/PerspectiveList.astro";
import StayConnected from "../../../components/knowledge-hub/industry-perspectives/StayConnected.astro";
import GlobalHero from "../../../components/global/global-hero.astro";
---

<Layout page="industry-perspectives">
  <main
    id="content"
    class="w-full min-w-0 overflow-hidden"
    data-vb-type="site-page"
    data-vb-id="24152"
    data-vb-post-type="page"
  >
