---
import SplitText from '../ui/SplitText.astro';
import { stats } from '../../data/home.js';
---

<section class="stats surface-dark" aria-labelledby="stats-title">
  <div class="container stats__inner">
    <SplitText parts={stats.title} id="stats-title" class="stats__title" />

    <dl class="stats__grid">
      {
        stats.items.map((s, i) => (
          <div class="stats__item" data-reveal style={`--i:${i}`}>
            <dt class="stats__label">{s.label}</dt>
            <dd class="stats__value">
              <span data-count={s.value} aria-hidden="true">
                {s.value}
              </span>
              <span class="stats__suffix" aria-hidden="true">
                {s.suffix}
              </span>
              <span class="visually-hidden">
                {s.value}
                {s.suffix}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 4rem + 4vw, 7rem);
  }
  .stats__inner {
    position: relative;
  }
  .stats__title {
    color: #fff;
    font-size: var(--fs-2xl);
    line-height: 1.05;
    max-width: 20ch;
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 5.5rem);
    border-top: 1px solid var(--color-border-dark);
  }
  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: clamp(1.75rem, 3vw, 2.75rem) clamp(1rem, 2vw, 2rem) 0;
    border-left: 1px solid var(--color-border-dark);
  }
  .stats__item:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stats__value {
    display: flex;
    align-items: flex-start;
    font-family: var(--font-display);
    font-size: var(--fs-counter);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }
  .stats__suffix {
    font-size: 0.5em;
    margin-left: 0.05em;
    color: var(--vb-brown-300);
    line-height: 1.1;
  }
  .stats__label {
    font-size: var(--fs-md);
    color: var(--color-on-dark-muted);
  }

  @media (max-width: 900px) {
    .stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats__item:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .stats__item:nth-child(n + 3) {
      border-top: 1px solid var(--color-border-dark);
      margin-top: 2rem;
    }
  }
</style>
