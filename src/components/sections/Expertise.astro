---
import SectionHeading from '../ui/SectionHeading.astro';
import { expertise } from '../../data/home.js';
---

<section class="exp section" aria-labelledby="exp-title">
  <div class="container exp__grid">
    <SectionHeading title={expertise.title} subtitle={expertise.subtitle} id="exp-title" class="exp__head" />
    <div class="exp__body">
      <p class="exp__lead" data-reveal>{expertise.paragraphs[0]}</p>
      <p class="exp__p" data-reveal style="--i:1">{expertise.paragraphs[1]}</p>
    </div>
  </div>
</section>

<style>
  .exp {
    padding-bottom: clamp(3rem, 5vw, 6rem);
  }
  .exp__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6.5rem);
    align-items: start;
  }
  .exp__body {
    display: grid;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }
  .exp__lead {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--vb-navy-800);
  }
  .exp__p {
    font-size: var(--fs-md);
    color: var(--color-text-soft);
    max-width: 62ch;
  }
  @media (max-width: 900px) {
    .exp__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
