---
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import SplitText from '../ui/SplitText.astro';
import { knowledgeHub as kh } from '../../data/home.js';
import { link, isExternal } from '../../utils/links.js';

const withLink = (href) => {
  const url = link(href);
  return { href: url, external: isExternal(url) || /\.pdf$/i.test(url) };
};
---

<section class="kh section surface-2" aria-labelledby="kh-title">
  <div class="container">
    <div class="kh__head">
      <div class="kh__titles">
        <SplitText parts={kh.title} id="kh-title" class="kh__title" />
        <p class="kh__sub" data-reveal>{kh.subtitle}</p>
      </div>

      <div class="kh__tabs" role="tablist" aria-label={kh.title} data-tabs data-reveal>
        <span class="kh__indicator" aria-hidden="true" data-indicator></span>
        {
          kh.tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`kh-tab-${t.id}`}
              class="kh__tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`kh-panel-${t.id}`}
              tabindex={i === 0 ? '0' : '-1'}
            >
              {t.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      kh.tabs.map((t, i) => (
        <div
          class="kh__panel"
          role="tabpanel"
          id={`kh-panel-${t.id}`}
          aria-labelledby={`kh-tab-${t.id}`}
          hidden={i !== 0}
          tabindex="0"
        >
          <ul role="list" class:list={['kh__grid', `kh__grid--${t.layout}`]}>
            {t.items.map((item, k) => {
              const l = withLink(item.href);
              return (
                <li class="post" style={`--i:${k}`}>
                  <a
                    class="post__link"
                    href={l.href}
                    target={l.external ? '_blank' : undefined}
                    rel={l.external ? 'noopener noreferrer' : undefined}
                  >
                    <div class="post__media">
                      <Img
                        src={item.image}
                        alt={item.alt || ''}
                        sizes="(max-width: 640px) 92vw, (max-width: 1023px) 46vw, 30vw"
                        widths={[400, 640, 900]}
                        class="post__img"
                      />
                      {item.category && <span class="post__badge">{item.category}</span>}
                    </div>
                    <div class="post__body">
                      <h3 class="post__title">{item.title}</h3>
                      {item.excerpt && <p class="post__excerpt">{item.excerpt}</p>}
                      <div class="post__meta">
                        <time datetime={item.datetime}>
                          <Icon name="calendar" size={15} />
                          {item.date}
                        </time>
                        {t.layout === 'post' ? (
                          <span class="post__more">{kh.readMore}</span>
                        ) : (
                          <span class="post__arrow" aria-hidden="true">
                            <Icon name="arrow-up-right" size={18} />
                          </span>
                        )}
                      </div>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .kh__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }
  .kh__title {
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
  }
  .kh__sub {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-xl);
    color: var(--vb-brown-700);
  }

  /* Segmented tabs with sliding indicator */
  .kh__tabs {
    position: relative;
    display: inline-flex;
    padding: 0.35rem;
    border-radius: var(--radius-pill);
    background: #fff;
    border: 1px solid var(--color-border);
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .kh__indicator {
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    left: 0;
    width: 0;
    border-radius: var(--radius-pill);
    background: var(--vb-navy-800);
    transition:
      transform 550ms var(--ease-out),
      width 550ms var(--ease-out);
  }
  .kh__tab {
    position: relative;
    z-index: 1;
    padding: 0.8rem 1.35rem;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--vb-navy-800);
    transition: color 400ms;
  }
  .kh__tab[aria-selected='true'] {
    color: #fff;
    background: var(--vb-navy-800);
  }
  .has-indicator .kh__tab[aria-selected='true'] {
    background: transparent;
  }

  .kh__panel:focus-visible {
    outline-offset: 8px;
  }

  .kh__grid {
    display: grid;
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }
  .kh__grid--media {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .kh__grid--post {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .post__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition:
      transform 600ms var(--ease-out),
      box-shadow 600ms var(--ease-out);
  }
  .post__link:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .post__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface-3);
  }
  .kh__grid--media .post__media {
    aspect-ratio: 4 / 3;
  }
  .post__media :global(.post__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }
  .post__link:hover :global(.post__img) {
    transform: scale(1.06);
  }
  .post__badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(6px);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--vb-brown-700);
  }
  .post__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    padding: clamp(1.25rem, 2vw, 1.6rem);
  }
  .post__title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    transition: color var(--dur-fast);
  }
  .kh__grid--media .post__title {
    font-size: var(--fs-lg);
  }
  .post__link:hover .post__title {
    color: var(--vb-brown-700);
  }
  .post__excerpt {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.55;
  }
  .post__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .post__meta time {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .post__more {
    font-weight: 600;
    color: var(--vb-navy-800);
  }
  .post__arrow {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-surface-2);
    color: var(--vb-navy-800);
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast),
      transform 500ms var(--ease-out);
  }
  .post__link:hover .post__arrow {
    background: var(--vb-navy-800);
    color: #fff;
    transform: rotate(45deg);
  }

  @media (max-width: 1180px) {
    .kh__grid--post {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .kh__grid--media,
    .kh__grid--post {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      gap: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 0.5rem;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .kh__grid::-webkit-scrollbar {
      display: none;
    }
    .post {
      scroll-snap-align: start;
    }
    .kh__tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      border-radius: 18px;
    }
    .kh__indicator {
      border-radius: 14px;
    }
    .kh__tab {
      padding: 0.7rem 0.4rem;
      border-radius: 14px;
      font-size: 0.8125rem;
      line-height: 1.2;
      white-space: normal;
      text-align: center;
    }
  }
</style>

<script>
  // Accessible tabs (WAI-ARIA pattern: arrows / Home / End, automatic activation)
  document.querySelectorAll('[data-tabs]').forEach((list) => {
    const tabs = [...list.querySelectorAll('[role="tab"]')];
    const indicator = list.querySelector('[data-indicator]');

    const moveIndicator = (tab) => {
      indicator.style.width = `${tab.offsetWidth}px`;
      indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
    };

    const select = (tab, focus = true) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
      });
      moveIndicator(tab);
      if (focus) tab.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const map = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in map)) return;
        e.preventDefault();
        select(tabs[(map[e.key] + tabs.length) % tabs.length]);
      });
    });

    const current = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true');
    requestAnimationFrame(() => {
      moveIndicator(current());
      list.classList.add('has-indicator');
    });
    new ResizeObserver(() => moveIndicator(current())).observe(list);
  });
</script>
