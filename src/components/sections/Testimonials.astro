---
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { testimonials } from '../../data/home.js';
---

<section class="tst section" aria-labelledby="tst-title">
  <div class="container">
    <div class="tst__head">
      <SectionHeading title={testimonials.title} subtitle={testimonials.subtitle} id="tst-title" />
    </div>

    {
      testimonials.groups.map((group, g) => {
        const gid = `tst-${group.label.toLowerCase()}`;
        return (
          <div class:list={['tst__group', { 'tst__group--alt': g % 2 === 1 }]} data-carousel>
            <h3 class="tst__label" id={gid}>
              {group.label}
            </h3>

            <div class="tst__rail">
              <ul role="list" class="tst__track" data-track aria-labelledby={gid} tabindex="0">
                {group.items.map((t, i) => (
                  <li class="quote" data-reveal style={`--i:${i % 2}`}>
                    <figure>
                      <span class="quote__mark" aria-hidden="true">
                        “
                      </span>
                      <blockquote class="quote__text">
                        {t.quote.map((p) => (
                          <p>{p}</p>
                        ))}
                      </blockquote>
                      <figcaption class="quote__who">
                        <span class="quote__avatar">
                          <Img src={t.image} alt={t.name} sizes="64px" widths={[64, 128]} class="quote__img" />
                        </span>
                        <span>
                          <span class="quote__name">{t.name}</span>
                          <span class="quote__role">{t.role}</span>
                        </span>
                      </figcaption>
                    </figure>
                  </li>
                ))}
              </ul>

              <div class="tst__nav">
                <div class="tst__progress" aria-hidden="true">
                  <span data-progress />
                </div>
                <div class="tst__arrows">
                  <button type="button" class="tst__arrow" data-prev>
                    <Icon name="chevron-left" size={20} />
                    <span class="visually-hidden">Previous {group.label.toLowerCase()} testimonial</span>
                  </button>
                  <button type="button" class="tst__arrow" data-next>
                    <Icon name="chevron-right" size={20} />
                    <span class="visually-hidden">Next {group.label.toLowerCase()} testimonial</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        );
      })
    }

    <div class="tst__cta" data-reveal>
      <Button href={testimonials.cta.href}>{testimonials.cta.label}</Button>
    </div>
  </div>
</section>

<style>
  .tst__head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .tst__group {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: stretch;
  }
  .tst__group + .tst__group {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .tst__group--alt {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .tst__group--alt .tst__label {
    order: 2;
  }

  /* Big outlined vertical label — echoes the original's vertical COACHING / CONSULTING */
  .tst__label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.2px rgb(16 0 87 / 0.6);
    text-align: end;
  }
  .tst__group--alt .tst__label {
    transform: none;
  }

  .tst__rail {
    min-width: 0;
  }
  .tst__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 1.25rem) / 2);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
  .tst__track::-webkit-scrollbar {
    display: none;
  }
  .quote {
    scroll-snap-align: start;
  }
  .quote figure {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.75rem, 3vw, 2.75rem);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur),
      box-shadow var(--dur);
  }
  .quote figure:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }
  .quote__mark {
    position: absolute;
    top: 0.6rem;
    right: 1.5rem;
    font-family: var(--font-serif);
    font-size: 7rem;
    line-height: 1;
    color: var(--vb-brown-700);
    opacity: 0.18;
  }
  .quote__text {
    font-size: var(--fs-md);
    line-height: 1.65;
    color: var(--color-text-soft);
  }
  .quote__text p + p {
    margin-top: 0.9em;
  }
  .quote__who {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .quote__text {
    margin-bottom: 1.75rem;
  }
  .quote__avatar {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-surface-3);
  }
  .quote__avatar :global(.quote__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .quote__name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--vb-navy-800);
  }
  .quote__role {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .tst__nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .tst__progress {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--color-border);
    border-radius: 2px;
    overflow: hidden;
  }
  .tst__progress span {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w, 50%);
    background: var(--vb-navy-800);
    transform: translateX(var(--x, 0%));
    transition: transform 400ms var(--ease-out);
  }
  .tst__arrows {
    display: flex;
    gap: 0.5rem;
  }
  .tst__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--color-border-strong);
    color: var(--vb-navy-800);
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast),
      opacity var(--dur-fast);
  }
  .tst__arrow:hover:not(:disabled) {
    background: var(--vb-navy-800);
    color: #fff;
  }
  .tst__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .tst__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(3rem, 5vw, 4.5rem);
  }

  @media (max-width: 900px) {
    .tst__group,
    .tst__group--alt {
      grid-template-columns: 1fr;
    }
    .tst__label,
    .tst__group--alt .tst__label {
      order: 0;
      writing-mode: horizontal-tb;
      transform: none;
      text-align: start;
      font-size: clamp(2.25rem, 10vw, 3.5rem);
    }
    .tst__track {
      grid-auto-columns: 88%;
    }
  }
</style>

<script>
  // Scroll-snap carousels: arrows + progress bar, native swipe on touch.
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const track = root.querySelector('[data-track]');
    const prev = root.querySelector('[data-prev]');
    const next = root.querySelector('[data-next]');
    const bar = root.querySelector('[data-progress]');

    const step = () => {
      const item = track.querySelector('li');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return item ? item.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const ratio = track.clientWidth / track.scrollWidth;
      const p = max > 0 ? track.scrollLeft / max : 0;
      bar.style.setProperty('--w', `${ratio * 100}%`);
      bar.style.setProperty('--x', `${(p * (1 - ratio) * 100) / ratio}%`);
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next.addEventListener('click', () => track.scrollBy({ left: step() }));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') track.scrollBy({ left: step() });
      if (e.key === 'ArrowLeft') track.scrollBy({ left: -step() });
    });
    new ResizeObserver(update).observe(track);
  });
</script>
