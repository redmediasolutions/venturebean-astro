---
/**
 * Practice section — used for "Business Consulting" and
 * "Coaching & Organisational Development" (same structure on the original site).
 */
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const { data, reverse = false, surface = 'plain' } = Astro.props;
const headingId = `${data.id}-title`;
---

<section
  class:list={['practice section', `practice--${surface}`, { 'practice--reverse': reverse }]}
  id={data.id}
  aria-labelledby={headingId}
>
  <div class="container practice__grid">
    <div class="practice__intro">
      <SectionHeading title={data.title} subtitle={data.subtitle} id={headingId} size="md" />
      <p class="practice__text" data-reveal>{data.text}</p>

      <div class="practice__media" data-reveal="scale" data-fader aria-roledescription="carousel" aria-label={`${data.title} images`}>
        {
          data.slides.map((s, i) => (
            <div class:list={['practice__slide', { 'is-active': i === 0 }]} data-fade-slide>
              <Img src={s.image} alt={s.alt} sizes="(max-width: 900px) 92vw, 44vw" widths={[480, 800, 1200]} class="practice__img" />
            </div>
          ))
        }
        <div class="practice__dots" role="tablist" aria-label="Choose image">
          {
            data.slides.map((_, i) => (
              <button
                type="button"
                role="tab"
                class:list={['practice__dot', { 'is-active': i === 0 }]}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`Image ${i + 1}`}
                data-fade-dot={i}
              />
            ))
          }
        </div>
      </div>

      <div data-reveal>
        <Button href={data.cta.href}>{data.cta.label}</Button>
      </div>
    </div>

    <ul role="list" class="practice__cards">
      {
        data.features.map((f, i) => (
          <li class="pcard" data-reveal style={`--i:${i}`}>
            <span class="pcard__icon">
              <Icon name={f.icon} size={26} />
            </span>
            <span class="pcard__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="pcard__title">{f.title}</h3>
            <p class="pcard__text">{f.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .practice--surface {
    background: var(--color-surface-3);
  }
  .practice__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .practice--reverse .practice__intro {
    order: 2;
  }
  .practice__intro {
    display: grid;
    gap: clamp(1.5rem, 2.5vw, 2rem);
    align-content: start;
  }
  .practice__text {
    font-size: var(--fs-md);
    color: var(--color-text-soft);
    max-width: 52ch;
  }

  /* Image fader */
  .practice__media {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--vb-navy-800);
  }
  .practice__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }
  .practice__slide.is-active {
    opacity: 1;
  }
  .practice__slide :global(.practice__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: none;
  }
  .practice__slide.is-active :global(.practice__img) {
    transform: none;
  }
  .practice__dots {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    gap: 0.4rem;
    z-index: 2;
  }
  .practice__dot {
    position: relative;
    width: 2rem;
    height: 1.5rem;
  }
  .practice__dot::before {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 3px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.45);
    transition: background-color var(--dur);
  }
  .practice__dot.is-active::before {
    background: #fff;
  }

  /* Feature cards */
  .practice__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: clamp(15rem, 22vw, 19rem);
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border-radius: var(--radius-md);
    background: #fff;
    border: 1px solid var(--color-border);
    transition:
      border-color var(--dur-fast),
      box-shadow var(--dur-fast),
      color 400ms var(--ease-out),
      border-color 400ms;
  }
  .practice--plain .pcard {
    background: var(--color-surface-3);
    border-color: transparent;
  }
  .pcard:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-sm);
  }
  .pcard__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-sm);
    background: var(--vb-navy-800);
    color: #fff;
    transition:
      background-color 500ms,
      color 500ms,
      transform 700ms var(--ease-out);
  }
  .pcard__num {
    position: absolute;
    top: clamp(1.5rem, 2.5vw, 2.25rem);
    right: clamp(1.5rem, 2.5vw, 2.25rem);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
    transition: color 400ms;
  }
  .pcard__title {
    margin-top: auto;
    font-size: var(--fs-xl);
    font-weight: 600;
    transition: color 400ms;
  }
  .pcard__text {
    font-size: 0.9375rem;
    color: var(--color-muted);
    transition: color 400ms;
  }

  @media (max-width: 1023px) {
    .practice__grid {
      grid-template-columns: 1fr;
    }
    .practice--reverse .practice__intro {
      order: 0;
    }
  }
  /* Mobile: compact horizontal cards (icon beside text) */
  @media (max-width: 520px) {
    .practice__cards {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .pcard {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
      row-gap: 0.25rem;
      min-height: 0;
      padding: 1.25rem;
      border-radius: var(--radius-md);
    }
    .pcard__icon {
      grid-row: span 2;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 12px;
    }
    .pcard__num {
      display: none;
    }
    .pcard__title {
      margin-top: 0;
      font-size: 1.25rem;
    }
  }
  @media (hover: none) {
    .pcard:hover {
      transform: none;
    }
  }
</style>

<script>
  // Images change only when explicitly selected; no background motion.
  document.querySelectorAll('[data-fader]').forEach((root) => {
    const slides = [...root.querySelectorAll('[data-fade-slide]')];
    const dots = [...root.querySelectorAll('[data-fade-dot]')];
    let i = 0;
    const show = (n) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => {
        d.classList.toggle('is-active', k === i);
        d.setAttribute('aria-selected', String(k === i));
      });
    };
    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.fadeDot));
      }),
    );
  });
</script>
