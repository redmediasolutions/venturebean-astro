---
import Icon from '../ui/Icon.astro';
import { videos } from '../../data/home.js';

// Build-time: look up each Vimeo video's poster via oEmbed so the page ships
// a lightweight facade instead of two heavy iframes. Falls back gracefully.
async function vimeoPoster(id) {
  try {
    const res = await fetch(`https://vimeo.com/api/oembed.json?url=https://vimeo.com/${id}&width=1280`, {
      signal: AbortSignal.timeout(5000),
    });
    if (!res.ok) return null;
    const data = await res.json();
    return data.thumbnail_url || null;
  } catch {
    return null;
  }
}

const items = await Promise.all(videos.map(async (v) => ({ ...v, poster: await vimeoPoster(v.vimeoId) })));
---

<section class="videos section--tight" aria-label="Videos">
  <div class="videos__grid container">
    {
      items.map((v, i) => (
        <figure class="video" data-reveal style={`--i:${i}`}>
          <div class="video__frame" data-video={v.vimeoId} data-title={v.title}>
            {v.poster ? (
              <img class="video__poster" src={v.poster} alt="" loading="lazy" decoding="async" />
            ) : (
              <div class="video__poster video__poster--fallback" aria-hidden="true" />
            )}
            <button type="button" class="video__play" aria-label={`Play video: ${v.title}`}>
              <span class="video__play-btn">
                <Icon name="play" size={22} />
              </span>
            </button>
          </div>
          <figcaption class="video__caption">
            <span class="video__dot" aria-hidden="true" />
            {v.title}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .videos {
    background: var(--color-bg);
  }
  .videos__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--vb-navy-950);
    isolation: isolate;
  }
  .video__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 1s var(--ease-out),
      opacity var(--dur);
  }
  .video__poster--fallback {
    background:
      radial-gradient(120% 90% at 20% 10%, rgb(107 50 52 / 0.65), transparent 60%),
      radial-gradient(120% 90% at 90% 100%, rgb(6 50 156 / 0.6), transparent 60%),
      var(--vb-navy-950);
  }
  .video__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(11 0 54 / 0.45), transparent 60%);
    pointer-events: none;
  }
  .video__frame:hover .video__poster {
    transform: scale(1.04);
  }
  .video__play {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
  }
  .video__play-btn {
    display: grid;
    place-items: center;
    width: clamp(4rem, 7vw, 5.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--vb-navy-800);
    padding-left: 4px;
    box-shadow: 0 0 0 0 rgb(255 255 255 / 0.5);
    transition:
      transform 500ms var(--ease-out),
      background-color var(--dur-fast),
      color var(--dur-fast);
  }
  .video__play:hover .video__play-btn {
    transform: scale(1.1);
    background: var(--vb-brown-700);
    color: #fff;
  }
  .video__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    z-index: 3;
  }
  .video__caption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--vb-navy-800);
    letter-spacing: -0.01em;
  }
  .video__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--vb-brown-700);
  }

  @media (max-width: 767px) {
    .videos__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Click-to-load Vimeo (keeps ~1MB of player JS off the initial page load)
  document.querySelectorAll('[data-video]').forEach((frame) => {
    frame.querySelector('.video__play')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://player.vimeo.com/video/${frame.dataset.video}?autoplay=1&title=1&byline=0&portrait=0&dnt=1`;
      iframe.title = frame.dataset.title;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      frame.appendChild(iframe);
      iframe.focus();
    });
  });
</script>
