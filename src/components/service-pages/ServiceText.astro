
---
/**
 * VentureBean – Service Text Section
 * Elegant heading and rich-text content.
 */

interface Props {
  title: string;
  html?: string;
}

const { title, html = '' } = Astro.props;
---

<section class="bg-white px-5 py-16 md:px-8 md:py-20 lg:py-24">
  <div class="mx-auto max-w-[1200px]">

    <div class="max-w-[1000px]">

      <!-- Section Heading -->
      <div class="mb-8 md:mb-10">

        <h2 class="max-w-[950px] text-3xl font-bold leading-[1.2] tracking-tight text-[#101044] sm:text-4xl lg:text-[42px]">
          {title}
        </h2>

        <span class="mt-6 block h-[3px] w-14 bg-[#3155A4]"></span>

      </div>

      <!-- Rich Text Content -->
      <div class="service-text-content max-w-[900px] text-[14px] leading-[1.9] text-[#626575] md:text-[15px] md:leading-[2]">

        {html && <Fragment set:html={html} />}

        <slot />

      </div>

    </div>

  </div>
</section>

<style>
  /* Rich text formatting for dynamically supplied HTML */

  .service-text-content :global(p) {
    margin-bottom: 20px;
  }

  .service-text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .service-text-content :global(b),
  .service-text-content :global(strong) {
    color: #101044;
    font-weight: 700;
  }

  .service-text-content :global(a) {
    color: #3155a4;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .service-text-content :global(a:hover) {
    color: #101044;
  }

  @media (max-width: 640px) {
    .service-text-content :global(p) {
      margin-bottom: 16px;
    }
  }
</style>
