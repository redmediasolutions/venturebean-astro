---
/**
 * Call to action (same design as "Ready to Grow, Scale or Transform Your
 * Business?" on the Consulting page).
 */
interface Props {
  title: string;
  html: string;
  buttonText?: string;
  buttonHref?: string;
  secondary?: { text: string; href: string };
}
const { title, html, buttonText = 'Book a Discovery Call', buttonHref = '/contact-us/', secondary } = Astro.props;
---

<div
  class="vb-element vb-element-f4c2606 e-flex e-con-boxed e-con e-parent"
  data-id="f4c2606"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-7882f13 e-con-full e-flex e-con e-child"
      data-id="7882f13"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-3e3cab3 vb-widget vb-widget-heading"
        data-id="3e3cab3"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container">
          <h2 class="vb-heading-title vb-size-default">{title}</h2>
        </div>
      </div>
      <div
        class="vb-element vb-element-2c34a8d vb-widget__width-initial vb-widget vb-widget-text-editor"
        data-id="2c34a8d"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container"><Fragment set:html={html} /></div>
      </div>
      <div
        class="vb-element vb-element-0e0cc87 e-con-full e-flex e-con e-child"
        data-id="0e0cc87"
        data-element_type="container"
        data-e-type="container"
      >
        <div
          class="vb-element vb-element-c961061 vb-align-center vb-widget vb-widget-button"
          data-id="c961061"
          data-element_type="widget"
          data-e-type="widget"
          data-widget_type="button.default"
        >
          <div class="vb-widget-container">
            <div class="vb-button-wrapper">
              <a class="vb-button vb-button-link vb-size-sm" href={buttonHref}>
                <span class="vb-button-content-wrapper">
                  <span class="vb-button-icon"> <i aria-hidden="true" class="teenyicon ti-phonecall"></i> </span>
                  <span class="vb-button-text">{buttonText}</span>
                </span>
              </a>
            </div>
          </div>
        </div>
        {secondary && (
<div
          class="vb-element vb-element-9b03b02 vb-align-center vb-widget vb-widget-button"
          data-id="9b03b02"
          data-element_type="widget"
          data-e-type="widget"
          data-widget_type="button.default"
        >
          <div class="vb-widget-container">
            <div class="vb-button-wrapper">
              <a class="vb-button vb-button-link vb-size-sm" href={secondary?.href}>
                <span class="vb-button-content-wrapper">
                  <span class="vb-button-icon"> <i aria-hidden="true" class="teenyicon ti-phonecall"></i> </span>
                  <span class="vb-button-text">{secondary?.text}</span>
                </span>
              </a>
            </div>
          </div>
        </div>
)}
      </div>
    </div>
  </div>
</div>
