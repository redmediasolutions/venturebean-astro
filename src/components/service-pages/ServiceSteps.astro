---
/**
 * Up to five coloured step cards (same design as "Our Approach" on the
 * Consulting page). Icons are Font Awesome classes, e.g. "fas fa-search".
 */
interface Props {
  title: string;
  subtitle?: string;
  steps: { title: string; icon: string; items: string[]; link?: { href: string; text: string } }[];
}
const { title, subtitle = '', steps } = Astro.props;
