---
/**
 * Page banner (same design as the Consulting page banner).
 */
interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt?: string;
  buttonText?: string;
  buttonHref?: string;
}
const { title, description, image, imageAlt, buttonText = 'Book a Discovery Call', buttonHref = '/contact-us/' } = Astro.props;
---

<div
  class="vb-element vb-element-d36d096 e-con-full e-flex e-con e-parent"
  data-id="d36d096"
  data-element_type="container"
  data-e-type="container"
>
  <div
    class="vb-element vb-element-adea9a4 e-con-full e-flex e-con e-child"
    data-id="adea9a4"
    data-element_type="container"
    data-e-type="container"
  >
    <div
      class="vb-element vb-element-5a891a4 vb--v-position-bottom vb--h-position-center vb-arrows-position-inside vb-pagination-position-inside vb-widget vb-widget-slides"
      data-id="5a891a4"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"navigation":"both","autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","autoplay_speed":5000,"infinite":"yes","transition":"slide","transition_speed":500}'}
      data-widget_type="slides.default"
    >
      <div class="vb-widget-container">
        <div class="vb-swiper">
          <div
            class="vb-slides-wrapper vb-main-swiper swiper"
            role="region"
            aria-roledescription="carousel"
            aria-label="Slides"
            dir="ltr"
            data-animation="fadeInUp"
          >
            <div class="swiper-wrapper vb-slides">
              <div class="vb-repeater-item-0a583bb swiper-slide" role="group" aria-roledescription="slide">
                <div
                  class="swiper-slide-bg vb-ken-burns vb-ken-burns--in"
                  style={`background-image:url(${image})`}
                  role="img"
                  aria-label={imageAlt || title}
                >
                </div><div class="vb-background-overlay"></div><div class="swiper-slide-inner">
                  <div class="swiper-slide-contents">
                    <h1 class="vb-slide-heading">{title}</h1><div class="vb-slide-description">{description}</div><a href={buttonHref} class="vb-button vb-slide-button vb-size-sm">{buttonText}</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
