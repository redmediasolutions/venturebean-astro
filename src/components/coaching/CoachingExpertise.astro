        data-id="59ffdf4"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="image-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-image-box-wrapper">
            <figure class="vb-image-box-img">
              <a href="#executive" tabindex="-1"
                ><img
                  loading="lazy"
                  decoding="async"
                  width="2048"
                  height="1148"
                  src="/assets/uploads/2025/06/2-1.jpeg"
                  class="attachment-full size-full site-image-20180"
                  alt="Team Coaching Session with Business Group | VentureBean"
                  srcset="/assets/uploads/2025/06/2-1.jpeg 2048w, /assets/uploads/2025/06/2-1-400x224.jpeg 400w, /assets/uploads/2025/06/2-1-1300x729.jpeg 1300w, /assets/uploads/2025/06/2-1-768x431.jpeg 768w, /assets/uploads/2025/06/2-1-1536x861.jpeg 1536w"
                  sizes="(max-width: 2048px) 100vw, 2048px"
                /></a>
            </figure><div class="vb-image-box-content">
              <h3 class="vb-image-box-title"><a href="#executive">Executive Coaching&#x200b;</a></h3>
            </div>
          </div>
        </div>
      </div>
