---
/**
 * Coaching page: “PROGRAM” section.
 */
---

<div
  class="vb-element vb-element-f1b0a7e e-flex e-con-boxed e-con e-parent"
  data-id="f1b0a7e"
  data-element_type="container"
  data-e-type="container"
  id="executive"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-1fee33b e-con-full e-flex e-con e-child"
      data-id="1fee33b"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-f966c06 vb-widget vb-widget-icon-box"
        data-id="f966c06"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-icon-box-wrapper">
            <div class="vb-icon-box-content"><h3 class="vb-icon-box-title"><span> PROGRAM </span></h3></div>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-f7fe2b6 vb-widget vb-widget-heading"
        data-id="f7fe2b6"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
