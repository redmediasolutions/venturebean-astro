      <div
        class="vb-element vb-element-b744c9b e-con-full e-flex e-con e-child"
        data-id="b744c9b"
        data-element_type="container"
        data-e-type="container"
        data-settings={'{"background_background":"classic"}'}
      >
        <div
          class="vb-element vb-element-109ac17 vb-widget vb-widget-text-editor"
          data-id="109ac17"
          data-element_type="widget"
          data-e-type="widget"
          data-widget_type="text-editor.default"
        >
          <div class="vb-widget-container">
            <p>
              <span style="font-weight: 400;"
                >Helps leaders strengthen their ability to manage complexity, lead teams effectively, and make better
                business decisions.</span>
            </p>
          </div>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-1bdd960 e-con-full e-flex e-con e-child"
      data-id="1bdd960"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"background_background":"classic"}'}
    >
      <div
        class="vb-element vb-element-97b9fb2 vb-widget vb-widget-heading"
        data-id="97b9fb2"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Ideal for</h2></div>
      </div>
      <div
        class="vb-element vb-element-86a1de7 e-con-full e-grid e-con e-child"
        data-id="86a1de7"
        data-element_type="container"
        data-e-type="container"
      >
        <div
          class="vb-element vb-element-5ee249a vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
          data-id="5ee249a"
          data-element_type="widget"
          data-e-type="widget"
          data-widget_type="icon-box.default"
        >
          <div class="vb-widget-container">
            <div class="vb-icon-box-wrapper">
              <div class="vb-icon-box-icon">
