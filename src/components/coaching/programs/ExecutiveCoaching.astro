          <div class="vb-widget-container">
            <div class="vb-icon-box-wrapper">
              <div class="vb-icon-box-icon">
                <span class="vb-icon"> <i aria-hidden="true" class="far fa-check-circle"></i> </span>
              </div>
              <div class="vb-icon-box-content"><p class="vb-icon-box-description">Functional Leaders</p></div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-0b613ab vb-widget vb-widget-heading"
        data-id="0b613ab"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Areas covered include</h2></div>
      </div>
      <div
        class="vb-element vb-element-f1f0f38 vb-icon-list--layout-inline coaching-benefit vb-list-item-link-full_width vb-widget vb-widget-icon-list"
