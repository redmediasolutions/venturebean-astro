            </li>
            <li class="vb-icon-list-item vb-inline-item"><span class="vb-icon-list-text">Executive presence</span></li>
            <li class="vb-icon-list-item vb-inline-item">
              <span class="vb-icon-list-text">Leadership communication </span>
            </li>
            <li class="vb-icon-list-item vb-inline-item">
              <span class="vb-icon-list-text">Stakeholder management </span>
            </li>
            <li class="vb-icon-list-item vb-inline-item"><span class="vb-icon-list-text">Team alignment</span></li>
