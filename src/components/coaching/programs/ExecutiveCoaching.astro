            </li>
            <li class="vb-icon-list-item vb-inline-item">
              <span class="vb-icon-list-text">Leadership effectiveness</span>
            </li>
            <li class="vb-icon-list-item vb-inline-item">
              <span class="vb-icon-list-text">Organaisational infuence</span>
            </li>
          </ul>
