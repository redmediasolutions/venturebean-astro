  data-id="f0c2bd1"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-f1f7b8c vb-widget vb-widget-text-editor"
      data-id="f1f7b8c"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="text-editor.default"
    >
      <div class="vb-widget-container">
        <p>Each solution is customised to suit your role, context, and business challenges.</p>
      </div>
    </div>
  </div>
</div>
