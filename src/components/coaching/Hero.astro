---
/**
 * Coaching page: “Mathew Isac” section.
 * Hidden on mobile.
 */
---

<div
  class="vb-element vb-element-45b1893 vb-hidden-mobile e-flex e-con-boxed e-con e-parent"
  data-id="45b1893"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-398894f e-con-full e-flex e-con e-child"
      data-id="398894f"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-bd08032 vb-widget vb-widget-heading"
        data-id="bd08032"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container"><h1 class="vb-heading-title vb-size-default">Mathew Isac</h1></div>
      </div>
      <div
        class="vb-element vb-element-60926ba vb-widget vb-widget-text-editor"
        data-id="60926ba"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container"><p>Empowering Business &amp; Leadership Growth</p></div>
      </div>
      <div
        class="vb-element vb-element-cb26e68 vb-widget vb-widget-button"
        data-id="cb26e68"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="button.default"
      >
        <div class="vb-widget-container">
          <div class="vb-button-wrapper">
            <a class="vb-button vb-button-link vb-size-sm" href="#whowehelp">
              <span class="vb-button-content-wrapper"> <span class="vb-button-text">Who We Help</span> </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
