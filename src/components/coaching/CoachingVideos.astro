---
/**
 * Coaching page: coaching videos section.
 */
---

<div
  class="vb-element vb-element-8adbaf1 e-flex e-con-boxed e-con e-parent"
  data-id="8adbaf1"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-20a5bf5 e-con-full e-flex e-con e-child"
      data-id="20a5bf5"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-08aef12 vb-widget vb-widget-video"
        data-id="08aef12"
        data-element_type="widget"
        data-e-type="widget"
        data-settings={'{"video_type":"hosted","controls":"yes"}'}
        data-widget_type="video.default"
      >
        <div class="vb-widget-container">
          <div class="e-hosted-video vb-wrapper vb-open-inline">
            <video
              class="vb-video"
              src="/assets/uploads/2024/06/Coaching.mp4"
              controls=""
              preload="metadata"
              controlslist="nodownload"
              poster="/assets/uploads/2024/06/Coaching-1.png"></video>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-9c3db78 vb-icon-list--layout-traditional vb-list-item-link-full_width vb-widget vb-widget-icon-list"
        data-id="9c3db78"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-list.default"
      >
        <div class="vb-widget-container">
          <ul class="vb-icon-list-items">
            <li class="vb-icon-list-item">
              <span class="vb-icon-list-icon"> <i aria-hidden="true" class="fas fa-video"></i> </span>
              <span class="vb-icon-list-text">Coaching</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-2a63dfc e-con-full e-flex e-con e-child"
      data-id="2a63dfc"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-4e33837 vb-widget vb-widget-video"
        data-id="4e33837"
        data-element_type="widget"
        data-e-type="widget"
        data-settings={'{"video_type":"hosted","_animation_mobile":"fadeInUp","controls":"yes"}'}
        data-widget_type="video.default"
      >
        <div class="vb-widget-container">
          <div class="e-hosted-video vb-wrapper vb-open-inline">
            <video
              class="vb-video"
              src="/assets/uploads/2024/06/Coaching-Examples.mp4"
              controls=""
              preload="metadata"
              controlslist="nodownload"
              poster="/assets/uploads/2024/06/Coaching-Examples.png"></video>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-c9ca744 vb-icon-list--layout-traditional vb-list-item-link-full_width vb-widget vb-widget-icon-list"
        data-id="c9ca744"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-list.default"
      >
        <div class="vb-widget-container">
          <ul class="vb-icon-list-items">
            <li class="vb-icon-list-item">
              <span class="vb-icon-list-icon"> <i aria-hidden="true" class="fas fa-video"></i> </span>
              <span class="vb-icon-list-text">Coaching Examples</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
