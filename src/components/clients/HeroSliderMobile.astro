---
/**
 * Clients page: hero slider mobile section.
 * Hidden on desktop.
 */
---

<div
  class="vb-element vb-element-3bdab6c vb-hidden-desktop e-flex e-con-boxed e-con e-parent"
  data-id="3bdab6c"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-342b8c1 vb--v-position-bottom vb--h-position-center vb-arrows-position-inside vb-pagination-position-inside vb-widget vb-widget-slides"
      data-id="342b8c1"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"navigation":"both","autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","autoplay_speed":5000,"infinite":"yes","transition":"slide","transition_speed":500}'}
      data-widget_type="slides.default"
    >
      <div class="vb-widget-container">
        <div class="vb-swiper">
          <div
            class="vb-slides-wrapper vb-main-swiper swiper"
            role="region"
            aria-roledescription="carousel"
            aria-label="Slides"
            dir="ltr"
            data-animation="fadeInUp"
          >
            <div class="swiper-wrapper vb-slides">
              <div class="vb-repeater-item-d59db3a swiper-slide" role="group" aria-roledescription="slide">
                <div class="swiper-slide-bg"></div><a class="swiper-slide-inner" href="#all-clients"
                  ><div class="swiper-slide-contents">
                    <div class="vb-slide-heading">Our Clients</div><div class="vb-slide-description">
                      Empowering Businesses, One Partnership at a Time.”
                    </div><div class="vb-button vb-slide-button vb-size-sm">Take a look</div>
                  </div></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
