---
/**
 * Clients page: “Let's Talk” section.
 */
---

<div
  class="vb-element vb-element-9730592 e-flex e-con-boxed e-con e-parent"
  data-id="9730592"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-398f908 e-con-full e-flex e-con e-child"
      data-id="398f908"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-b0a7177 vb-widget vb-widget-heading"
        data-id="b0a7177"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Let's Talk</h2></div>
      </div>
      <div
        class="vb-element vb-element-c3f48de vb-widget vb-widget-text-editor"
        data-id="c3f48de"
        data-element_type="widget"
        data-e-type="widget"
        id="Talk"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container">
          <h3>
            <span
              style='font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"; font-size: 1rem;'
              >If you’re looking for a thoughtful, experienced partner to help you scale with clarity, strengthen
              leadership, or navigate growth challenges, we’d love to start a conversation.</span>
          </h3>
        </div>
      </div>
      <div
        class="vb-element vb-element-d172dab e-con-full e-flex e-con e-child"
        data-id="d172dab"
        data-element_type="container"
        data-e-type="container"
      >
        <div
          class="vb-element vb-element-b09ba21 e-con-full e-flex e-con e-child"
          data-id="b09ba21"
          data-element_type="container"
          data-e-type="container"
        >
          <div
            class="vb-element vb-element-cf43632 vb-align-center vb-widget vb-widget-button"
            data-id="cf43632"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="button.default"
          >
            <div class="vb-widget-container">
              <div class="vb-button-wrapper">
                <a class="vb-button vb-button-link vb-size-sm" href="/contact-us/">
                  <span class="vb-button-content-wrapper"> <span class="vb-button-text">Contact Us</span> </span>
                </a>
              </div>
            </div>
          </div>
        </div>
        <div
          class="vb-element vb-element-2f4374d e-con-full e-flex e-con e-child"
          data-id="2f4374d"
          data-element_type="container"
          data-e-type="container"
        >
          <div
            class="vb-element vb-element-06aca98 vb-align-center vb-widget vb-widget-button"
            data-id="06aca98"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="button.default"
          >
            <div class="vb-widget-container">
              <div class="vb-button-wrapper">
                <a class="vb-button vb-button-link vb-size-sm" href="/#:~:text=Play-,How%20we%20help,-Our%20Areas%20of">
                  <span class="vb-button-content-wrapper">
                    <span class="vb-button-text">Explore our Approach</span>
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-433be2a e-con-full e-flex e-con e-child"
      data-id="433be2a"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-d480ccc vb--h-position-center vb--v-position-middle vb-arrows-position-inside vb-pagination-position-inside vb-widget vb-widget-slides"
        data-id="d480ccc"
        data-element_type="widget"
        data-e-type="widget"
        data-settings={'{"navigation":"both","autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","autoplay_speed":5000,"infinite":"yes","transition":"slide","transition_speed":500}'}
        data-widget_type="slides.default"
      >
        <div class="vb-widget-container">
          <div class="vb-swiper">
            <div
              class="vb-slides-wrapper vb-main-swiper swiper"
              role="region"
              aria-roledescription="carousel"
              aria-label="Slides"
              dir="ltr"
              data-animation="fadeInUp"
            >
              <div class="swiper-wrapper vb-slides">
                <div class="vb-repeater-item-0f14989 swiper-slide" role="group" aria-roledescription="slide">
                  <div class="swiper-slide-bg" role="img" aria-label="Graduation & Learning | VentureBean"></div><div
                    class="swiper-slide-inner"
                  >
                    <div class="swiper-slide-contents"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
