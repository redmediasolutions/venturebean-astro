
---
/**
 * Home page: Our Services / How We Help
 */

const services = [
  {
    number: "01",
    title: "Business Consulting",
    description:
      "Improve business performance, accelerate growth and build scalable systems through business strategy, operational excellence and management advisory.",
    buttonText: "Explore Business Consulting",
    href: "/business-consulting/",
  },
  {
    number: "02",
    title: "Executive & Leadership Coaching",
    description:
      "Strengthen leadership effectiveness, improve decision-making and prepare for greater responsibility through focused coaching for executives, managers and professionals.",
    buttonText: "Explore Coaching",
    href: "/coaching/",
  },
  {
    number: "03",
    title: "Organisational Development",
    description:
      "Develop capable managers, align teams and strengthen organisational effectiveness through leadership development, management workshops and capability-building programmes.",
    buttonText: "Explore Organisational Development",
    href: "/organisational-development/",
  },
  {
    number: "04",
    title: "Assessment",
    description:
      "Identify strengths, competency gaps and development priorities through individual assessments, leadership evaluations and competency-based assessment centres.",
    buttonText: "Explore Assessment",
    href: "/assessments/",
  },
] as const;
---

<section class="w-full bg-vb-light py-16 md:py-24">
  <div class="mx-auto w-full max-w-[1600px] px-6 lg:px-8">

    <!-- Section introduction -->
    <div class="mx-auto mb-12 max-w-1xl text-left md:mb-16">
      <span class="font-heading text-sm font-bold uppercase tracking-[0.2em] text-vb-blue">
        Our Services
      </span>

      <h2 class="mt-3 font-heading text-4xl font-bold tracking-tight text-vb-navy md:text-5xl">
        Our Areas of Expertise
      </h2>

      <p class="mx-auto mt-6 max-w-1xl text-base leading-relaxed text-vb-text md:text-lg">
        We partner with growth focused businesses and leaders through our two
        core practices: Consulting and Coaching, Assessment and Organisational
        Development. We help businesses improve performance, develop leaders
        and build organisational capabilities for sustainable growth.
      </p>
    </div>

    <!-- Services grid -->
    <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-2 md:gap-8">

      {services.map((service) => (
        <article class="group !block min-w-0 rounded-vb-lg border border-slate-200 bg-white p-7 shadow-vb-card transition-all duration-300 hover:-translate-y-1 hover:border-vb-blue/30 md:p-9">

          <!-- Number -->
          <div class="mb-7 flex items-center justify-between">
            <span class="font-heading text-4xl font-bold text-vb-blue/20">
              {service.number}
            </span>

            <span class="h-10 w-10 rounded-full bg-vb-blue-soft transition-colors duration-300 group-hover:bg-vb-blue"></span>
          </div>

          <!-- Service content -->
          <h3 class="font-heading text-2xl font-bold leading-tight text-vb-navy md:text-3xl">
            {service.title}
          </h3>

          <p class="mt-4 text-base leading-relaxed text-vb-text">
            {service.description}
          </p>

          <!-- Link -->
          <div class="mt-8">
            <a
              href={service.href}
              class="inline-flex items-center gap-3 font-semibold text-vb-blue transition-colors duration-300 hover:text-vb-navy"
            >
              {service.buttonText}

              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="h-5 w-5 shrink-0 transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 12h14m-7-7 7 7-7 7"
                />
              </svg>
            </a>
          </div>

        </article>
      ))}

    </div>
  </div>
</section>
