---
/**
 * Home page: “Trusted by Businesses, Founders and Leaders Across Industries” section.
 */
---

<div
  class="vb-element vb-element-2975989 e-flex e-con-boxed e-con e-parent"
  data-id="2975989"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic","background_motion_fx_motion_fx_scrolling":"yes","background_motion_fx_motion_fx_mouse":"yes","background_motion_fx_devices":["desktop","tablet","mobile"]}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-dd7a2a6 e-con-full e-flex e-con e-child"
      data-id="dd7a2a6"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-92bfcee vb-widget vb-widget-heading"
        data-id="92bfcee"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container">
          <h2 class="vb-heading-title vb-size-default">
            Trusted by Businesses, Founders and Leaders Across Industries
          </h2>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-c603dd9 e-con-full e-grid e-con e-child"
      data-id="c603dd9"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-c115dfc vb-widget vb-widget-counter"
        data-id="c115dfc"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="counter.default"
      >
        <div class="vb-widget-container">
          <div class="vb-counter">
            <div class="vb-counter-title">Clients</div>
            <div class="vb-counter-number-wrapper">
              <span class="vb-counter-number-prefix"></span>
              <span
                class="vb-counter-number"
                data-duration="2000"
                data-to-value="300"
                data-from-value="0"
                data-delimiter=",">0</span
              >
              <span class="vb-counter-number-suffix">+</span>
            </div>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-818d5d0 vb-widget vb-widget-counter"
        data-id="818d5d0"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="counter.default"
      >
        <div class="vb-widget-container">
          <div class="vb-counter">
            <div class="vb-counter-title">Years of Experience</div>
            <div class="vb-counter-number-wrapper">
              <span class="vb-counter-number-prefix"></span>
              <span
                class="vb-counter-number"
                data-duration="2000"
                data-to-value="14"
                data-from-value="0"
                data-delimiter=",">0</span
              >
              <span class="vb-counter-number-suffix">+</span>
            </div>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-54f1dbf vb-widget vb-widget-counter"
        data-id="54f1dbf"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="counter.default"
      >
        <div class="vb-widget-container">
          <div class="vb-counter">
            <div class="vb-counter-title">Global Locations</div>
            <div class="vb-counter-number-wrapper">
              <span class="vb-counter-number-prefix"></span>
              <span
                class="vb-counter-number"
                data-duration="2000"
                data-to-value="6"
                data-from-value="0"
                data-delimiter=",">0</span
              >
              <span class="vb-counter-number-suffix">+</span>
            </div>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-2047b5f vb-widget vb-widget-counter"
        data-id="2047b5f"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="counter.default"
      >
        <div class="vb-widget-container">
          <div class="vb-counter">
            <div class="vb-counter-title">Industry Sectors</div>
            <div class="vb-counter-number-wrapper">
              <span class="vb-counter-number-prefix"></span>
              <span
                class="vb-counter-number"
                data-duration="2000"
                data-to-value="8"
                data-from-value="0"
                data-delimiter=",">0</span
              >
              <span class="vb-counter-number-suffix">+</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
