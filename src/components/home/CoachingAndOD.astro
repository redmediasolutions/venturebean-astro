---
/**
 * Home page: “Coaching & Organisational Development” section.
 */
---

<div
  class="vb-element vb-element-adb999d e-flex e-con-boxed e-con e-parent"
  data-id="adb999d"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-46cb43e e-con-full e-flex e-con e-child"
      data-id="46cb43e"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-6eff326 vb-widget vb-widget-heading"
        data-id="6eff326"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container">
          <h2 class="vb-heading-title vb-size-default">Coaching &amp; Organisational Development</h2>
        </div>
      </div>
      <div
        class="vb-element vb-element-bb795ba e-con-full e-flex e-con e-child"
        data-id="bb795ba"
        data-element_type="container"
        data-e-type="container"
      >
        <div
          class="vb-element vb-element-babd48b e-con-full e-flex e-con e-child"
          data-id="babd48b"
          data-element_type="container"
          data-e-type="container"
        >
          <div
            class="vb-element vb-element-6f65950 vb-widget vb-widget-heading"
            data-id="6f65950"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="heading.default"
          >
            <div class="vb-widget-container">
              <h2 class="vb-heading-title vb-size-default">Transforming Leaders &amp; Teams for Sustained Success</h2>
            </div>
          </div>
          <div
            class="vb-element vb-element-58a94ca vb-widget vb-widget-text-editor"
            data-id="58a94ca"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="text-editor.default"
          >
            <div class="vb-widget-container">
              Helping leaders strengthen capability, improve effectiveness, and lead with greater impact.
            </div>
          </div>
          <div
            class="vb-element vb-element-2904a19 vb--h-position-center vb--v-position-middle vb-arrows-position-inside vb-pagination-position-inside vb-widget vb-widget-slides"
            data-id="2904a19"
            data-element_type="widget"
            data-e-type="widget"
            data-settings={'{"navigation":"both","autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","autoplay_speed":5000,"infinite":"yes","transition":"slide","transition_speed":500}'}
            data-widget_type="slides.default"
          >
            <div class="vb-widget-container">
              <div class="vb-swiper">
                <div
                  class="vb-slides-wrapper vb-main-swiper swiper"
                  role="region"
                  aria-roledescription="carousel"
                  aria-label="Slides"
                  dir="ltr"
                  data-animation="fadeInUp"
                >
                  <div class="swiper-wrapper vb-slides">
                    <div class="vb-repeater-item-85f2282 swiper-slide" role="group" aria-roledescription="slide">
                      <div
                        class="swiper-slide-bg"
                        role="img"
                        aria-label="Businessman planning for corporate growth and success |venturebean"
                      >
                      </div><div class="swiper-slide-inner"><div class="swiper-slide-contents"></div></div>
                    </div><div class="vb-repeater-item-e5d7a45 swiper-slide" role="group" aria-roledescription="slide">
                      <div
                        class="swiper-slide-bg"
                        role="img"
                        aria-label="Business consulting solutions connecting opportunities and growth. |venturebean"
                      >
                      </div><div class="swiper-slide-inner"><div class="swiper-slide-contents"></div></div>
                    </div><div class="vb-repeater-item-24768d4 swiper-slide" role="group" aria-roledescription="slide">
                      <div
                        class="swiper-slide-bg"
                        role="img"
                        aria-label="Arrow on bullseye representing precision and measurable results |venturebean"
                      >
                      </div><div class="swiper-slide-inner"><div class="swiper-slide-contents"></div></div>
                    </div>
                  </div>
                  <div
                    class="vb-swiper-button vb-swiper-button-prev"
                    role="button"
                    tabindex="0"
                    aria-label="Previous slide"
                  >
                    <i aria-hidden="true" class="eicon-chevron-left"></i>
                  </div>
                  <div
                    class="vb-swiper-button vb-swiper-button-next"
                    role="button"
                    tabindex="0"
                    aria-label="Next slide"
                  >
                    <i aria-hidden="true" class="eicon-chevron-right"></i>
                  </div>
                  <div class="swiper-pagination"></div>
                </div>
              </div>
            </div>
          </div>
          <div
            class="vb-element vb-element-5636ef5 vb-align-left vb-widget vb-widget-button"
            data-id="5636ef5"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="button.default"
          >
            <div class="vb-widget-container">
              <div class="vb-button-wrapper">
                <a class="vb-button vb-button-link vb-size-sm" href="/coaching/">
                  <span class="vb-button-content-wrapper">
                    <span class="vb-button-text">Explore Coaching &amp; Leadership Development</span>
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
        <div
          class="vb-element vb-element-9d1024a e-con-full e-grid e-con e-child"
          data-id="9d1024a"
          data-element_type="container"
          data-e-type="container"
        >
          <div
            class="vb-element vb-element-23a28df vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
            data-id="23a28df"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="icon-box.default"
          >
            <div class="vb-widget-container">
              <div class="vb-icon-box-wrapper">
                <div class="vb-icon-box-icon">
                  <span class="vb-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                      ><path
                        d="M21 3C21.5523 3 22 3.44772 22 4V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H21ZM18 12H16V15H13V17H18V12ZM11 7H6V12H8V9H11V7Z"
                      ></path></svg
                    >
                  </span>
                </div>
                <div class="vb-icon-box-content">
                  <h3 class="vb-icon-box-title"><span> Credibility </span></h3>
                  <p class="vb-icon-box-description">
                    ICF-credentialed coaching backed by extensive business and leadership experience.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div
            class="vb-element vb-element-18dc59d vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
            data-id="18dc59d"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="icon-box.default"
          >
            <div class="vb-widget-container">
              <div class="vb-icon-box-wrapper">
                <div class="vb-icon-box-icon">
                  <span class="vb-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                      ><path
                        d="M6.75 2.5C9.09721 2.5 11 4.40279 11 6.75V11H6.75C4.40279 11 2.5 9.09721 2.5 6.75C2.5 4.40279 4.40279 2.5 6.75 2.5ZM9 9V6.75C9 5.50736 7.99264 4.5 6.75 4.5C5.50736 4.5 4.5 5.50736 4.5 6.75C4.5 7.99264 5.50736 9 6.75 9H9ZM6.75 13H11V17.25C11 19.5972 9.09721 21.5 6.75 21.5C4.40279 21.5 2.5 19.5972 2.5 17.25C2.5 14.9028 4.40279 13 6.75 13ZM6.75 15C5.50736 15 4.5 16.0074 4.5 17.25C4.5 18.4926 5.50736 19.5 6.75 19.5C7.99264 19.5 9 18.4926 9 17.25V15H6.75ZM17.25 2.5C19.5972 2.5 21.5 4.40279 21.5 6.75C21.5 9.09721 19.5972 11 17.25 11H13V6.75C13 4.40279 14.9028 2.5 17.25 2.5ZM17.25 9C18.4926 9 19.5 7.99264 19.5 6.75C19.5 5.50736 18.4926 4.5 17.25 4.5C16.0074 4.5 15 5.50736 15 6.75V9H17.25ZM13 13H17.25C19.5972 13 21.5 14.9028 21.5 17.25C21.5 19.5972 19.5972 21.5 17.25 21.5C14.9028 21.5 13 19.5972 13 17.25V13ZM15 15V17.25C15 18.4926 16.0074 19.5 17.25 19.5C18.4926 19.5 19.5 18.4926 19.5 17.25C19.5 16.0074 18.4926 15 17.25 15H15Z"
                      ></path></svg
                    >
                  </span>
                </div>
                <div class="vb-icon-box-content">
                  <h3 class="vb-icon-box-title"><span> Perspective </span></h3>
                  <p class="vb-icon-box-description">
                    Combining coaching expertise with real-world business and leadership insights.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div
            class="vb-element vb-element-f0bf700 vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
            data-id="f0bf700"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="icon-box.default"
          >
            <div class="vb-widget-container">
              <div class="vb-icon-box-wrapper">
                <div class="vb-icon-box-icon">
                  <span class="vb-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                      ><path
                        d="M2 13H8V21H2V13ZM16 8H22V21H16V8ZM9 3H15V21H9V3ZM4 15V19H6V15H4ZM11 5V19H13V5H11ZM18 10V19H20V10H18Z"
                      ></path></svg
                    >
                  </span>
                </div>
                <div class="vb-icon-box-content">
                  <h3 class="vb-icon-box-title"><span> Capability </span></h3>
                  <p class="vb-icon-box-description">
                    Strengthening leadership effectiveness, team performance and future leadership pipelines.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div
            class="vb-element vb-element-67d6e7c vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
            data-id="67d6e7c"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="icon-box.default"
          >
            <div class="vb-widget-container">
              <div class="vb-icon-box-wrapper">
                <div class="vb-icon-box-icon">
                  <span class="vb-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                      ><path
                        d="M12 2C12.5523 2 13 2.44772 13 3V6C13 6.55228 12.5523 7 12 7C11.4477 7 11 6.55228 11 6V3C11 2.44772 11.4477 2 12 2ZM12 17C12.5523 17 13 17.4477 13 18V21C13 21.5523 12.5523 22 12 22C11.4477 22 11 21.5523 11 21V18C11 17.4477 11.4477 17 12 17ZM22 12C22 12.5523 21.5523 13 21 13H18C17.4477 13 17 12.5523 17 12C17 11.4477 17.4477 11 18 11H21C21.5523 11 22 11.4477 22 12ZM7 12C7 12.5523 6.55228 13 6 13H3C2.44772 13 2 12.5523 2 12C2 11.4477 2.44772 11 3 11H6C6.55228 11 7 11.4477 7 12ZM19.0711 19.0711C18.6805 19.4616 18.0474 19.4616 17.6569 19.0711L15.5355 16.9497C15.145 16.5592 15.145 15.9261 15.5355 15.5355C15.9261 15.145 16.5592 15.145 16.9497 15.5355L19.0711 17.6569C19.4616 18.0474 19.4616 18.6805 19.0711 19.0711ZM8.46447 8.46447C8.07394 8.85499 7.44078 8.85499 7.05025 8.46447L4.92893 6.34315C4.53841 5.95262 4.53841 5.31946 4.92893 4.92893C5.31946 4.53841 5.95262 4.53841 6.34315 4.92893L8.46447 7.05025C8.85499 7.44078 8.85499 8.07394 8.46447 8.46447ZM4.92893 19.0711C4.53841 18.6805 4.53841 18.0474 4.92893 17.6569L7.05025 15.5355C7.44078 15.145 8.07394 15.145 8.46447 15.5355C8.85499 15.9261 8.85499 16.5592 8.46447 16.9497L6.34315 19.0711C5.95262 19.4616 5.31946 19.4616 4.92893 19.0711ZM15.5355 8.46447C15.145 8.07394 15.145 7.44078 15.5355 7.05025L17.6569 4.92893C18.0474 4.53841 18.6805 4.53841 19.0711 4.92893C19.4616 5.31946 19.4616 5.95262 19.0711 6.34315L16.9497 8.46447C16.5592 8.85499 15.9261 8.85499 15.5355 8.46447Z"
                      ></path></svg
                    >
                  </span>
                </div>
                <div class="vb-icon-box-content">
                  <h3 class="vb-icon-box-title"><span> Impact </span></h3>
                  <p class="vb-icon-box-description">
                    Translating personal growth into measurable business outcomes through enhanced leadership,
                    accountability, and execution.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
