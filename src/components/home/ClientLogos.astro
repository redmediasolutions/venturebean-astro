---
/**
 * Home page: “Clients” section.
 */
import ClientLogoMarquee from '../client-logos/ClientLogoMarquee.astro';
import HomeLogoStrip from '../client-logos/saved/HomeLogoStrip.astro';
---

<div
  class="vb-element vb-element-74866ad e-con-full e-flex e-con e-parent"
  data-id="74866ad"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div
    class="vb-element vb-element-34a3156 e-con-full e-flex e-con e-child"
    data-id="34a3156"
    data-element_type="container"
    data-e-type="container"
  >
    <div
      class="vb-element vb-element-b941abf vb-hidden-mobile vb-widget vb-widget-spacer"
      data-id="b941abf"
      data-element_type="widget"
      data-e-type="widget"
      id="clients"
      data-widget_type="spacer.default"
    >
      <div class="vb-widget-container"><div class="vb-spacer"><div class="vb-spacer-inner"></div></div></div>
    </div>
    <div
      class="vb-element vb-element-8d397ce vb-widget vb-widget-heading"
      data-id="8d397ce"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="heading.default"
    >
      <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Clients</h2></div>
    </div>
    <div
      class="vb-element vb-element-6523710 vb-widget vb-widget-text-editor"
      data-id="6523710"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="text-editor.default"
    >
      <div class="vb-widget-container"><p>Trusted by Leading Brands Worldwide</p></div>
    </div>
    <div
      class="vb-element vb-element-2d2c138 vb-widget vb-widget-deensimc-smooth-marquee"
      data-id="2d2c138"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="deensimc-smooth-marquee.default"
    >
      <div class="vb-widget-container">
        <div class="deensimc-wrapper deensimc-wrapper-horizontal">
          <div
            class="deensimc-marquee deensimc-shadow deensimc-marquee-horizontal"
            data-pause-on-hover="yes"
            data-animation-speed="100"
          >
            <ClientLogoMarquee><HomeLogoStrip /></ClientLogoMarquee>
          </div>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-3555e2b vb-align-center vb-mobile-align-left vb-widget vb-widget-button"
      data-id="3555e2b"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="button.default"
    >
      <div class="vb-widget-container">
        <div class="vb-button-wrapper">
          <a class="vb-button vb-button-link vb-size-sm" href="/clients/">
            <span class="vb-button-content-wrapper"> <span class="vb-button-text">View All Clients</span> </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
