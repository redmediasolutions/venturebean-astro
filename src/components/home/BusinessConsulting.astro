---
/**
 * Home page: “Business Consulting” section.
 */
---

<div
  class="vb-element vb-element-a80e43c e-flex e-con-boxed e-con e-parent"
  data-id="a80e43c"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic","shape_divider_top":"triangle-asymmetrical","shape_divider_bottom":"mountains"}'}
>
  <div class="e-con-inner">
    <div class="vb-shape vb-shape-top" aria-hidden="true" data-negative="false">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 100" preserveAspectRatio="none">
        <path class="vb-shape-fill" d="M738,99l262-93V0H0v5.6L738,99z"></path>
      </svg>
    </div>
    <div class="vb-shape vb-shape-bottom" aria-hidden="true" data-negative="false">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 100" preserveAspectRatio="none">
        <path
          class="vb-shape-fill"
          opacity="0.33"
          d="M473,67.3c-203.9,88.3-263.1-34-320.3,0C66,119.1,0,59.7,0,59.7V0h1000v59.7 c0,0-62.1,26.1-94.9,29.3c-32.8,3.3-62.8-12.3-75.8-22.1C806,49.6,745.3,8.7,694.9,4.7S492.4,59,473,67.3z"
        ></path>
        <path
          class="vb-shape-fill"
          opacity="0.66"
          d="M734,67.3c-45.5,0-77.2-23.2-129.1-39.1c-28.6-8.7-150.3-10.1-254,39.1 s-91.7-34.4-149.2,0C115.7,118.3,0,39.8,0,39.8V0h1000v36.5c0,0-28.2-18.5-92.1-18.5C810.2,18.1,775.7,67.3,734,67.3z"
        ></path>
        <path
          class="vb-shape-fill"
          d="M766.1,28.9c-200-57.5-266,65.5-395.1,19.5C242,1.8,242,5.4,184.8,20.6C128,35.8,132.3,44.9,89.9,52.5C28.6,63.7,0,0,0,0 h1000c0,0-9.9,40.9-83.6,48.1S829.6,47,766.1,28.9z"
        ></path>
      </svg>
    </div>
    <div
      class="vb-element vb-element-acda0d8 e-con-full e-flex e-con e-child"
      data-id="acda0d8"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-ea3a75d vb-widget vb-widget-heading"
        data-id="ea3a75d"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Business Consulting</h2></div>
      </div>
      <div
        class="vb-element vb-element-55472a2 e-con-full e-flex e-con e-child"
        data-id="55472a2"
        data-element_type="container"
        data-e-type="container"
      >
        <div
          class="vb-element vb-element-6ebc79a e-con-full e-flex e-con e-child"
          data-id="6ebc79a"
          data-element_type="container"
          data-e-type="container"
        >
          <div
            class="vb-element vb-element-af4ed12 vb-widget vb-widget-heading"
            data-id="af4ed12"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="heading.default"
          >
            <div class="vb-widget-container">
              <h2 class="vb-heading-title vb-size-default">Scaling SMBs with Strategy and Systems</h2>
            </div>
          </div>
          <div
            class="vb-element vb-element-a836a2d vb-widget vb-widget-text-editor"
            data-id="a836a2d"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="text-editor.default"
          >
            <div class="vb-widget-container">
              <p>
                Supporting SMBs, family businesses, founders, and leadership teams in achieving growth, improving
                performance, and building scalable organisations.
              </p>
            </div>
          </div>
          <div
            class="vb-element vb-element-66d98ac vb--h-position-center vb--v-position-middle vb-arrows-position-inside vb-pagination-position-inside vb-widget vb-widget-slides"
            data-id="66d98ac"
            data-element_type="widget"
            data-e-type="widget"
            data-settings={'{"navigation":"both","autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","autoplay_speed":5000,"infinite":"yes","transition":"slide","transition_speed":500}'}
            data-widget_type="slides.default"
          >
            <div class="vb-widget-container">
              <div class="vb-swiper">
                <div
                  class="vb-slides-wrapper vb-main-swiper swiper"
                  role="region"
                  aria-roledescription="carousel"
                  aria-label="Slides"
                  dir="ltr"
                  data-animation="fadeInUp"
                >
                  <div class="swiper-wrapper vb-slides">
                    <div class="vb-repeater-item-e5d7a45 swiper-slide" role="group" aria-roledescription="slide">
                      <div
                        class="swiper-slide-bg"
                        role="img"
                        aria-label="Business growth and investment nurturing for sustainable success |venturebean"
                      >
                      </div><div class="swiper-slide-inner"><div class="swiper-slide-contents"></div></div>
                    </div><div class="vb-repeater-item-24768d4 swiper-slide" role="group" aria-roledescription="slide">
                      <div
                        class="swiper-slide-bg"
                        role="img"
                        aria-label="Highway of innovation symbolizing future-ready consulting |venturebean"
                      >
                      </div><div class="swiper-slide-inner"><div class="swiper-slide-contents"></div></div>
                    </div>
                  </div>
                  <div
                    class="vb-swiper-button vb-swiper-button-prev"
                    role="button"
                    tabindex="0"
                    aria-label="Previous slide"
                  >
                    <i aria-hidden="true" class="eicon-chevron-left"></i>
                  </div>
                  <div
                    class="vb-swiper-button vb-swiper-button-next"
                    role="button"
                    tabindex="0"
                    aria-label="Next slide"
                  >
                    <i aria-hidden="true" class="eicon-chevron-right"></i>
                  </div>
                  <div class="swiper-pagination"></div>
                </div>
              </div>
            </div>
          </div>
          <div
            class="vb-element vb-element-f98a645 vb-align-left vb-mobile-align-center vb-widget vb-widget-button"
            data-id="f98a645"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="button.default"
          >
            <div class="vb-widget-container">
              <div class="vb-button-wrapper">
                <a class="vb-button vb-button-link vb-size-sm" href="/business-consulting/">
                  <span class="vb-button-content-wrapper">
                    <span class="vb-button-text">Explore Business Consulting</span>
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
        <div
          class="vb-element vb-element-14c831b e-con-full e-grid e-con e-child"
          data-id="14c831b"
          data-element_type="container"
          data-e-type="container"
        >
          <div
            class="vb-element vb-element-396d9e9 vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
            data-id="396d9e9"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="icon-box.default"
          >
            <div class="vb-widget-container">
              <div class="vb-icon-box-wrapper">
                <div class="vb-icon-box-icon">
                  <span class="vb-icon"> <i aria-hidden="true" class="fas fa-signal"></i> </span>
                </div>
                <div class="vb-icon-box-content">
                  <h3 class="vb-icon-box-title"><span> Growth </span></h3>
                  <p class="vb-icon-box-description">
                    Helping businesses identify opportunities, accelerate growth and improve performance.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div
            class="vb-element vb-element-eeb0178 vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
            data-id="eeb0178"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="icon-box.default"
          >
            <div class="vb-widget-container">
              <div class="vb-icon-box-wrapper">
                <div class="vb-icon-box-icon">
                  <span class="vb-icon"> <i aria-hidden="true" class="fas fa-bullseye"></i> </span>
                </div>
                <div class="vb-icon-box-content">
                  <h3 class="vb-icon-box-title"><span> Experience </span></h3>
                  <p class="vb-icon-box-description">
                    Drawing on decades of leadership, consulting and operational expertise.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div
            class="vb-element vb-element-36b623c vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
            data-id="36b623c"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="icon-box.default"
          >
            <div class="vb-widget-container">
              <div class="vb-icon-box-wrapper">
                <div class="vb-icon-box-icon">
                  <span class="vb-icon"> <i aria-hidden="true" class="fas fa-window-restore"></i> </span>
                </div>
                <div class="vb-icon-box-content">
                  <h3 class="vb-icon-box-title"><span> Execution </span></h3>
                  <p class="vb-icon-box-description">
                    Turning strategy into action through practical implementation support.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div
            class="vb-element vb-element-311a21d vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
            data-id="311a21d"
            data-element_type="widget"
            data-e-type="widget"
            data-widget_type="icon-box.default"
          >
            <div class="vb-widget-container">
              <div class="vb-icon-box-wrapper">
                <div class="vb-icon-box-icon">
                  <span class="vb-icon"> <i aria-hidden="true" class="fab fa-buffer"></i> </span>
                </div>
                <div class="vb-icon-box-content">
                  <h3 class="vb-icon-box-title"><span> Results </span></h3>
                  <p class="vb-icon-box-description">Focused on measurable business outcomes and sustainable growth.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-e5768fc e-con-full e-flex e-con e-child"
        data-id="e5768fc"
        data-element_type="container"
        data-e-type="container"
      >
      </div>
    </div>
  </div>
</div>
