---
/**
 * Home page: intro videos section.
 */
---

<div
  class="vb-element vb-element-ce50150 e-flex e-con-boxed e-con e-parent"
  data-id="ce50150"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-c5800aa e-con-full e-flex vb-invisible e-con e-child"
      data-id="c5800aa"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"animation":"fadeInUp"}'}
    >
      <div
        class="vb-element vb-element-0dd0a8b vb-widget vb-widget-video"
        data-id="0dd0a8b"
        data-element_type="widget"
        data-e-type="widget"
        data-settings={'{"video_type":"vimeo"}'}
        data-widget_type="video.default"
      >
        <div class="vb-widget-container">
          <div class="vb-wrapper vb-open-inline">
            <iframe
              loading="lazy"
              class="vb-video-iframe"
              allowfullscreen=""
              allow="clipboard-write"
              title="vimeo Video Player"
              src="https://player.vimeo.com/video/962019603?color&autopause=0&loop=0&muted=0&title=1&portrait=0&byline=0#t="
            ></iframe>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-708af1d vb-icon-list--layout-traditional vb-list-item-link-full_width vb-widget vb-widget-icon-list"
        data-id="708af1d"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-list.default"
      >
        <div class="vb-widget-container">
          <ul class="vb-icon-list-items">
            <li class="vb-icon-list-item">
              <span class="vb-icon-list-icon"> <i aria-hidden="true" class="fas fa-video"></i> </span>
              <span class="vb-icon-list-text">Introduction to VentureBean</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-d6ab8bb e-con-full e-flex vb-invisible e-con e-child"
      data-id="d6ab8bb"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"animation":"fadeInUp","animation_delay":300}'}
    >
      <div
        class="vb-element vb-element-b2463e3 vb-widget vb-widget-video"
        data-id="b2463e3"
        data-element_type="widget"
        data-e-type="widget"
        data-settings={'{"video_type":"vimeo"}'}
        data-widget_type="video.default"
      >
        <div class="vb-widget-container">
          <div class="vb-wrapper vb-open-inline">
            <iframe
              loading="lazy"
              class="vb-video-iframe"
              allowfullscreen=""
              allow="clipboard-write"
              title="vimeo Video Player"
              src="https://player.vimeo.com/video/962019714?color&autopause=0&loop=0&muted=0&title=1&portrait=0&byline=0#t="
            ></iframe>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-cdefb49 vb-icon-list--layout-traditional vb-list-item-link-full_width vb-widget vb-widget-icon-list"
        data-id="cdefb49"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-list.default"
      >
        <div class="vb-widget-container">
          <ul class="vb-icon-list-items">
            <li class="vb-icon-list-item">
              <span class="vb-icon-list-icon"> <i aria-hidden="true" class="fas fa-video"></i> </span>
              <span class="vb-icon-list-text">Vision &amp; Purpose of VentureBean</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
