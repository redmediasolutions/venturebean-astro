
---
/**
 * Home page: “Industries We Serve” section.
 */

const industries = [
  {
    title: "Technology",
    description: "IT, SaaS, ITES, Analytics, Digital Platforms",
    image: "https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1794912910147-technology.jpg",
    alt: "Digital technology and global connectivity",
    position: "center",
  },
  {
    title: "BFSI",
    description: "Banking, Financial Services, Insurance, FinTech",
    image: "https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1794912971315-fmcg.jpg",
    alt: "Modern commercial and financial district",
    position: "center",
  },
  {
    title: "Consumer",
    description: "FMCG, Retail, Travel, Leisure & Entertainment",
    image: "https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1794913018433-hosoi.jpg",
    alt: "Consumer retail and hospitality",
    position: "center",
  },
  {
    title: "Healthcare",
    description: "MedTech, Pharma, Healthcare Providers",
    image: "https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1794913055625-healthcare.jpg",
    alt: "Healthcare professionals",
    position: "center",
  },
  {
    title: "Education",
    description: "EdTech, Universities, Institutions",
    image: "https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1794913101479-education.jpg",
    alt: "Education and learning environment",
    position: "center",
  },
  {
    title: "Professional Services",
    description: "Consulting, Shared Services, BPO/KPO, Hospitality",
    image: "https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1794913200922-professional-services.webp",
    alt: "Professional business meeting",
    position: "center",
  },
  {
    title: "Infrastructure & Manufacturing",
    description: "Realty, Telecom, Industrial, Automotive, Chemicals",
    image: "https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1794913259446-manufacturing.jpg",
    alt: "Industrial infrastructure and manufacturing",
    position: "center",
  },
  {
    title: "Energy & Utilities",
    description: "Power, Renewables, Utilities, Oil & Gas",
    image: "https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1794913311535-4.jpg",
    alt: "Energy production and renewable power",
    position: "center",
  },
];
---

<section class="bg-[#F1F2F5] py-16 md:py-20 lg:py-24">
  <div class="mx-auto w-full max-w-[1600px] px-6 lg:px-8">

    <!-- Section Introduction -->
    <div class="mb-8 md:mb-10">
      <h2 class="font-heading text-3xl font-bold leading-tight tracking-tight text-vb-navy md:text-4xl lg:text-5xl">
        Industries We Serve
      </h2>

      <p class="mt-2 font-heading text-lg font-semibold text-[#333333] md:text-xl">
        Comprehensive Solutions Tailored for Every Industry
      </p>

      <p class="mt-6 max-w-5xl text-base leading-relaxed text-[#444444] md:text-lg">
        Our experience spans multiple industries, enabling us to bring
        cross-sector insights while addressing industry-specific challenges.
      </p>
    </div>

    <!-- Industry Image Grid -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {industries.map((industry) => (
        <article
          class="group relative isolate flex aspect-[1.65/1] min-h-[230px] items-end overflow-hidden rounded-vb-lg bg-[#151A35]"
        >
          <!-- Background Image -->
          <img
            src={industry.image}
            alt={industry.alt}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 -z-20 h-full w-full object-cover object-center transition-all duration-700 ease-out group-hover:scale-105 group-hover:brightness-110"
            style={`object-position: ${industry.position};`}
          />

          <!-- Cool Navy Gradient Overlay -->
          <div
            class="absolute inset-0 -z-10 bg-gradient-to-t
            from-[#101044]/95
            via-[#101044]/55
            to-[#101044]/10
            transition-all duration-500
            group-hover:from-[#101044]/90
            group-hover:via-[#101044]/40
            group-hover:to-[#101044]/5"
          ></div>

          <!-- Subtle Slate Tint -->
          <div class="absolute inset-0 -z-10 bg-gradient-to-br from-slate-900/15 via-transparent to-blue-950/20"></div>

          <!-- Card Content -->
          <div class="w-full p-6 md:p-7">
            <h3 class="font-heading !text-[22px] !font-bold leading-tight !text-white md:text-3xl">
              {industry.title}
            </h3>

            <p class="mt-4 max-w-sm !text-sm leading-relaxed text-white/95 md:text-base">
              {industry.description}
            </p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
