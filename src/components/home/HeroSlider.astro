---
/**
 * Home page: hero slider section.
 */
---

<div
  class="vb-element vb-element-08745f3 e-con-full e-flex e-con e-parent"
  data-id="08745f3"
  data-element_type="container"
  data-e-type="container"
>
  <div
    class="vb-element vb-element-0737d66 e-con-full e-flex e-con e-child"
    data-id="0737d66"
    data-element_type="container"
    data-e-type="container"
  >
    <div
      class="vb-element vb-element-690206c vb--v-position-bottom vb--h-position-center vb-arrows-position-inside vb-widget vb-widget-slides"
      data-id="690206c"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"navigation":"arrows","autoplay_speed":4000,"autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","infinite":"yes","transition":"slide","transition_speed":500}'}
      data-widget_type="slides.default"
    >
      <div class="vb-widget-container">
        <div class="vb-swiper">
          <div
            class="vb-slides-wrapper vb-main-swiper swiper"
            role="region"
            aria-roledescription="carousel"
            aria-label="Slides"
            dir="ltr"
            data-animation="fadeInUp"
          >
            <div class="swiper-wrapper vb-slides">
              <div class="vb-repeater-item-0a583bb swiper-slide" role="group" aria-roledescription="slide">
                <div
                  class="swiper-slide-bg vb-ken-burns vb-ken-burns--in"
                  role="img"
                  aria-label="Business Growth and Sustainability Concept | venturebean"
                >
                </div><div class="vb-background-overlay"></div><div class="swiper-slide-inner">
                  <div class="swiper-slide-contents">
                    <div class="vb-slide-heading">Business Consulting</div><div class="vb-slide-description">
                      Driving SMB Business Growth &amp; Transformation through Strategy, Process Improvements, CXO
                      Advisory
                    </div><a href="/business-consulting/" class="vb-button vb-slide-button vb-size-sm">Get Started</a>
                  </div>
                </div>
              </div><div class="vb-repeater-item-1d1a4ec swiper-slide" role="group" aria-roledescription="slide">
                <div
                  class="swiper-slide-bg vb-ken-burns vb-ken-burns--in"
                  role="img"
                  aria-label="Sales Training and Coaching Workshop | VentureBean"
                >
                </div><div class="vb-background-overlay"></div><div class="swiper-slide-inner">
                  <div class="swiper-slide-contents">
                    <div class="vb-slide-heading">Executive, Leadership Coaching</div><div class="vb-slide-description">
                      Enabling Growth for Professionals, Entrepreneurs &amp; Teams Across SMBs, Family Businesses &amp;
                      Corporates
                    </div><a href="/coaching/" class="vb-button vb-slide-button vb-size-sm">Start Your Journey</a>
                  </div>
                </div>
              </div><div class="vb-repeater-item-93dc079 swiper-slide" role="group" aria-roledescription="slide">
                <div
                  class="swiper-slide-bg vb-ken-burns vb-ken-burns--in"
                  role="img"
                  aria-label="Smart growth solutions with strategy, systems, and leadership development |venturebean"
                >
                </div><div class="vb-background-overlay"></div><div class="swiper-slide-inner">
                  <div class="swiper-slide-contents">
                    <div class="vb-slide-heading">Smart Growth Solutions</div><div class="vb-slide-description">
                      Curated packages combining strategy, systems, and leadership development for measurable impact.
                    </div><a href="/venturebean-solutions-page/" class="vb-button vb-slide-button vb-size-sm"
                      >Get Started</a>
                  </div>
                </div>
              </div><div class="vb-repeater-item-05372a2 swiper-slide" role="group" aria-roledescription="slide">
                <div
                  class="swiper-slide-bg vb-ken-burns vb-ken-burns--in"
                  role="img"
                  aria-label="Data-driven consulting with growth analytics and performance metrics |venturebean"
                >
                </div><div class="vb-background-overlay"></div><div class="swiper-slide-inner">
                  <div class="swiper-slide-contents">
                    <div class="vb-slide-heading">Differentiators</div><div class="vb-slide-description">
                      Data-Driven Consulting &amp; Coaching Powered by 6-Sigma, SMART Goals, KPIs and ROI-Focused
                      Growth.
                    </div><a href="/about-us/#guiding" class="vb-button vb-slide-button vb-size-sm">See It In Action</a>
                  </div>
                </div>
              </div>
            </div>
            <div class="vb-swiper-button vb-swiper-button-prev" role="button" tabindex="0" aria-label="Previous slide">
              <i aria-hidden="true" class="eicon-chevron-left"></i>
            </div>
            <div class="vb-swiper-button vb-swiper-button-next" role="button" tabindex="0" aria-label="Next slide">
              <i aria-hidden="true" class="eicon-chevron-right"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
