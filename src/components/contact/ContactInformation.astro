              data-e-type="widget"
              data-widget_type="icon-list.default"
            >
              <div class="vb-widget-container">
                <ul class="vb-icon-list-items">
                  <li class="vb-icon-list-item">
                    <span class="vb-icon-list-icon"> <i aria-hidden="true" class="fas fa-phone-alt"></i> </span>
                    <span class="vb-icon-list-text">+91 9810961665</span>
                  </li>
                  <li class="vb-icon-list-item">
                    <span class="vb-icon-list-icon"> <i aria-hidden="true" class="fas fa-envelope"></i> </span>
                    <span class="vb-icon-list-text">beanie@venturebean.com</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
          <div
            class="vb-element vb-element-5a7f2cf e-con-full e-flex e-con e-child"
            data-id="5a7f2cf"
            data-element_type="container"
            data-e-type="container"
          >
            <div
              class="vb-element vb-element-be094df vb-position-inline-start vb-mobile-position-inline-start vb-view-default vb-widget vb-widget-icon-box"
              data-id="be094df"
              data-element_type="widget"
              data-e-type="widget"
              data-widget_type="icon-box.default"
            >
              <div class="vb-widget-container">
                <div class="vb-icon-box-wrapper">
                  <div class="vb-icon-box-icon">
                    <span class="vb-icon"> <i aria-hidden="true" class="fas fa-map-marker-alt"></i> </span>
                  </div>
                  <div class="vb-icon-box-content">
