---
/**
 * Contact (Reach Us) page: “Set Up a Discovery Call” section.
 */
---

<div
  class="vb-element vb-element-66a1534 e-flex e-con-boxed e-con e-parent"
  data-id="66a1534"
  data-element_type="container"
  data-e-type="container"
  id="connect"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-dd42885 e-con-full e-flex e-con e-child"
      data-id="dd42885"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-be7eb2f vb-widget vb-widget-heading"
        data-id="be7eb2f"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Set Up a Discovery Call</h2></div>
      </div>
      <div
        class="vb-element vb-element-45150dc vb-widget vb-widget-text-editor"
        data-id="45150dc"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container"><p>Discuss your requirement for yourself, your team or Organisation</p></div>
      </div>
      <div
        class="vb-element vb-element-feb0f20 vb-widget vb-widget-text-editor"
        data-id="feb0f20"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container">
          <p class="p1">Tell us what you’re looking for — the more details you share, the better we can help!</p>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-749f899 e-con-full e-flex e-con e-child"
      data-id="749f899"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"background_background":"classic"}'}
    >
      <div
        class="vb-element vb-element-26a1335 vb-widget vb-widget-html"
        data-id="26a1335"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="html.default"
      >
        <div class="vb-widget-container">
          <div
            class="calendly-inline-widget"
            data-url="https://calendly.com/mathew-isac"
            style="min-width:300;height:450px;"
          >
          </div>
          <script is:inline type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async=""
          ></script>
        </div>
      </div>
    </div>
  </div>
</div>
