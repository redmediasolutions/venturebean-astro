
---
/**
 * Article card used in Insights tabs and "Continue Reading".
 */
import type { BlogPost } from "../../lib/posts";
import { excerptOf, formatDate } from "../../lib/article";

interface Props {
  post: BlogPost;
  category: string;
}

const { post } = Astro.props;

const href = `/knowledge-hub/insights/${post.slug}/`;
const date = formatDate(post.publishedAt);
const img = post.featuredImage;
---

<article
  class="flex h-full flex-col overflow-hidden rounded-vb-lg border border-gray-200 bg-white shadow-vb-card transition-shadow duration-200 hover:shadow-lg"
>
  {img && (
    <a
      href={href}
      class="block aspect-[16/9] w-full overflow-hidden bg-vb-light"
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        loading="lazy"
        decoding="async"
        src={img.url}
        alt={img.alt}
        class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
      />
    </a>
  )}

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h3 class="font-heading text-xl font-bold leading-snug text-vb-navy">
      <a href={href} class="transition-colors hover:text-vb-blue !no-underline !text-vb-navy !text-[20px]">
        {post.title}
      </a>
    </h3>

    <div class="mt-3 flex-1 font-sans text-sm leading-relaxed text-vb-text">
      <p>{excerptOf(post)}</p>
    </div>

    <div class="mt-5 flex items-center justify-between gap-4 border-t border-gray-100 pt-4">
      {date && (
        <time class="font-sans text-xs text-vb-text">
          {date}
        </time>
      )}

      <a
        href={href}
        class="inline-flex shrink-0 items-center gap-1 font-sans text-sm font-semibold !text-vb-blue transition-colors hover:text-vb-navy !no-underline"
        aria-label={`Read more about ${post.title}`}
      >
        Read More
        <span aria-hidden="true">»</span>
      </a>
    </div>
  </div>
</article>
