---
/**
 * Article page header (desktop): "BLOG", title, date; the featured image is
 * set as the background of the right-hand box by the article page.
 */

interface Props {
  title: string;
  date: string;
}

const { title, date } = Astro.props;
---

<div
  class="vb-element vb-element-b399b4d vb-hidden-tablet vb-hidden-mobile e-flex e-con-boxed e-con e-parent"
  data-id="b399b4d"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-ac260df e-con-full e-flex e-con e-child"
      data-id="ac260df"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-e9cc142 vb-widget vb-widget-text-editor"
        data-id="e9cc142"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container">
          <p>BLOG</p>
        </div>
      </div>
      <div
        class="vb-element vb-element-c93bac8 vb-widget vb-widget-theme-post-title vb-page-title vb-widget-heading"
        data-id="c93bac8"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="theme-post-title.default"
      >
        <div class="vb-widget-container"><h1 class="vb-heading-title vb-size-default">{title}</h1></div>
      </div>
      <div
        class="vb-element vb-element-4d68a17 vb-widget-divider--view-line vb-widget vb-widget-divider"
        data-id="4d68a17"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="divider.default"
      >
        <div class="vb-widget-container">
          <div class="vb-divider">
            <span class="vb-divider-separator"> </span>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-f8dc98a vb-widget vb-widget-post-info"
        data-id="f8dc98a"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="post-info.default"
      >
        <div class="vb-widget-container">
          <ul class="vb-inline-items vb-icon-list-items vb-post-info">
            <li class="vb-icon-list-item vb-repeater-item-e52f00d vb-inline-item" itemprop="datePublished">
              <a href="/knowledge-hub/insights/">
                <span class="vb-icon-list-icon">
                  <i aria-hidden="true" class="fas fa-calendar"></i>
                </span>
                <span class="vb-icon-list-text vb-post-info__item vb-post-info__item--type-date">
                  <time>{date}</time>
                </span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-474937f e-con-full e-flex e-con e-child"
      data-id="474937f"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"background_background":"classic"}'}
    >
    </div>
  </div>
</div>
