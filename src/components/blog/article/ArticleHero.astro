
---
/**
 * Article page desktop hero.
 * Full-width featured background with a left-to-right gradient.
 */

interface Props {
  title: string;
  date: string;
}

const { title, date } = Astro.props;
---

<section
  class="relative hidden min-h-[440px] w-full overflow-hidden bg-vb-navy bg-cover bg-center bg-no-repeat md:flex lg:min-h-[500px]"
  style="background-image: var(--article-hero-image, none);"
>
  <!-- Left-to-right gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-r from-vb-navy via-vb-navy/90 to-vb-navy/20"></div>

  <!-- Additional subtle bottom overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-vb-navy/30 via-transparent to-transparent"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto flex w-full max-w-vb items-center px-8 py-16 lg:px-14 xl:px-20">
    <div class="max-w-3xl">

      <p class="mb-5 font-sans text-xs font-bold uppercase tracking-[0.2em] text-vb-blue-light">
        Blog
      </p>

      <h1 class="font-heading text-4xl font-bold leading-tight !text-white lg:text-5xl xl:text-6xl">
        {title}
      </h1>

      <div class="mt-7 h-px w-16 bg-vb-blue-light"></div>

      <div class="mt-5 flex items-center gap-2.5 font-sans text-sm font-medium text-white/80">
        <i class="fas fa-calendar text-vb-blue-light" aria-hidden="true"></i>
        <time>{date}</time>
      </div>

    </div>
  </div>
</section>
