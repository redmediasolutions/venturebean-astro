
---
/**
 * Article page header (tablet and mobile).
 * Featured image on top, followed by title and publication date.
 */

interface Props {
  title: string;
  date: string;
}

const { title, date } = Astro.props;
---

<section class="w-full bg-vb-light md:hidden">
  <!-- Featured image -->
  <div
    class="relative h-[240px] w-full overflow-hidden bg-vb-blue-soft sm:h-[320px]"
    style="background-image: var(--article-hero-image, none); background-position: center; background-size: cover; background-repeat: no-repeat;"
    role="img"
    aria-label="Article featured image"
  >
    <div class="absolute inset-0 bg-gradient-to-t from-vb-navy/20 to-transparent"></div>
  </div>

  <!-- Article information -->
  <div class="mx-auto flex w-full max-w-vb flex-col px-6 py-7 sm:px-8 sm:py-9">

    <p class="mb-3 font-sans text-[11px] font-bold uppercase tracking-[0.2em] text-vb-blue">
      Blog
    </p>

    <h1 class="font-heading text-3xl font-bold leading-tight text-vb-navy sm:text-4xl">
      {title}
    </h1>

    <div class="mt-5 h-px w-14 bg-vb-blue"></div>

    <div class="mt-4 flex items-center gap-2 font-sans text-xs font-medium text-vb-text">
      <i class="fas fa-calendar text-vb-blue" aria-hidden="true"></i>
      <time>{date}</time>
    </div>

  </div>
</section>
