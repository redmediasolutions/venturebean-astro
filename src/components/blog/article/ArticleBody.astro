---
/**
 * Article content with sticky sidebar:
 * Table of Contents and Calendly booking widget.
 */

import { REPORT_FORM_MARKER, type TocItem } from '../../../lib/article';
import ReportDownload from './ReportDownload.astro';
import TableOfContents from '../TableOfContents.astro';
import CalendlyWidget from '../CalendlyWidget.astro';

interface Props {
  content: string;
  toc: TocItem[];
  download?: {
    pdf: string;
    postId: string;
    slug: string;
    title: string;
  } | null;
}

const { content, toc, download } = Astro.props;

const [before, ...rest] = content.split(REPORT_FORM_MARKER);
const after = rest.join('');
const atMarker = rest.length > 0;
---

<section class="w-full bg-white px-6 py-8 sm:px-8 md:py-12 lg:py-14">
  <div class="mx-auto grid w-full max-w-[1240px] grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,900px)_300px] lg:gap-10">

    <!-- Article content -->
    <article class="min-w-0 w-full">
      <div class="article-content text-[15px] leading-[1.75]">
        <Fragment set:html={before} />

        {download && atMarker && (
          <ReportDownload {...download} />
        )}

        <Fragment set:html={after} />

        {download && !atMarker && (
          <ReportDownload {...download} heading />
        )}
      </div>
    </article>

    <!-- Article sidebar -->
    <aside
  id="side-bar"
  class="flex w-full min-w-0 flex-col gap-6 lg:sticky lg:top-28 lg:w-[360px]"
  aria-label="Article navigation and booking"
>
      <!-- Table of Contents -->
      <details
        class="group w-full min-w-0 overflow-hidden rounded-vb-lg border border-vb-blue-soft bg-white"
        open
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-heading text-base font-semibold text-vb-navy [&::-webkit-details-marker]:hidden">
          <span>Table of Contents</span>

          <i
            class="fas fa-chevron-down shrink-0 text-xs text-vb-blue transition-transform duration-200 group-open:rotate-180"
            aria-hidden="true"
          ></i>
        </summary>

        <div class="min-w-0 border-t border-vb-blue-soft px-4 py-3">
          <TableOfContents items={toc} />
        </div>
      </details>

      <!-- Calendly booking -->
      <div class="w-full min-w-0 overflow-hidden rounded-vb-lg">
        <CalendlyWidget />
      </div>
    </aside>

  </div>
</section>
