---
import type { BlogPost } from "../../../lib/posts";
import PostCard from "../PostCard.astro";

interface Props {
  related: BlogPost[];
  category: string;
}

const { related, category } = Astro.props;
const posts: BlogPost[] = related.slice(0, 4);
---

{posts.length > 0 && (
  <section class="w-full bg-vb-light px-5 py-9 sm:px-8 md:py-11 lg:py-12">
    <div class="mx-auto w-full max-w-vb">

      <!-- Section heading -->
      <div class="mb-6">
        <h2 class="font-heading text-2xl font-bold leading-tight text-vb-navy sm:text-3xl">
          Continue Reading
        </h2>
        <p class="mt-1 font-sans text-sm text-vb-text">
          Explore more articles in this category.
        </p>
      </div>

      <!-- Related articles -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
       {posts.map((post: BlogPost) => (
  <PostCard post={post} category={category} />
))}
      </div>

    </div>
  </section>
)}
