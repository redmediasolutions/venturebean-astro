---
/**
 * Knowledge Hub page: “Recent Uploads” section.
 * Hidden on every screen size (kept as it was on the WordPress page).
 */
---

<div
  class="vb-element vb-element-1201a44 vb-hidden-desktop vb-hidden-tablet vb-hidden-mobile e-flex e-con-boxed e-con e-parent"
  data-id="1201a44"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-f359045 vb-widget vb-widget-heading"
      data-id="f359045"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="heading.default"
    >
      <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Recent Uploads</h2></div>
    </div>
    <div
      class="vb-element vb-element-8890ef6 vb-widget vb-widget-heading"
      data-id="8890ef6"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="heading.default"
    >
      <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">View Archive</h2></div>
    </div>
  </div>
</div>
