---
/**
 * Media Spotlight page (Knowledge Hub → Media Spotlight): hero slider section.
 */
---

<div
  class="vb-element vb-element-8627b36 e-flex e-con-boxed e-con e-parent"
  data-id="8627b36"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-e119a88 vb--v-position-bottom vb--h-position-center vb-arrows-position-inside vb-widget vb-widget-slides"
      data-id="e119a88"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"navigation":"arrows","autoplay_speed":4000,"autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","infinite":"yes","transition":"slide","transition_speed":500}'}
      data-widget_type="slides.default"
    >
      <div class="vb-widget-container">
        <div class="vb-swiper">
          <div
            class="vb-slides-wrapper vb-main-swiper swiper"
            role="region"
            aria-roledescription="carousel"
            aria-label="Slides"
            dir="ltr"
            data-animation="fadeInUp"
          >
            <div class="swiper-wrapper vb-slides">
              <div class="vb-repeater-item-0a583bb swiper-slide" role="group" aria-roledescription="slide">
                <div class="swiper-slide-bg vb-ken-burns vb-ken-burns--in" role="img" aria-label="About us"></div><div
                  class="vb-background-overlay"
                >
                </div><div class="swiper-slide-inner">
                  <div class="swiper-slide-contents">
                    <div class="vb-slide-heading">Media Spotlight</div><div class="vb-slide-description">
                      Explore our visual journey through photos and videos showcasing VentureBean's events, innovations,
                      and impact in the global business ecosystem.
                    </div><a href="/contact-us/" class="vb-button vb-slide-button vb-size-sm">Get Started</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
