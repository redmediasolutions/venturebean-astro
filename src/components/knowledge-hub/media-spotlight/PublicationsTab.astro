---
/**
 * Media Spotlight — Publications tab.
 * Cards are supplied by the Content Manager.
 */
import MediaCardList from "../cards/MediaCardList.astro";
import SavedMediaCards from "./saved/SavedMediaCards.astro";
---

<section class="w-full" aria-labelledby="publications-heading">
  <!-- Section heading -->
  <div class="mb-6">
    <h2
      id="publications-heading"
      class="font-heading text-2xl font-bold leading-tight text-vb-navy sm:text-3xl"
    >
      Publications
    </h2>

    <p class="mt-2 max-w-2xl font-sans text-sm leading-relaxed text-vb-text sm:text-base">
      Browse through moments captured at our events, offices, and collaborative spaces.
    </p>
  </div>

  <!-- Publication cards -->
  <div class="w-full">
    <MediaCardList />
  </div>
</section>
