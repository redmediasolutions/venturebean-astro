---
/**
 * Media Spotlight page (Knowledge Hub → Media Spotlight): “Publications” tab (cards from the Content Manager).
 */
import MediaCardList from '../cards/MediaCardList.astro';
import SavedMediaCards from './saved/SavedMediaCards.astro';
---

<div
  id="e-n-tab-content-352483921"
  role="tabpanel"
  aria-labelledby="e-n-tab-title-352483921"
  data-tab-index="1"
  style="--n-tabs-title-order: 1;"
  class="e-active vb-element vb-element-c0b28b0 e-con-full e-flex e-con e-child"
  data-id="c0b28b0"
  data-element_type="container"
  data-e-type="container"
>
  <div
    class="vb-element vb-element-68965e0 vb-widget vb-widget-heading"
    data-id="68965e0"
    data-element_type="widget"
    data-e-type="widget"
    data-widget_type="heading.default"
  >
    <div class="vb-widget-container">
      <h2 class="vb-heading-title vb-size-default">Publications</h2>
    </div>
  </div>
  <div
    class="vb-element vb-element-f2884e2 vb-widget vb-widget-text-editor"
    data-id="f2884e2"
    data-element_type="widget"
    data-e-type="widget"
    data-widget_type="text-editor.default"
  >
    <div class="vb-widget-container">
      <p>Browse through moments captured at our events, offices, and collaborative spaces</p>
    </div>
  </div>
  <div
    class="vb-element vb-element-107254d vb-grid-2 vb-widget__width-initial vb-grid-tablet-2 vb-grid-mobile-1 vb-widget vb-widget-loop-grid"
    data-id="107254d"
    data-element_type="widget"
    data-e-type="widget"
    data-settings={'{"template_id":24249,"row_gap":{"unit":"px","size":45,"sizes":[]},"columns":2,"_skin":"post","columns_tablet":"2","columns_mobile":"1","edit_handle_selector":"[data-vb-type=\\"loop-item\\"]","row_gap_tablet":{"unit":"px","size":"","sizes":[]},"row_gap_mobile":{"unit":"px","size":"","sizes":[]}}'}
    data-widget_type="loop-grid.post"
  >
    <div class="vb-widget-container">
      <div class="vb-loop-container vb-grid" role="list">
        <style is:inline id="loop-24249">
          .vb-24249 .vb-element.vb-element-0c5aae4 {
            --display: flex;
            --min-height: 0px;
            --flex-direction: column;
            --container-widget-width: calc((1 - var(--container-widget-flex-grow)) * 100%);
            --container-widget-height: initial;
            --container-widget-flex-grow: 0;
            --container-widget-align-self: initial;
            --flex-wrap-mobile: wrap;
            --align-items: flex-start;
            --gap: 0px 0px;
            --row-gap: 0px;
            --column-gap: 0px;
            --border-radius: 10px 10px 10px 10px;
            box-shadow: 2px 4px 10px -11px rgba(0, 0, 0, 0.1411764705882353);
          }
          .vb-24249 .vb-element.vb-element-0c5aae4:not(.vb-motion-effects-element-type-background),
          .vb-24249 .vb-element.vb-element-0c5aae4 > .vb-motion-effects-container > .vb-motion-effects-layer {
            background-color: #ffffff;
          }
          .vb-24249 .vb-element.vb-element-0c5aae4:hover {
            box-shadow: 0px 0px 10px 0px rgba(2.623913043478273, 26.501521739130354, 241.40000000000003, 0.5);
          }
          .vb-24249 .vb-element.vb-element-0c5aae4.e-con {
            --flex-grow: 0;
            --flex-shrink: 0;
          }
          .vb-24249 .vb-element.vb-element-8376f13 {
            --display: flex;
            --min-height: 304px;
            --flex-direction: column;
            --container-widget-width: 100%;
            --container-widget-height: initial;
            --container-widget-flex-grow: 0;
            --container-widget-align-self: initial;
            --flex-wrap-mobile: wrap;
            --border-radius: 7px 7px 7px 7px;
          }
          .vb-24249 .vb-element.vb-element-8376f13:not(.vb-motion-effects-element-type-background),
          .vb-24249 .vb-element.vb-element-8376f13 > .vb-motion-effects-container > .vb-motion-effects-layer {
            background-position: center center;
            background-repeat: no-repeat;
            background-size: cover;
          }
          .vb-24249 .vb-element.vb-element-92ee2dd > .vb-widget-container {
            padding: 13px 0px 0px 0px;
          }
          .vb-24249 .vb-element.vb-element-92ee2dd .vb-heading-title {
            font-family: 'League Spartan', Sans-serif;
            font-size: 18px;
            font-weight: 600;
            color: #100057;
          }
          .vb-24249 .vb-element.vb-element-eff1d91 {
            --divider-border-style: solid;
            --divider-color: #000;
            --divider-border-width: 1px;
            width: var(--container-widget-width, 48%);
            max-width: 48%;
            --container-widget-width: 48%;
            --container-widget-flex-grow: 0;
          }
          .vb-24249 .vb-element.vb-element-eff1d91 .vb-divider-separator {
            width: 100%;
          }
          .vb-24249 .vb-element.vb-element-eff1d91 .vb-divider {
            padding-block-start: 15px;
            padding-block-end: 15px;
          }
          .vb-24249 .vb-element.vb-element-7e8cabc .vb-icon-list-icon i {
            color: #cfcfcf;
            font-size: 14px;
          }
          .vb-24249 .vb-element.vb-element-7e8cabc .vb-icon-list-icon svg {
            fill: #cfcfcf;
            --e-icon-list-icon-size: 14px;
          }
          .vb-24249 .vb-element.vb-element-7e8cabc .vb-icon-list-icon {
            width: 14px;
          }
          .vb-24249 .vb-element.vb-element-7e8cabc .vb-icon-list-text,
          .vb-24249 .vb-element.vb-element-7e8cabc .vb-icon-list-text a {
            color: #575656;
          }
          .vb-24249 .vb-element.vb-element-7e8cabc .vb-icon-list-item {
            font-size: 12px;
          }
          @media (max-width: 767px) {
            .vb-24249 .vb-element.vb-element-92ee2dd .vb-heading-title {
              font-size: 26px;
            }
          }
          @media (min-width: 768px) {
            .vb-24249 .vb-element.vb-element-0c5aae4 {
              --width: 100%;
            }
            .vb-24249 .vb-element.vb-element-8376f13 {
              --width: 100%;
            }
          }
          @media (min-width: 1025px) {
            .vb-24249 .vb-element.vb-element-8376f13:not(.vb-motion-effects-element-type-background),
            .vb-24249 .vb-element.vb-element-8376f13 > .vb-motion-effects-container > .vb-motion-effects-layer {
              background-attachment: scroll;
            }
          }
        </style><MediaCardList><SavedMediaCards /></MediaCardList>
      </div>
    </div>
