---
/**
 * Media Spotlight page (Knowledge Hub → Media Spotlight): “Stay Connected” section.
 */
---

<div
  class="vb-element vb-element-f5123a5 e-flex e-con-boxed e-con e-parent"
  data-id="f5123a5"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-1ac6a9a e-con-full e-flex e-con e-child"
      data-id="1ac6a9a"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"background_background":"classic"}'}
    >
      <div
        class="vb-element vb-element-923dd38 vb-widget vb-widget-heading"
        data-id="923dd38"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container">
          <h2 class="vb-heading-title vb-size-default">Stay Connected</h2>
        </div>
      </div>
      <div
        class="vb-element vb-element-4798ddf vb-widget vb-widget-text-editor"
        data-id="4798ddf"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container">
          <p>Email us to receive the latest updates, insights, and exclusive content directly in your inbox</p>
        </div>
      </div>
      <div
        class="vb-element vb-element-0619bb3 vb-widget vb-widget-button"
        data-id="0619bb3"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="button.default"
      >
        <div class="vb-widget-container">
          <div class="vb-button-wrapper">
            <a class="vb-button vb-button-link vb-size-sm" href="/contact-us/">
              <span class="vb-button-content-wrapper">
                <span class="vb-button-text">Stay Connected</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
