
---
/**
 * Media Spotlight — Stay Connected section.
 */
---

<section class="w-full bg-vb-light px-5 py-10 sm:px-8 md:py-12">
  <div class="mx-auto w-full max-w-vb">
    <div class="rounded-vb-lg bg-white px-6 py-8 text-center shadow-vb-card sm:px-10 sm:py-10">
      <div class="mx-auto max-w-2xl">
        <h2 class="font-heading text-3xl font-bold leading-tight text-vb-navy sm:text-4xl">
          Stay Connected
        </h2>

        <p class="mt-3 font-sans text-sm leading-relaxed text-vb-text sm:text-base">
          Email us to receive the latest updates, insights, and exclusive content directly in your inbox.
        </p>

        <a
          href="/contact-us/"
          class="mt-6 inline-flex min-h-11 items-center justify-center rounded-vb bg-vb-blue px-7 py-3 font-sans text-sm font-semibold text-white transition-colors hover:bg-vb-blue-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vb-blue"
        >
          Stay Connected
        </a>
      </div>
    </div>
  </div>
</section>
