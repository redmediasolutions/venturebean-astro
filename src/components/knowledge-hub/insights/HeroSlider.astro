---
/**
 * Insights page (Knowledge Hub → Insights): hero slider section.
 */
---

<div
  class="vb-element vb-element-6bbe9a2 e-con-full e-flex e-con e-parent"
  data-id="6bbe9a2"
  data-element_type="container"
  data-e-type="container"
>
  <div
    class="vb-element vb-element-bbcd359 vb--v-position-bottom vb--h-position-center vb-arrows-position-inside vb-pagination-position-inside vb-widget vb-widget-slides"
    data-id="bbcd359"
    data-element_type="widget"
    data-e-type="widget"
    data-settings={'{"navigation":"both","autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","autoplay_speed":5000,"infinite":"yes","transition":"slide","transition_speed":500}'}
    data-widget_type="slides.default"
  >
    <div class="vb-widget-container">
      <div class="vb-swiper">
        <div
          class="vb-slides-wrapper vb-main-swiper swiper"
          role="region"
          aria-roledescription="carousel"
          aria-label="Slides"
          dir="ltr"
          data-animation="fadeInUp"
        >
          <div class="swiper-wrapper vb-slides">
            <div class="vb-repeater-item-d59db3a swiper-slide" role="group" aria-roledescription="slide">
              <div
                class="swiper-slide-bg vb-ken-burns vb-ken-burns--in"
                role="img"
                aria-label="Business Strategy and Digital Insights Interface |venturebean"
              >
              </div><div class="vb-background-overlay"></div><a class="swiper-slide-inner" href="#guiding"
                ><div class="swiper-slide-contents">
                  <div class="vb-slide-heading">Insights</div><div class="vb-slide-description">
                    Insights that Drive Smarter Decisions.
                  </div><div class="vb-button vb-slide-button vb-size-sm">Unlock insights</div>
                </div></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
