
---
/**
 * Insights page
 * Displays Consulting and Coaching posts in one unified listing.
 */

import { getArticlePosts } from '../../../lib/posts';
import { excerptWords, formatDate } from '../../../lib/article';
import VBButton from '../../../components/global/VBButton.astro';

const posts = (await getArticlePosts())
  .filter((post) =>
    post.categorySlugs.some((slug) =>
      ['consulting', 'coaching'].includes(slug.toLowerCase())
    )
  )
  .sort((a, b) => {
    const dateA = a.publishedAt?.getTime() ?? 0;
    const dateB = b.publishedAt?.getTime() ?? 0;
    return dateB - dateA;
  });
---

<section class="w-full bg-white px-6 py-8 sm:px-8 md:py-10 lg:py-12">
  <div class="mx-auto w-full max-w-vb">

    {posts.length > 0 ? (
      <>
        <div
          id="insights-post-grid"
          class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
          role="list"
        >
          {posts.map((post) => {
            const category = post.categorySlugs.some(
              (slug) => slug.toLowerCase() === 'consulting'
            )
              ? 'Consulting'
              : 'Coaching';

            const href = `/knowledge-hub/insights/${post.slug}/`;
            const image = post.featuredImage?.url;
            const publishedDate = post.publishedAt;

            return (
              <article
                class="insights-post-card group flex h-full min-w-0 flex-col overflow-hidden rounded-vb-lg bg-white shadow-vb-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(16,16,68,0.14)]"
                role="listitem"
              >
                <a
                  href={href}
                  class="relative block h-[175px] w-full shrink-0 overflow-hidden bg-vb-blue-soft"
                  aria-label={`Read ${post.title}`}
                >
                  {image ? (
                    <img
                      src={image}
                      alt={post.featuredImage?.alt || post.title}
                      loading="lazy"
                      class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-vb-navy to-vb-blue">
                      <span class="font-heading text-xl font-bold text-white/80">
                        VentureBean
                      </span>
                    </div>
                  )}

                  <div class="absolute inset-0 bg-gradient-to-t from-vb-navy/20 to-transparent"></div>
                </a>

                <div class="flex flex-1 flex-col px-4 pb-4 pt-4">

                  <div class="mb-3">
                    <span
                      class:list={[
                        'inline-flex items-center rounded-full px-2.5 py-1 font-sans text-[10px] font-bold uppercase tracking-wider',
                        category === 'Consulting'
                          ? 'bg-vb-blue-soft text-vb-blue'
                          : 'bg-vb-light text-vb-navy',
                      ]}
                    >
                      {category}
                    </span>
                  </div>

                  <h2 class="font-heading !text-xl font-semibold !leading-snug !text-vb-navy transition-colors duration-200 group-hover:text-vb-blue">
                    <a
                      href={href}
                      class="!text-vb-navy !no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vb-blue"
                    >
                      {post.title}
                    </a>
                  </h2>

                  {publishedDate && (
                    <div class="mt-2 flex items-center gap-1.5 text-[11px] font-semibold text-vb-text">
                      <i class="fas fa-calendar text-vb-blue" aria-hidden="true"></i>
                      <time datetime={publishedDate.toISOString()}>
                        {formatDate(publishedDate)}
                      </time>
                    </div>
                  )}

                  <div class="mt-3 flex-1 font-sans text-[13px] leading-relaxed text-vb-text">
                    {excerptWords(post, 25)}
                  </div>

                  <div class="mt-4">
                    <VBButton href={href} label="Read Article" size="sm" arrow />
                  </div>

                </div>
              </article>
            );
          })}
        </div>

        <div
          id="insights-load-more-sentinel"
          class="h-px"
          aria-hidden="true"
        ></div>
      </>
    ) : (
      <div class="py-12 text-center">
        <p class="font-sans text-sm text-vb-text">
          No insights are currently available.
        </p>
      </div>
    )}

  </div>
</section>

<style>
  .insights-post-card.insights-hidden {
    display: none;
  }
</style>

<script>
  const BATCH_SIZE = 9;

  const grid = document.querySelector<HTMLElement>('#insights-post-grid');
  const sentinel = document.querySelector<HTMLElement>(
    '#insights-load-more-sentinel'
  );

  if (grid && sentinel) {
    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>('.insights-post-card')
    );

    if (cards.length > BATCH_SIZE) {
      let shown = BATCH_SIZE;

      cards.slice(BATCH_SIZE).forEach((card) => {
        card.classList.add('insights-hidden');
      });

      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;

          cards
            .slice(shown, shown + BATCH_SIZE)
            .forEach((card) => card.classList.remove('insights-hidden'));

          shown += BATCH_SIZE;

          if (shown >= cards.length) {
            observer.disconnect();
          }
        },
        { rootMargin: '600px 0px' }
      );

      observer.observe(sentinel);
    }
  }
</script>
