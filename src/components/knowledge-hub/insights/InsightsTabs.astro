---
/**
 * Insights page (Knowledge Hub → Insights): “Why every growing company needs SOPs to scale” section.
 */
import PostCardList from '../../blog/PostCardList.astro';
import ConsultingCards from '../../blog/saved/ConsultingCards.astro';
import CoachingCards from '../../blog/saved/CoachingCards.astro';
---

<div
  class="vb-element vb-element-9a4f701 e-flex e-con-boxed e-con e-parent"
  data-id="9a4f701"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-b253be0 e-n-tabs-mobile vb-widget vb-widget-n-tabs"
      data-id="b253be0"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"tabs_justify_horizontal":"start","horizontal_scroll":"disable"}'}
      data-widget_type="nested-tabs.default"
    >
      <div class="vb-widget-container">
        <div
          class="e-n-tabs"
          data-widget-number="186989536"
          aria-label="Tabs. Open items with Enter or Space, close with Escape and navigate using the Arrow keys."
        >
          <div class="e-n-tabs-heading" role="tablist">
            <button
              id="e-n-tab-title-1869895361"
              data-tab-title-id="e-n-tab-title-1869895361"
              class="e-n-tab-title"
              aria-selected="true"
              data-tab-index="1"
              role="tab"
              tabindex="0"
              aria-controls="e-n-tab-content-1869895361"
              style="--n-tabs-title-order: 1;"
            >
              <span class="e-n-tab-title-text"> Consulting </span>
            </button>
            <button
              id="e-n-tab-title-1869895362"
              data-tab-title-id="e-n-tab-title-1869895362"
              class="e-n-tab-title"
              aria-selected="false"
              data-tab-index="2"
              role="tab"
              tabindex="-1"
              aria-controls="e-n-tab-content-1869895362"
              style="--n-tabs-title-order: 2;"
            >
              <span class="e-n-tab-title-text"> Coaching </span>
            </button>
          </div>
          <div class="e-n-tabs-content">
            <div
              id="e-n-tab-content-1869895361"
              role="tabpanel"
              aria-labelledby="e-n-tab-title-1869895361"
              data-tab-index="1"
              style="--n-tabs-title-order: 1;"
              class="e-active vb-element vb-element-11534d6 e-con-full e-flex e-con e-child"
              data-id="11534d6"
              data-element_type="container"
              data-e-type="container"
            >
              <div
                class="vb-element vb-element-65149b6 vb-grid-3 vb-grid-tablet-2 vb-grid-mobile-1 vb-posts--thumbnail-top vb-card-shadow-yes vb-posts__hover-gradient vb-widget vb-widget-posts"
                data-id="65149b6"
                data-element_type="widget"
                data-e-type="widget"
                data-settings={'{"pagination_type":"numbers_and_prev_next","cards_columns":"3","cards_columns_tablet":"2","cards_columns_mobile":"1","cards_row_gap":{"unit":"px","size":35,"sizes":[]},"cards_row_gap_tablet":{"unit":"px","size":"","sizes":[]},"cards_row_gap_mobile":{"unit":"px","size":"","sizes":[]}}'}
                data-widget_type="posts.cards"
              >
                <div class="vb-widget-container">
                  <div class="vb-posts-container vb-posts vb-posts--skin-cards vb-grid" role="list">
                    <PostCardList category="consulting"><ConsultingCards /></PostCardList>
                  </div>

                  <div
                    class="e-load-more-anchor"
                    data-page="1"
                    data-max-page="11"
                    data-next-page="/knowledge-hub/insights/"
                  >
                  </div>
                  <nav class="vb-pagination" aria-label="Pagination">
                    <span class="page-numbers prev">« Previous</span>
                    <span aria-current="page" class="page-numbers current"
                      ><span class="vb-screen-only">Page</span>1</span
                    >
                    <a class="page-numbers" href="/knowledge-hub/insights/"><span class="vb-screen-only">Page</span>2</a
                    >
                    <a class="page-numbers" href="/knowledge-hub/insights/"><span class="vb-screen-only">Page</span>3</a
                    >
                    <span class="page-numbers dots">…</span>
                    <a class="page-numbers" href="/knowledge-hub/insights/"
                      ><span class="vb-screen-only">Page</span>11</a
                    >
                    <a class="page-numbers next" href="/knowledge-hub/insights/">Next »</a>
                  </nav>
                </div>
              </div>
            </div>
            <div
              id="e-n-tab-content-1869895362"
              role="tabpanel"
              aria-labelledby="e-n-tab-title-1869895362"
              data-tab-index="2"
              style="--n-tabs-title-order: 2;"
              class="vb-element vb-element-a03dcdf e-con-full e-flex e-con e-child"
              data-id="a03dcdf"
              data-element_type="container"
              data-e-type="container"
            >
              <div
                class="vb-element vb-element-0b54ffe vb-grid-3 vb-grid-tablet-2 vb-grid-mobile-1 vb-posts--thumbnail-top vb-card-shadow-yes vb-posts__hover-gradient vb-widget vb-widget-posts"
                data-id="0b54ffe"
                data-element_type="widget"
                data-e-type="widget"
                data-settings={'{"pagination_type":"numbers_and_prev_next","cards_columns":"3","cards_columns_tablet":"2","cards_columns_mobile":"1","cards_row_gap":{"unit":"px","size":35,"sizes":[]},"cards_row_gap_tablet":{"unit":"px","size":"","sizes":[]},"cards_row_gap_mobile":{"unit":"px","size":"","sizes":[]}}'}
                data-widget_type="posts.cards"
              >
                <div class="vb-widget-container">
                  <div class="vb-posts-container vb-posts vb-posts--skin-cards vb-grid" role="list">
                    <PostCardList category="coaching"><CoachingCards /></PostCardList>
                  </div>

                  <div
                    class="e-load-more-anchor"
                    data-page="1"
                    data-max-page="7"
                    data-next-page="/knowledge-hub/insights/"
                  >
                  </div>
                  <nav class="vb-pagination" aria-label="Pagination">
                    <span class="page-numbers prev">« Previous</span>
                    <span aria-current="page" class="page-numbers current"
                      ><span class="vb-screen-only">Page</span>1</span
                    >
                    <a class="page-numbers" href="/knowledge-hub/insights/"><span class="vb-screen-only">Page</span>2</a
                    >
                    <a class="page-numbers" href="/knowledge-hub/insights/"><span class="vb-screen-only">Page</span>3</a
                    >
                    <span class="page-numbers dots">…</span>
                    <a class="page-numbers" href="/knowledge-hub/insights/"><span class="vb-screen-only">Page</span>7</a
                    >
                    <a class="page-numbers next" href="/knowledge-hub/insights/">Next »</a>
                  </nav>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
