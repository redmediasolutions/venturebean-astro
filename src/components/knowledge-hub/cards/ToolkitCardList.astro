---
/**
 * Toolkit → Frameworks
 *
 * Displays Content Manager posts in the Toolkit category,
 * newest first.
 *
 * Each card includes:
 * - Featured image
 * - Title
 * - First-line description
 * - Learn More link
 *
 * Saved cards are rendered through the default slot
 * when no Content Manager posts are available.
 */

import { getSectionPosts } from "../../../lib/posts";
import { subtitleOf } from "../../../lib/article";

const posts = await getSectionPosts("toolkit");
const toolkitPosts = posts ?? [];
---

{
  toolkitPosts.length > 0 ? (
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-7">
      {toolkitPosts.map((post) => {
        const href = `/knowledge-hub/toolkit/${post.slug}/`;
        const image = post.featuredImage;

        return (
          <article class="group flex h-full flex-col overflow-hidden rounded-vb-lg border border-gray-100 bg-white shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-vb-card">

            <!-- Featured image -->
            {image ? (
              <a
                href={href}
                aria-label={post.title}
                tabindex="-1"
                class="block overflow-hidden"
              >
                <img
                  src={image.url}
                  alt={image.alt ?? post.title}
                  width={image.width ?? undefined}
                  height={image.height ?? undefined}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/9] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                />
              </a>
            ) : (
              <div class="flex aspect-[16/9] w-full items-center justify-center bg-vb-blue-soft">
                <span class="font-heading text-lg font-semibold text-vb-blue">
                  VentureBean
                </span>
              </div>
            )}

            <!-- Card content -->
            <div class="flex flex-1 flex-col p-5 sm:p-6">

              <h2 class="font-heading text-xl font-semibold leading-snug !text-vb-navy sm:text-2xl">
                <a
                  href={href}
                  class="transition-colors hover:text-vb-blue !no-underline !text-vb-navy !text-[20px]"
                >
                  {post.title}
                </a>
              </h2>

              <p class="mt-3 line-clamp-2 font-sans text-sm leading-relaxed !text-vb-text sm:text-base">
                {subtitleOf(post)}
              </p>

              <div class="mt-auto pt-5">
                <a
                  href={href}
                  class="inline-flex items-center gap-2 font-sans text-sm font-semibold !text-vb-blue transition-colors hover:text-vb-blue-muted no-underline"
                >
                  Learn More
                  <span aria-hidden="true">→</span>
                </a>
              </div>

            </div>
          </article>
        );
      })}
    </div>
  ) : (
    <slot />
  )
}
