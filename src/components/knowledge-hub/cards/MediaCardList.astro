---
/**
 * Media Spotlight → Publications
 *
 * Displays Content Manager posts in newest-first order.
 * Card link: Link custom field, falling back to the post URL.
 * Image: Featured image.
 * Date: Publish date.
 *
 * Saved cards supplied through the default slot are displayed
 * when no Content Manager posts are available.
 */

import { getSectionPosts, linkOf, postPath } from "../../../lib/posts";
import { formatDate } from "../../../lib/article";
import { linkTarget } from "./link-target";

const posts = await getSectionPosts("publications");

const cards = (posts ?? []).map((post) => {
  const href =
    linkOf(post) ??
    (post.content.trim() ? postPath(post.slug) : undefined);

  return {
    post,
    href,
    ...linkTarget(href),
    date: formatDate(post.publishedAt),
    image: post.featuredImage?.url,
  };
});
---

{
  cards.length > 0 ? (
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
      {cards.map(({ post, href, target, rel, date, image }) => (
        <article class="group flex h-full flex-col overflow-hidden rounded-vb-lg border border-gray-100 bg-white shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-vb-card">

          <!-- Featured image -->
          {href ? (
            <a
              href={href}
              target={target}
              rel={rel}
              aria-label={post.title}
              class="block overflow-hidden"
              tabindex="-1"
            >
              {image ? (
                <img
                  src={image}
                  alt=""
                  loading="lazy"
                  class="aspect-[16/9] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                />
              ) : (
                <div class="flex aspect-[16/9] w-full items-center justify-center bg-vb-blue-soft">
                  <span class="font-heading text-lg font-semibold text-vb-blue">
                    VentureBean
                  </span>
                </div>
              )}
            </a>
          ) : (
            image ? (
              <img
                src={image}
                alt=""
                loading="lazy"
                class="aspect-[16/9] w-full object-cover"
              />
            ) : (
              <div class="flex aspect-[16/9] w-full items-center justify-center bg-vb-blue-soft">
                <span class="font-heading text-lg font-semibold text-vb-blue">
                  VentureBean
                </span>
              </div>
            )
          )}

          <!-- Card content -->
          <div class="flex flex-1 flex-col p-5 sm:p-6">
            <h3 class="font-heading text-xl !font-semibold leading-snug text-vb-navy sm:text-2xl">
              {href ? (
                <a
                  href={href}
                  target={target}
                  rel={rel}
                  class="transition-colors hover:text-vb-blue !no-underline !text-vb-navy !text-[20px]"
                >
                  {post.title}
                </a>
              ) : (
                post.title
              )}
            </h3>

            <div class="my-4 h-px w-1/2 bg-gray-200" />

            {date && (
              <div class="mt-auto flex items-center gap-2 font-sans text-xs text-vb-text">
                <i class="fas fa-calendar text-gray-400" aria-hidden="true" />
                <time datetime={post.publishedAt?.toISOString()}>
  {date}
</time>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <slot />
  )
}
