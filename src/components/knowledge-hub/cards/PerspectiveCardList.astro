
---
/**
 * Industry Perspectives
 *
 * Displays posts from the Industry Perspectives category,
 * newest first. Falls back to saved cards when no posts exist.
 */

import { getSectionPosts } from "../../../lib/posts";
import { excerptWords, formatDate } from "../../../lib/article";
import VBButton from "../../../components/global/VBButton.astro";

const posts = await getSectionPosts("industryPerspectives");
---

{posts && posts.length > 0 ? (
  posts.map((post) => {
    const href = `/knowledge-hub/industry-perspectives/${post.slug}/`;
    const image = post.featuredImage?.url;

    const publishedDate = post.publishedAt;
    const dateTime = publishedDate
      ? publishedDate.toISOString()
      : undefined;

    return (
      <article
        data-vb-type="loop-item"
        data-vb-id="25438"
        data-vb-post-type="post"
        class="group flex h-full min-w-0 flex-col overflow-hidden rounded-vb-lg bg-white shadow-vb-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(16,16,68,0.16)]"
      >
        <!-- Featured Image -->
        <a
          href={href}
          class="relative block h-[220px] w-full shrink-0 overflow-hidden bg-vb-blue-soft sm:h-[235px]"
          aria-label={`Read ${post.title}`}
        >
          {image ? (
            <img
              src={image}
              alt={post.featuredImage?.alt || post.title}
              loading="lazy"
              class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-vb-navy to-vb-blue">
              <span class="font-heading text-2xl font-bold text-white/80">
                VentureBean
              </span>
            </div>
          )}

          <div class="absolute inset-0 bg-gradient-to-t from-vb-navy/25 to-transparent opacity-60"></div>
        </a>

        <!-- Card Content -->
        <div class="flex flex-1 flex-col px-5 pb-6 pt-5 sm:px-6">

          <!-- Title -->
          <h2 class="font-heading text-xl font-semibold leading-snug !text-vb-navy transition-colors duration-200 group-hover:text-vb-blue md:text-[21px]">
            <a
              href={href}
              class="!text-vb-navy !no-underline text-[23px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vb-blue"
            >
              {post.title}
            </a>
          </h2>

          <!-- Published Date -->
          {publishedDate && (
            <div class="mt-3 flex items-center gap-2 text-xs font-semibold text-vb-text">
              <i class="fas fa-calendar text-vb-blue" aria-hidden="true"></i>
              <time datetime={dateTime}>
                {formatDate(publishedDate)}
              </time>
            </div>
          )}

          <!-- Excerpt -->
          <div class="mt-4 flex-1 font-sans text-sm leading-relaxed text-vb-text">
            {excerptWords(post, 25)}
          </div>

          <!-- VB Button -->
          <div class="mt-6">
            <VBButton
              href={href}
              label="Read Article"
              size="sm"
              arrow
            />
          </div>

        </div>
      </article>
    );
  })
) : (
  <slot />
)}
