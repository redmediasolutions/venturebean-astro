
---
/**
 * Industry Perspectives – Featured Insights heading section.
 */
---

<section
  class="w-full bg-white px-6 py-8 sm:px-8 md:py-10 lg:py-12"
  aria-labelledby="featured-insights-heading"
>
  <div class="mx-auto w-full max-w-vb text-center">
    <h2
      id="featured-insights-heading"
      class="font-heading text-3xl font-bold leading-tight text-vb-navy sm:text-4xl"
    >
      Featured Insights
    </h2>

    <p
      class="mx-auto mt-3 max-w-3xl font-sans text-sm leading-relaxed text-vb-text sm:text-base"
    >
      Your central repository for strategic insights, market analysis, and
      expert articles on industry trends.
    </p>
  </div>
</section>
