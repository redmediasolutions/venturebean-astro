---
/**
 * Industry Perspectives page (Knowledge Hub → Industry Perspectives): “Featured Insights” section.
 */
---

<div
  class="vb-element vb-element-4f1f8ee e-flex e-con-boxed e-con e-parent"
  data-id="4f1f8ee"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-efd0fd8 vb-widget vb-widget-heading"
      data-id="efd0fd8"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="heading.default"
    >
      <div class="vb-widget-container">
        <h2 class="vb-heading-title vb-size-default">Featured Insights</h2>
      </div>
    </div>
    <div
      class="vb-element vb-element-a7aa406 vb-widget vb-widget-text-editor"
      data-id="a7aa406"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="text-editor.default"
    >
      <div class="vb-widget-container">
        <p>Your central repository for strategic insights, market analysis, and expert articles on industry trends.</p>
      </div>
    </div>
  </div>
</div>
