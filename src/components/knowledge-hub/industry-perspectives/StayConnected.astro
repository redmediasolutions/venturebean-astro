---
/**
 * Industry Perspectives page (Knowledge Hub → Industry Perspectives): “Stay Connected” section.
 * Hidden on every screen size (as on the WordPress page).
 */
---

<div
  class="vb-element vb-element-9f86a89 e-con-full vb-hidden-tablet vb-hidden-mobile vb-hidden-desktop e-flex e-con e-child"
  data-id="9f86a89"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div
    class="vb-element vb-element-b49fbdc vb-widget vb-widget-heading"
    data-id="b49fbdc"
    data-element_type="widget"
    data-e-type="widget"
    data-widget_type="heading.default"
  >
    <div class="vb-widget-container">
      <h2 class="vb-heading-title vb-size-default">Stay Connected</h2>
    </div>
  </div>
  <div
    class="vb-element vb-element-7be8502 vb-widget vb-widget-text-editor"
    data-id="7be8502"
    data-element_type="widget"
    data-e-type="widget"
    data-widget_type="text-editor.default"
  >
    <div class="vb-widget-container">
      <p>Email us to receive the latest updates, insights, and exclusive content directly in your inbox</p>
    </div>
  </div>
  <div
    class="vb-element vb-element-7f4fe86 vb-widget vb-widget-button"
    data-id="7f4fe86"
    data-element_type="widget"
    data-e-type="widget"
    data-widget_type="button.default"
  >
    <div class="vb-widget-container">
      <div class="vb-button-wrapper">
        <a class="vb-button vb-button-link vb-size-sm" href="#">
          <span class="vb-button-content-wrapper">
            <span class="vb-button-text">Stay Connected</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</div>
