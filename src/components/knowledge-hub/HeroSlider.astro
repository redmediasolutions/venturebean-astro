---
/**
 * Knowledge Hub page: hero slider section.
 */
---

<div
  class="vb-element vb-element-dab242a e-con-full e-flex e-con e-parent"
  data-id="dab242a"
  data-element_type="container"
  data-e-type="container"
>
  <div
    class="vb-element vb-element-c0b7c58 e-con-full e-flex e-con e-child"
    data-id="c0b7c58"
    data-element_type="container"
    data-e-type="container"
  >
    <div
      class="vb-element vb-element-1692ac1 vb--v-position-bottom vb--h-position-center vb-arrows-position-inside vb-widget vb-widget-slides"
      data-id="1692ac1"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"navigation":"arrows","autoplay_speed":4000,"autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","infinite":"yes","transition":"slide","transition_speed":500}'}
      data-widget_type="slides.default"
    >
      <div class="vb-widget-container">
        <div class="vb-swiper">
          <div
            class="vb-slides-wrapper vb-main-swiper swiper"
            role="region"
            aria-roledescription="carousel"
            aria-label="Slides"
            dir="ltr"
            data-animation="fadeInUp"
          >
            <div class="swiper-wrapper vb-slides">
              <div class="vb-repeater-item-0a583bb swiper-slide" role="group" aria-roledescription="slide">
                <div class="swiper-slide-bg vb-ken-burns vb-ken-burns--in" role="img" aria-label="solutions banner 2">
                </div><div class="vb-background-overlay"></div><div class="swiper-slide-inner">
                  <div class="swiper-slide-contents">
                    <div class="vb-slide-heading">Strategic Intelligence Central</div><div class="vb-slide-description">
                      Your central repository for strategic insights, market analysis, and performance reports .
                    </div><a href="/contact-us/" class="vb-button vb-slide-button vb-size-sm">Talk to an Expert</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
