
---
interface FlowStep {
  title: string;
  description: string;
  accent: "green" | "navy" | "blue" | "orange";
}

interface Props {
  title?: string;
  paragraphs: string[];
  steps?: FlowStep[];
}

const {
  title = "How It Comes Together",
  paragraphs,
  steps = [
    {
      title: "People execute",
      description: "processes",
      accent: "green",
    },
    {
      title: "Processes are",
      description: "enabled by technology",
      accent: "navy",
    },
    {
      title: "Technology",
      description: "provides insight for governance",
      accent: "blue",
    },
    {
      title: "Governance",
      description: "reinforces accountability",
      accent: "orange",
    },
  ],
} = Astro.props as Props;

const accentStyles: Record<
  FlowStep["accent"],
  { border: string; badge: string; number: string }
> = {
  green: {
    border: "border-green-600",
    badge: "bg-green-50 text-green-800",
    number: "text-green-700",
  },
  navy: {
    border: "border-vb-navy",
    badge: "bg-vb-blue-soft text-vb-navy",
    number: "text-vb-navy",
  },
  blue: {
    border: "border-vb-accent-blue",
    badge: "bg-blue-50 text-blue-800",
    number: "text-blue-700",
  },
  orange: {
    border: "border-orange-700",
    badge: "bg-orange-50 text-orange-800",
    number: "text-orange-800",
  },
};
---

<section class="w-full bg-white px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
  <div class="mx-auto w-full max-w-vb rounded-xl border border-gray-200 bg-gray-50/70 p-5 sm:p-7 lg:p-8">

    <!-- Heading and introduction -->
    <div class="mx-auto max-w-4xl text-center">
      <span class="font-sans text-[11px] font-bold uppercase tracking-[0.18em] text-vb-blue">
        The PPTG Model
      </span>

      <h2 class="mt-2 font-roboto-slab text-2xl font-bold leading-tight text-vb-deep-blue sm:text-3xl lg:text-4xl">
        {title}
      </h2>

      <div class="mt-3 space-y-2 font-sans text-sm leading-6 text-vb-text sm:text-base sm:leading-7">
        {paragraphs.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <!-- Connected process steps -->
    <div class="mt-7 grid grid-cols-1 items-stretch gap-2 sm:mt-9 lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)] lg:gap-3">

      {steps.map((step, index) => (
        <>
          <div class={`flex min-w-0 items-center gap-3 rounded-lg border-l-4 ${accentStyles[step.accent].border} bg-white px-4 py-4 shadow-sm sm:px-5`}>
            <span class={`flex size-8 shrink-0 items-center justify-center rounded-lg font-heading text-sm font-bold ${accentStyles[step.accent].badge}`}>
              {String(index + 1).padStart(2, "0")}
            </span>

            <div class="min-w-0">
              <h3 class="font-heading text-base leading-snug text-vb-navy !sm:text-lg !text-[20px]">
                {step.title}
              </h3>
              <p class="mt-0.5 font-sans !text-[16px] font-bold leading-snug !text-vb-text">
                {step.description}
              </p>
            </div>
          </div>

          {index < steps.length - 1 && (
            <div class="flex items-center justify-center text-vb-navy" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                class="size-5 rotate-90 lg:rotate-0"
              >
                <path
                  d="M4 12h15m-6-6 6 6-6 6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          )}
        </>
      ))}

    </div>
  </div>
</section>
