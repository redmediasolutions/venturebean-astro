
---
type Accent = "green" | "navy" | "violet" | "orange";

interface Props {
  number: string;
  title: string;
  subtitle: string;
  heading: string;
  paragraphs: string[];
  outcomes: string[];
  accent?: Accent;
}

const props = Astro.props as Props;

const {
  number,
  title,
  subtitle,
  heading,
  paragraphs,
  outcomes,
  accent = "navy",
} = props;

const accentStyles: Record<
  Accent,
  {
    badge: string;
    border: string;
    panel: string;
  }
> = {
  green: {
    badge: "bg-green-100 text-green-800",
    border: "border-green-600",
    panel: "bg-green-50/70",
  },
  navy: {
    badge: "bg-vb-blue-soft text-vb-navy",
    border: "border-vb-navy",
    panel: "bg-vb-blue-soft/50",
  },
  violet: {
    badge: "bg-violet-100 text-violet-800",
    border: "border-violet-600",
    panel: "bg-violet-50/70",
  },
  orange: {
    badge: "bg-orange-100 text-orange-800",
    border: "border-orange-600",
    panel: "bg-orange-50/70",
  },
};

const styles = accentStyles[accent];
---

<section class="w-full px-4 py-5 sm:px-6 sm:py-6">
  <article class="mx-auto grid w-full max-w-vb grid-cols-1 items-start gap-4 lg:grid-cols-[minmax(220px,0.32fr)_minmax(0,1fr)] lg:gap-7">

    <!-- LEFT: DIMENSION INTRODUCTION -->
    <div class="min-w-0 lg:sticky lg:top-28">
      <div class="flex items-center gap-2.5">
        <span class={`flex size-8 shrink-0 items-center justify-center rounded-lg font-heading text-xs font-bold ${styles.badge}`}>
          {number}
        </span>

        <span class="font-sans text-[11px] font-bold uppercase tracking-wider text-vb-text">
          PPTG Dimension
        </span>
      </div>

      <h2 class="mt-3 font-heading text-3xl font-bold leading-tight text-vb-navy sm:text-4xl">
        {title}
      </h2>

      <div class={`mt-3 rounded-r-lg border-l-[3px] ${styles.border} ${styles.panel} p-4`}>
        <p class="font-sans text-sm font-medium leading-relaxed text-vb-navy sm:text-base">
          {subtitle}
        </p>
      </div>
    </div>

    <!-- RIGHT: CONTENT CARD -->
    <div class="min-w-0 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

      <div class="p-4 sm:p-5 lg:p-6">
        <div class="flex items-start gap-2.5">
          <span class={`mt-1 h-5 w-1 shrink-0 rounded-full ${styles.border.replace("border-", "bg-")}`}></span>

          <h3 class="font-heading text-lg font-bold leading-snug text-vb-navy sm:text-xl">
            {heading}
          </h3>
        </div>

        <div class="mt-3 space-y-3 font-sans text-sm leading-6 text-vb-text sm:text-base sm:leading-7">
          {paragraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>

      <!-- OUTCOMES -->
      {outcomes.length > 0 && (
        <div class="border-t border-gray-100 bg-gray-50/70 px-4 py-4 sm:px-5">
          <h4 class="mb-3 font-heading text-base font-bold text-vb-navy">
            What this enables
          </h4>

          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-3">
            {outcomes.map((outcome: string) => (
              <div class="flex items-start gap-2.5 rounded-lg border border-gray-200 bg-white p-3">
                <span class={`flex size-6 shrink-0 items-center justify-center rounded-md ${styles.badge}`}>
                  <svg
                    viewBox="0 0 20 20"
                    fill="none"
                    class="size-3.5"
                    aria-hidden="true"
                  >
                    <path
                      d="m4.5 10 3.5 3.5 7.5-7.5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>

                <p class="font-sans text-xs font-medium leading-relaxed text-vb-navy sm:text-sm">
                  {outcome}
                </p>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</section>
