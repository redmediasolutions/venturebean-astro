---
/**
 * Toolkit page (Knowledge Hub → Toolkit): the Frameworks / Assessment tabs.
 */
import FrameworksTab from './FrameworksTab.astro';
import AssessmentsTab from './AssessmentsTab.astro';
---

<div
  class="vb-element vb-element-7e70442 e-con-full e-flex e-con e-parent"
  data-id="7e70442"
  data-element_type="container"
  data-e-type="container"
>
  <div
    class="vb-element vb-element-b940213 e-n-tabs-mobile vb-widget vb-widget-n-tabs"
    data-id="b940213"
    data-element_type="widget"
    data-e-type="widget"
    data-settings={'{"tabs_justify_horizontal":"start","horizontal_scroll":"disable"}'}
    data-widget_type="nested-tabs.default"
  >
    <div class="vb-widget-container">
      <div
        class="e-n-tabs"
        data-widget-number="194249235"
        aria-label="Tabs. Open items with Enter or Space, close with Escape and navigate using the Arrow keys."
      >
        <div class="e-n-tabs-heading" role="tablist">
          <button
            id="e-n-tab-title-1942492351"
            data-tab-title-id="e-n-tab-title-1942492351"
            class="e-n-tab-title"
            aria-selected="true"
            data-tab-index="1"
            role="tab"
            tabindex="0"
            aria-controls="e-n-tab-content-1942492351"
            style="--n-tabs-title-order: 1;"
          >
            <span class="e-n-tab-title-text"> Frameworks </span>
          </button>
          <button
            id="dontshow"
            data-tab-title-id="e-n-tab-title-1942492352"
            class="e-n-tab-title"
            aria-selected="false"
            data-tab-index="2"
            role="tab"
            tabindex="-1"
            aria-controls="e-n-tab-content-1942492352"
            style="--n-tabs-title-order: 2;"
          >
            <span class="e-n-tab-title-text"> Assessment </span>
          </button>
        </div>
        <div class="e-n-tabs-content">
          <FrameworksTab />
          <AssessmentsTab />
        </div>
      </div>
    </div>
  </div>
</div>
