---
/**
 * Toolkit page (Knowledge Hub → Toolkit): hero slider section.
 */
---

<div
  class="vb-element vb-element-f8f6b9f e-flex e-con-boxed e-con e-parent"
  data-id="f8f6b9f"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-a0aacf3 vb--v-position-bottom vb--h-position-center vb-arrows-position-inside vb-widget vb-widget-slides"
      data-id="a0aacf3"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"navigation":"arrows","autoplay_speed":4000,"autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","infinite":"yes","transition":"slide","transition_speed":500}'}
      data-widget_type="slides.default"
    >
      <div class="vb-widget-container">
        <div class="vb-swiper">
          <div
            class="vb-slides-wrapper vb-main-swiper swiper"
            role="region"
            aria-roledescription="carousel"
            aria-label="Slides"
            dir="ltr"
            data-animation="fadeInUp"
          >
            <div class="swiper-wrapper vb-slides">
              <div class="vb-repeater-item-0a583bb swiper-slide" role="group" aria-roledescription="slide">
                <div
                  class="swiper-slide-bg vb-ken-burns vb-ken-burns--in"
                  role="img"
                  aria-label="Gemini_Generated_Image_nr60v2nr60v2nr60"
                >
                </div><div class="vb-background-overlay"></div><div class="swiper-slide-inner">
                  <div class="swiper-slide-contents">
                    <div class="vb-slide-heading">Toolkit</div><div class="vb-slide-description">
                      Your central repository for strategic insights, market analysis, and expert articles on industry
                      trends.
                    </div><a href="/contact-us/" class="vb-button vb-slide-button vb-size-sm">Reach Us</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
