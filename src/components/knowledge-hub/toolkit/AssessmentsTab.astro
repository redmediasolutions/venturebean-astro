
---
/**
 * Toolkit page (Knowledge Hub → Toolkit): Assessment tab.
 * Assessment cards link to existing WordPress pages.
 */

const assessments = [
  {
    title: "SMB Growth Readiness Scorecard",
    href: "/smb-growth-readiness-score/",
    image:
      "/assets/uploads/2026/03/cherrydeck-05gac-Qn0k4-unsplash-scaled-e1773126029963-1300x732.jpg",
    alt: "Business growth readiness assessment",
  },
  {
    title: "How Coachable Am I",
    href: "/how-coachable-am-i/",
    image: "/assets/uploads/2025/10/coaching-1300x731.png",
    alt: "Coaching assessment",
  },
];
---

<section class="w-full" aria-label="Assessments">
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
    {assessments.map((assessment) => (
      <article class="group overflow-hidden rounded-vb-lg border border-gray-200 bg-white shadow-vb-card transition-shadow duration-200 hover:shadow-lg">
        <a href={assessment.href} class="block">
          <div class="aspect-[16/9] w-full overflow-hidden bg-vb-light">
            <img
              loading="lazy"
              decoding="async"
              width="800"
              height="450"
              src={assessment.image}
              alt={assessment.alt}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>

          <div class="p-5 sm:p-6">
            <h2 class="font-heading text-xl font-bold leading-snug text-vb-navy transition-colors group-hover:text-vb-blue sm:text-2xl">
              {assessment.title}
            </h2>
          </div>
        </a>
      </article>
    ))}
  </div>
</section>
