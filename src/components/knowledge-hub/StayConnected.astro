---
/**
 * Knowledge Hub page: “Stay Connected” section.
 * Hidden on every screen size (kept as it was on the WordPress page).
 */
---

<div
  class="vb-element vb-element-8241fcd e-con-full vb-hidden-desktop vb-hidden-tablet vb-hidden-mobile e-flex e-con e-child"
  data-id="8241fcd"
  data-element_type="container"
  data-e-type="container"
>
  <div
    class="vb-element vb-element-785987e e-flex e-con-boxed e-con e-child"
    data-id="785987e"
    data-element_type="container"
    data-e-type="container"
    data-settings={'{"background_background":"classic"}'}
  >
    <div class="e-con-inner">
      <div
        class="vb-element vb-element-3d09fa1 vb-widget vb-widget-heading"
        data-id="3d09fa1"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Stay Connected</h2></div>
      </div>
      <div
        class="vb-element vb-element-06d9ed6 vb-widget vb-widget-text-editor"
        data-id="06d9ed6"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container">
          <p>Email us to receive the latest updates, insights, and exclusive content directly in your inbox</p>
        </div>
      </div>
      <div
        class="vb-element vb-element-d600260 vb-widget vb-widget-button"
        data-id="d600260"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="button.default"
      >
        <div class="vb-widget-container">
          <div class="vb-button-wrapper">
            <a class="vb-button vb-button-link vb-size-sm" href="#">
              <span class="vb-button-content-wrapper"> <span class="vb-button-text">Stay Connected</span> </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
