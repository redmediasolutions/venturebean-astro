
---
/**
 * Knowledge Hub: Media Spotlight section.
 */

import VBButton from "../global/VBButton.astro";

const sections = [
  {
    title: "Media Spotlight",
    description:
      "VentureBean’s ideas shared through press features, keynote talks, panels, and recorded conversations—reflecting our contribution.",
    image: "/assets/uploads/2026/01/reportss-scaled.jpg",
    alt: "VentureBean media features and reports",
    href: "/knowledge-hub/media-spotlight/",
    button: "View Media Coverage",
  },
  {
    title: "Industry Perspectives",
    description:
      "Research-driven viewpoints on shifts in industries, leadership, and business models to help leaders make informed decisions.",
    image: "/assets/uploads/2026/01/buildings-scaled.jpg",
    alt: "Modern city buildings",
    href: "/knowledge-hub/industry-perspectives/",
    button: "Explore Perspectives",
  },
  {
    title: "Toolkit",
    description:
      "Practical frameworks and assessments that help leaders diagnose challenges, structure thinking, and plan clear next steps.",
    image:
      "/assets/uploads/2025/09/smiling-business-lady-working-with-colleagues-scaled.jpg",
    alt: "Business professionals collaborating",
    href: "/knowledge-hub/toolkit/",
    button: "Access the Toolkit",
  },
  {
    title: "Insights",
    description:
      "Perspectives from VentureBean's advisory and coaching work, focused on practical leadership and execution lessons.",
    image:
      "/assets/uploads/2025/09/boss-with-his-new-workers-modern-office-speaking-about-presentation-with-laptop-scaled.jpg",
    alt: "Business leader discussing a presentation",
    href: "/knowledge-hub/insights/",
    button: "Read Insights",
  },
];
---

<section
  class="w-full bg-vb-light px-10 py-16 sm:px-8 lg:py-2"
  aria-label="Explore the Knowledge Hub"
>
  <div class="mx-auto w-full max-w-vb">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {sections.map((section, index) => (
        <article
          class="group flex min-w-0 flex-col overflow-hidden rounded-vb bg-white shadow-vb-card transition-shadow duration-300 hover:shadow-lg"
        >
          <a
            href={section.href}
            class="block aspect-[5/3] w-full overflow-hidden bg-vb-blue-soft"
            aria-label={`Explore ${section.title}`}
            tabindex={index === 0 ? -1 : undefined}
          >
            <img
              src={section.image}
              alt={section.alt}
              width="800"
              height="480"
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </a>

          <div class="flex flex-1 flex-col items-start p-4">
            <h2 class="font-heading text-xl font-bold leading-tight">
              <a href={section.href} class="transition-colors hover:text-vb-blue !no-underline !text-vb-navy !text-[24px]">
                {section.title}
              </a>
            </h2>

            <p class="mt-2 flex-1 font-sans text-sm leading-relaxed text-vb-text">
              {section.description}
            </p>

            <div class="mt-4">
              <VBButton
                href={section.href}
                label={section.button}
                size="sm"
                arrow
              />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
