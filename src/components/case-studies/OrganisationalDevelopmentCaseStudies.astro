
---
const caseStudies = [
  {
    name: "Titan",
    coverage: "Change Management Program for Senior Leadership",
    location: "Bangalore",
  },
  {
    name: "SKF",
    coverage: "Leadership Foundation Program for Mid-Management; Leadership Development Program for Senior Management",
    location: "Bangalore, Pune",
  },
  {
    name: "Wells Fargo",
    coverage: "‘Accelerate’ program for hi-potential key performers",
    location: "Bangalore, Hyderabad",
  },
  {
    name: "Thales",
    coverage: "Leadership Program, mid-management",
    location: "Bangalore, NCR",
  },
  {
    name: "CitiusTech",
    coverage: "Leadership Development - Change, Conflict Management, Collaboration",
    location: "Mumbai",
  },
  {
    name: "GMR - across multiple businesses – Airports, Energy, Water, Infrastructure",
    coverage: "Programs for mid-to-senior management",
    location: "Bangalore, Hyderabad, NCR",
  },
  {
    name: "JSW",
    coverage: "Mid-management leadership development programs",
    location: "Karnataka (multiple locations), Mumbai",
  },
  {
    name: "Sandur Group",
    coverage: "Leadership Foundation Program for Mid-Management; Leadership Development Program for Top Management",
    location: "Bangalore, Sandur",
  },
  {
    name: "Noratel India",
    coverage: "‘Breakthrough ’26’ Leadership Program for Functional Heads",
    location: "Bangalore",
  },
] as const;

const pageTitle = "Organisational Development";

const pageDescription =
  "Explore our organisational development work and leadership development programs delivered for organisations across different industries.";
---

<section class="bg-vb-light py-16 md:py-24">
  <div class="mx-auto w-full max-w-[1600px] px-6 lg:px-8">
    <div class="mb-12 max-w-3xl">
      <a
        href="/case-studies/"
        class="mb-6 inline-flex items-center gap-2 text-sm font-semibold text-vb-blue transition-colors hover:text-vb-navy"
      >
        <span aria-hidden="true">←</span>
        Back to Case Studies
      </a>

      <h1 class="font-heading text-4xl font-bold tracking-tight text-vb-navy md:text-5xl">
        {pageTitle}
      </h1>

      <p class="mt-5 text-lg leading-relaxed text-vb-text">
        {pageDescription}
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {caseStudies.map((study, index) => {
        const hasCoverage = Boolean(study.coverage?.trim());
        const hasLocation = Boolean(study.location?.trim());

        return (
          <article
            class="flex h-full flex-col rounded-vb-lg border border-slate-200 bg-white p-7 shadow-vb-card transition-all duration-300 hover:-translate-y-1"
          >
            <div class="mb-6 flex items-center justify-between">
              <span class="font-heading text-4xl font-bold text-vb-blue/20">
                {String(index + 1).padStart(2, "0")}
              </span>

              <span class="rounded-full bg-vb-blue-soft px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-vb-blue">
                Organisational Development
              </span>
            </div>

            <h2 class="font-heading !text-[18px] font-bold text-vb-navy">
              {study.name}
            </h2>

            {(hasCoverage || hasLocation) && (
              <div class="mt-6 space-y-5">
                {hasCoverage && (
                  <div>
                    <h3 class="font-heading !text-sm !font-bold uppercase tracking-wide text-vb-navy">
                      Coverage
                    </h3>
                    <p class="mt-2 text-base leading-relaxed text-vb-text">
                      {study.coverage}
                    </p>
                  </div>
                )}

                {hasLocation && (
                  <div>
                    <h3 class="font-heading !text-sm !font-bold uppercase tracking-wide text-vb-navy">
                      Location
                    </h3>
                    <p class="mt-2 text-base text-vb-text">
                      {study.location}
                    </p>
                  </div>
                )}
              </div>
            )}
          </article>
        );
      })}
    </div>

    <div class="mt-12">
      <a
        href="/case-studies/"
        class="inline-flex items-center gap-2 rounded-vb bg-vb-navy px-6 py-3 font-semibold text-white transition-colors hover:bg-vb-blue"
      >
        <span aria-hidden="true">←</span>
        Back to All Case Studies
      </a>
    </div>
  </div>
</section>
