---

<section class="bg-vb-light py-16 md:py-24">
  <div class="mx-auto w-full max-w-[1600px] px-6 lg:px-8">
    <div class="mb-12 max-w-3xl">
      <a
        href="/case-studies/"
        class="mb-6 inline-flex items-center gap-2 text-sm font-semibold text-vb-blue transition-colors hover:text-vb-navy"
      >
        <span aria-hidden="true">←</span>
        Back to Case Studies
      </a>

      <span class="mb-3 block font-sans text-xs font-bold uppercase tracking-[3px] text-vb-blue">
        Coaching Journeys that Transformed Leaders
      </span>

      <h1 class="font-heading text-4xl font-bold tracking-tight text-vb-navy md:text-5xl">
        Business, Executive and Leadership Coaching
      </h1>

      <p class="mt-5 text-lg leading-relaxed text-vb-text">
        Explore how our tailored coaching engagements have helped leaders and professionals navigate complex
        challenges, strengthen performance and achieve meaningful growth.
      </p>
    </div>

    <div data-cs-tabs>
      <div role="tablist" aria-label="Coaching case studies" class="mb-10 flex flex-wrap gap-3">
        {tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`cs-tab-${tab.id}`}
            aria-controls={`cs-panel-${tab.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-cs-tab
            class="cs-tab"
          >
            {tab.label}
          </button>
        ))}
      </div>

      {tabs.map((tab, i) => (
        <div
          role="tabpanel"
          id={`cs-panel-${tab.id}`}
          aria-labelledby={`cs-tab-${tab.id}`}
          data-cs-panel
          hidden={i !== 0}
        >
          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {tab.items.map((study, index) => (
              <article class="flex h-full flex-col rounded-vb-lg border border-slate-200 bg-white p-7 shadow-vb-card transition-all duration-300 hover:-translate-y-1">
                <div class="mb-6 flex items-center justify-between gap-4">
                  <span class="font-heading text-4xl font-bold text-vb-blue/20">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="rounded-full bg-vb-blue-soft px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-vb-blue">
                    {study.period}
                  </span>
                </div>

                <h2 class="font-heading !text-[18px] font-bold text-vb-navy">{study.name}</h2>

                <dl class="mt-6 space-y-5">
                  <div>
                    <dt class="font-heading text-sm font-bold uppercase tracking-wide text-vb-navy">Coverage</dt>
                    <dd class="mt-2 text-base leading-relaxed text-vb-text">{study.coverage}</dd>
                  </div>
                  <div>
                    <dt class="font-heading text-sm font-bold uppercase tracking-wide text-vb-navy">Objective</dt>
                    <dd class="mt-2 text-base leading-relaxed text-vb-text">{study.objective}</dd>
                  </div>
                </dl>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12">
      <a
        href="/case-studies/"
        class="inline-flex items-center gap-2 rounded-vb bg-vb-navy px-6 py-3 font-semibold !text-white transition-colors hover:bg-vb-blue"
      >
        <span aria-hidden="true">←</span>
        Back to All Case Studies
      </a>
    </div>
  </div>
</section>

<style>
  /* Higher specificity than the legacy theme reset (hello-vb/reset.css), which styles all buttons. */
  [data-cs-tabs] [role="tablist"] .cs-tab {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    border: 2px solid var(--color-vb-navy);
    border-radius: 9999px;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    white-space: normal;
    background-color: #fff;
    color: var(--color-vb-navy);
    transition: background-color 0.2s, color 0.2s;
  }

  [data-cs-tabs] [role="tablist"] .cs-tab:hover,
  [data-cs-tabs] [role="tablist"] .cs-tab:focus,
  [data-cs-tabs] [role="tablist"] .cs-tab[aria-selected="true"] {
    background-color: var(--color-vb-navy);
    border-color: var(--color-vb-navy);
    color: #fff;
  }

  [data-cs-tabs] [role="tablist"] .cs-tab:focus-visible {
    outline: 2px solid var(--color-vb-blue);
    outline-offset: 3px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-cs-tabs]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-cs-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-cs-panel]"));

    const activate = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i].hidden = !selected;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activate(i));
      tab.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") activate((i + 1) % tabs.length, true);
        else if (e.key === "ArrowLeft") activate((i - 1 + tabs.length) % tabs.length, true);
        else return;
        e.preventDefault();
      });
    });
  });
</script>
