---
/**
 * Case Studies page: “Consulting” section.
 */
---

<div
  class="vb-element vb-element-eaf2439 e-flex e-con-boxed e-con e-parent"
  data-id="eaf2439"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-75e4985 e-con-full e-flex e-con e-child"
      data-id="75e4985"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"background_background":"classic"}'}
    >
      <div
        class="vb-element vb-element-618d319 vb-widget vb-widget-image"
        data-id="618d319"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="image.default"
      >
        <div class="vb-widget-container">
          <a href="/consulting-case-studies/">
            <img
              fetchpriority="high"
              decoding="async"
              width="800"
              height="672"
              src="/assets/uploads/2024/07/vb2.jpg"
              class="attachment-large size-large site-image-16252"
              alt=""
              srcset="/assets/uploads/2024/07/vb2.jpg 802w, /assets/uploads/2024/07/vb2-357x300.jpg 357w, /assets/uploads/2024/07/vb2-768x645.jpg 768w"
              sizes="(max-width: 800px) 100vw, 800px"
            />
          </a>
        </div>
      </div>
      <div
        class="vb-element vb-element-4d09d65 vb-widget vb-widget-heading"
        data-id="4d09d65"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Consulting</h2></div>
      </div>
    </div>
    <div
      class="vb-element vb-element-817dc2e e-con-full e-flex e-con e-child"
      data-id="817dc2e"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"background_background":"classic"}'}
    >
      <div
        class="vb-element vb-element-263da18 vb-widget vb-widget-image"
        data-id="263da18"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="image.default"
      >
        <div class="vb-widget-container">
          <a href="/coaching-case-studies/">
            <img
              decoding="async"
              width="800"
              height="672"
              src="/assets/uploads/2024/07/vb3.jpg"
              class="attachment-large size-large site-image-16253"
              alt=""
              srcset="/assets/uploads/2024/07/vb3.jpg 802w, /assets/uploads/2024/07/vb3-357x300.jpg 357w, /assets/uploads/2024/07/vb3-768x645.jpg 768w"
              sizes="(max-width: 800px) 100vw, 800px"
            />
          </a>
        </div>
      </div>
      <div
        class="vb-element vb-element-4b736c5 vb-widget vb-widget-heading"
        data-id="4b736c5"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Coaching</h2></div>
      </div>
    </div>
  </div>
</div>
