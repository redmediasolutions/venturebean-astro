
---
/**
 * Case Studies – Consulting, Coaching and Organisational Development.
 * Built with Astro + Tailwind CSS v4.
 */

const caseStudies = [
  {
    title: 'Consulting',
    href: 'consulting/',
    image: '/assets/uploads/2024/07/vb2.jpg',
    alt: 'Consulting case studies',
    number: '01',
  },
  {
    title: 'Coaching',
    href: 'coaching/',
    image: '/assets/uploads/2024/07/vb3.jpg',
    alt: 'Coaching case studies',
    number: '02',
  },
  {
    title: 'Organisational Development',
    href: 'organisational-development/',
    image: 'https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1794446894766-organisational-developement-programs.webp',
    alt: 'Organisational development',
    number: '03',
  },
];
---

<section class="w-full bg-vb-light py-16 sm:py-20 lg:py-24">
  <div class="mx-auto w-full max-w-[1600px] px-6 sm:px-8 lg:px-10">

    <!-- Section Intro -->
    <div class="mx-auto mb-12 max-w-2xl text-center lg:mb-16">
      <span class="mb-4 inline-flex items-center gap-3 font-sans text-xs font-bold uppercase tracking-[3px] text-vb-blue">
        <span class="h-[2px] w-8 bg-vb-blue"></span>
        Explore Our Work
        <span class="h-[2px] w-8 bg-vb-blue"></span>
      </span>

      <h2 class="font-heading text-4xl font-bold leading-tight tracking-tight text-vb-navy sm:text-5xl">
        Our Areas of Expertise
      </h2>

      <p class="mt-5 font-sans text-base leading-relaxed text-vb-text sm:text-lg">
        Discover how VentureBean partners with organisations to create meaningful
        change through consulting, coaching and organisational development.
      </p>
    </div>

    <!-- Three Column Grid -->
    <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {caseStudies.map((item) => (
        <a
          href={item.href}
          aria-label={`Explore ${item.title} case studies`}
          class="group relative isolate flex min-h-[420px] flex-col !text-white text-semibold justify-end overflow-hidden rounded-2xl bg-vb-navy shadow-vb-card transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vb-blue"
        >
          <!-- Background Image -->
          <img
            src={item.image}
            alt={item.alt}
            width="800"
            height="672"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
          />

          <!-- Image Overlay -->
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#08082F]/95 via-[#101044]/45 to-[#101044]/5 transition-all duration-500 group-hover:from-[#08082F]/95 group-hover:via-[#101044]/60"></div>

          <!-- Card Content -->
          <div class="relative p-7 sm:p-8 lg:p-9">

            <!-- Number -->
            <span class="mb-5 inline-flex h-9 min-w-9 items-center justify-center rounded-full border border-white/40 px-3 font-sans text-xs font-semibold tracking-wider text-white">
              {item.number}
            </span>

            <!-- Title and Arrow -->
            <div class="flex items-end justify-between gap-4">
              <h3 class="max-w-[280px] font-heading text-3xl font-bold leading-tight text-white sm:text-4xl">
                {item.title}
              </h3>

              <span
                aria-hidden="true"
                class="mb-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/50 text-xl text-white transition-all duration-300 group-hover:border-white group-hover:bg-white group-hover:text-vb-navy group-hover:translate-x-1"
              >
                →
              </span>
            </div>

            <!-- Accent -->
            <div class="mt-6 h-[3px] w-12 bg-vb-blue-light transition-all duration-500 group-hover:w-20"></div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
