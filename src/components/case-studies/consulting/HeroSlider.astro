---
/**
 * Consulting Case Studies page: hero slider section.
 */
---

<div
  class="vb-element vb-element-99ca61c e-con-full e-flex e-con e-parent"
  data-id="99ca61c"
  data-element_type="container"
  data-e-type="container"
>
  <div
    class="vb-element vb-element-8d66949 e-con-full e-flex e-con e-child"
    data-id="8d66949"
    data-element_type="container"
    data-e-type="container"
  >
    <div
      class="vb-element vb-element-d6fc984 vb--v-position-bottom vb--h-position-center vb-arrows-position-inside vb-pagination-position-inside vb-widget vb-widget-slides"
      data-id="d6fc984"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"navigation":"both","autoplay":"yes","pause_on_hover":"yes","pause_on_interaction":"yes","autoplay_speed":5000,"infinite":"yes","transition":"slide","transition_speed":500}'}
      data-widget_type="slides.default"
    >
      <div class="vb-widget-container">
        <div class="vb-swiper">
          <div
            class="vb-slides-wrapper vb-main-swiper swiper"
            role="region"
            aria-roledescription="carousel"
            aria-label="Slides"
            dir="ltr"
            data-animation="fadeInUp"
          >
            <div class="swiper-wrapper vb-slides">
              <div class="vb-repeater-item-0a583bb swiper-slide" role="group" aria-roledescription="slide">
                <div
                  class="swiper-slide-bg vb-ken-burns vb-ken-burns--in"
                  role="img"
                  aria-label="Business Consulting Meeting | VentureBean"
                >
                </div><div class="vb-background-overlay"></div><div class="swiper-slide-inner">
                  <div class="swiper-slide-contents">
                    <div class="vb-slide-heading">Case Studies - Consulting</div><div class="vb-slide-description">
                      Success Stories that Speak for themselves
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
