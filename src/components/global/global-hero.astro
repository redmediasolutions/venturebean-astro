
---
/**
 * VentureBean – Premium Service Hero
 * Astro + Tailwind CSS v4
 */

import VBButton from "./VBButton.astro";

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  image: string;
  imageAlt?: string;
  buttonText?: string;
  buttonHref?: string;
  showButton?: boolean;
}

const {
  title,
  subtitle = "VentureBean",
  description,
  image,
  imageAlt,
  buttonText = "Book a Discovery Call",
  buttonHref = "/contact-us/",
  showButton = true,
} = Astro.props;
---

<section
  class="group relative isolate flex min-h-[540px] w-full items-center overflow-hidden bg-vb-navy sm:min-h-[580px] lg:min-h-[250px]"
  aria-label={title}
>
  <!-- Background Image -->
  <div
    class="absolute inset-0 -z-30 bg-cover bg-center bg-no-repeat transition-transform duration-[1500ms] ease-out group-hover:scale-[1.025]"
    style={`background-image: url("${image}")`}
    role="img"
    aria-label={imageAlt || title}
  ></div>

  <!-- Main Overlay -->
  <div
    class="absolute inset-0 -z-20 bg-gradient-to-r from-vb-navy/95 via-vb-navy/80 to-vb-navy/35"
  ></div>

  <!-- Bottom Image Overlay -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-vb-navy/45 via-transparent to-vb-navy/15"
  ></div>

  <!-- Hero Content -->
  <div class="mx-auto w-full max-w-vb px-6 py-24 sm:px-8 md:py-28 lg:px-10 lg:py-24">
    <div class="w-full max-w-[850px]">

      <!-- Eyebrow -->
      <div class="mb-7 flex items-center gap-4">
        <span class="h-[2px] w-11 bg-vb-blue-light"></span>

        <span class="text-[11px] font-bold uppercase tracking-[3px] text-vb-blue-soft">
          {subtitle}
        </span>
      </div>

      <!-- Heading -->
      <h1 class="w-full max-w-[820px] font-heading text-4xl font-bold leading-[1.13] tracking-[-1.2px] !text-white sm:text-5xl md:text-[56px] lg:text-[62px]">
        {title}
      </h1>

      <!-- Description -->
      {description && (
        <p class="mt-7 w-full max-w-[660px] text-[15px] leading-[1.9] text-white/90 sm:text-base md:text-lg md:leading-[1.85]">
          {description}
        </p>
      )}

      <!-- CTA -->
      {showButton && (
        <div class="mt-10 md:mt-12">
          <VBButton
            href={buttonHref}
            label={buttonText}
            invert
            size="lg"
          />
        </div>
      )}

    </div>
  </div>

  <!-- Bottom Accent -->
  <div class="absolute bottom-0 left-0 h-[4px] w-28 bg-vb-blue md:w-36"></div>
</section>
