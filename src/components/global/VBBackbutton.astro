
---
type ButtonVariant = "light" | "dark";
type ButtonSize = "sm" | "md" | "lg";

interface Props {
  href: string;
  label?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  class?: string;
}

const props = Astro.props as Props;

const {
  href,
  label = "Back",
  variant = "light",
  size = "md",
  class: className = "",
} = props;

const sizeClasses: Record<ButtonSize, string> = {
  sm: "gap-2 px-3 py-1.5 text-xs",
  md: "gap-2.5 px-4 py-2.5 text-sm",
  lg: "gap-3 px-5 py-3 text-base",
};

const iconSizes: Record<ButtonSize, string> = {
  sm: "h-6 w-6",
  md: "h-7 w-7",
  lg: "h-9 w-9",
};

const iconColors: Record<ButtonVariant, string> = {
  light: "bg-vb-blue-soft text-vb-navy group-hover:bg-white/15 group-hover:text-white",
  dark: "bg-white/10 text-white group-hover:bg-white group-hover:text-vb-navy",
};

const variantClasses: Record<ButtonVariant, string> = {
  light: "bg-white !text-vb-navy border border-vb-blue-soft hover:bg-vb-navy hover:text-white hover:border-vb-navy",
  dark: "bg-vb-navy !text-white border border-white/20 hover:bg-vb-blue hover:border-vb-blue",
};
---

<a
  href={href}
  class:list={[
    "group inline-flex w-fit items-center rounded-full font-sans font-semibold !no-underline",
    "transition-all duration-300 ease-out",
    "hover:-translate-x-0.5 hover:shadow-md",
    "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vb-blue",
    sizeClasses[size],
    variantClasses[variant],
    className,
  ]}
>
  <!-- Circular Arrow -->
  <span
    class:list={[
      "flex shrink-0 items-center justify-center rounded-full transition-all duration-300",
      iconSizes[size],
      iconColors[variant],
    ]}
  >
    <svg
      class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-0.5"
      viewBox="0 0 20 20"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M15.5 10H4.5M4.5 10L9.5 5M4.5 10L9.5 15"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>

  <span class="pr-1">{label}</span>
</a>
