
---
interface Props {
  items: string[];
  heading?: string;
}

const {
  items,
  heading = "Best Suited When",
} = Astro.props;
---

<section class="w-full bg-[#EEEEEE] py-8 md:py-10 lg:py-8">
  <div class="mx-auto w-full max-w-vb px-6 sm:px-8 lg:px-12">

    <!-- Heading -->
    <div class="mb-5 flex items-center gap-3">
      <span class="h-[2px] w-8 bg-vb-blue"></span>
      <h2 class="font-heading !text-2xl leading-tight text-vb-navy md:text-3xl">
        {heading}
      </h2>
    </div>

    <!-- Compact Horizontal Items -->
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {items.map((item: string, index: number) => (
        <article class="group flex min-w-0 items-start gap-3 rounded-vb-lg border border-vb-blue-soft/70 bg-white px-4 py-4 transition-all duration-300 hover:-translate-y-1 hover:border-vb-blue/40 hover:shadow-vb-card">

          <!-- Number -->
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-vb-blue-soft font-sans !text-xs font-bold text-vb-navy transition-colors duration-300 group-hover:bg-vb-blue group-hover:text-white">
            {String(index + 1).padStart(2, "0")}
          </span>

          <!-- Text -->
          <p class="font-sans !text-[16px] font-semibold leading-relaxed text-vb-navy">
            {item}
          </p>

        </article>
      ))}
    </div>

  </div>
</section>
