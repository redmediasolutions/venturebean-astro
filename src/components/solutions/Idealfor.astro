
---
interface IdealForItem {
  title: string;
}

interface Props {
  idealFor: IdealForItem[];
  bestSuited?: string;
  image?: string;
  imageAlt?: string;
  idealHeading?: string;
  bestSuitedHeading?: string;
}

const {
  idealFor,
  bestSuited = "",
  image = "https://redmediaassets.s3.ap-south-1.amazonaws.com/venturebean/media/2026/11/1794975415794-smart-growth.webp",
  imageAlt = "Business growth and development",
  idealHeading = "Ideal for",
  bestSuitedHeading = "Best Suited When",
} = Astro.props;

const showBestSuited = Boolean(bestSuited?.trim());
---

<section class="relative w-full overflow-hidden bg-[#EEEEEE] pb-14 pt-10 md:pb-16 md:pt-12 lg:pb-16 lg:pt-14">
  <div class="mx-auto w-full max-w-vb px-6 sm:px-8 lg:px-12">

    <div
      class:list={[
        "grid grid-cols-1 items-stretch gap-5 lg:gap-7",
        showBestSuited
          ? "lg:grid-cols-[minmax(0,2.35fr)_minmax(0,1fr)]"
          : "lg:grid-cols-1",
      ]}
    >

      <!-- Ideal For -->
      <div class="flex min-w-0 flex-col">
        <h2 class="mb-4 font-heading !text-[24px] !font-bold leading-tight text-vb-navy md:text-3xl">
          {idealHeading}
        </h2>

        
        <div
  class:list={[
    "grid flex-1 gap-3",
    showBestSuited
      ? "grid-cols-1 sm:grid-cols-2"
      : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
  ]}
>
          {idealFor.map((item: IdealForItem, index: number) => (
            <article class="group flex min-h-[115px] min-w-0 flex-col justify-center gap-3 rounded-vb-lg bg-white px-5 py-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-vb-card">

              <!-- Numbered Accent -->
              <div class="flex items-center gap-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-vb-blue-soft font-sans text-xs font-bold text-vb-blue transition-colors duration-300 group-hover:bg-vb-blue group-hover:text-white">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="h-px w-8 bg-vb-blue/30 transition-all duration-300 group-hover:w-12 group-hover:bg-vb-blue"></span>
              </div>

              <h3 class="font-sans text-base font-bold leading-snug text-[#333333] !text-[16px] md:text-lg">
                {item.title}
              </h3>
            </article>
          ))}
        </div>
      </div>

      <!-- Best Suited -->
      {showBestSuited && (
        <article class="flex min-w-0 flex-col overflow-hidden rounded-vb-lg bg-white">
          <div class="h-33 w-full shrink-0 overflow-hidden sm:h-48 lg:h-[110px]">
            <img
              src={image}
              alt={imageAlt}
              class="block h-full w-full object-cover"
              loading="lazy"
            />
          </div>

          <div class="flex flex-1 flex-col px-5 py-5 sm:px-6 sm:py-6">
            <h2 class="font-heading !text-[20px] !font-semibold leading-tight text-vb-navy md:text-2xl">
              {bestSuitedHeading}
            </h2>

            <p class="mt-3 font-sans text-sm leading-relaxed text-vb-navy md:text-base">
              {bestSuited}
            </p>
          </div>
        </article>
      )}

    </div>
  </div>
</section>
