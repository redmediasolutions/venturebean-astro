
---
interface OutcomeItem {
  description: string;
  icon: "direction" | "structure" | "growth";
}

interface Props {
  outcomes: OutcomeItem[];
  heading?: string;
  description?: string;
  backgroundImage?: string;
}

const {
  outcomes,
  heading = "Outcome",
  description = "Build your business on a strong foundation designed for sustainable growth.",
  backgroundImage,
} = Astro.props;
---

<section class="relative isolate w-full overflow-hidden bg-gradient-to-r from-vb-deep-blue via-[#352447] to-[#733F2C] py-8 md:py-10 lg:py-12">

  {backgroundImage && (
    <div class="absolute inset-0 -z-20">
      <img
        src={backgroundImage}
        alt=""
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>
  )}

  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-vb-deep-blue/95 via-[#352447]/90 to-[#733F2C]/90"></div>

  <div class="mx-auto w-full max-w-vb px-6 sm:px-8 lg:px-12">

    <!-- Heading -->
    <div class="mb-5 max-w-3xl">
      <span class="mb-2 block h-1 w-8 rounded-full bg-vb-blue-light"></span>

      <h2 class="font-heading text-2xl font-bold leading-tight !text-white md:text-3xl lg:text-4xl">
        {heading}
      </h2>

      <p class="mt-1.5 font-sans text-sm font-medium leading-relaxed text-white/85 md:text-base">
        {description}
      </p>
    </div>

    <!-- Outcome Cards -->
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3 lg:gap-4">
      {outcomes.map((outcome: OutcomeItem, index: number) => (
        <article class="group relative flex min-h-[135px] flex-col justify-between overflow-hidden rounded-vb-lg border border-white/40 bg-white px-4 py-4 shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl sm:px-5">

          <!-- Top accent -->
          <div class="absolute left-0 top-0 h-1 w-full bg-gradient-to-r from-vb-blue to-vb-blue-light"></div>

          <div class="flex items-center justify-between">
            <!-- Icon -->
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-vb-blue-soft text-vb-deep-blue transition-colors duration-300 group-hover:bg-vb-blue group-hover:text-white">
              <svg
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="h-7 w-7"
                aria-hidden="true"
              >
                {outcome.icon === "direction" && (
                  <>
                    <path d="M5 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" fill="currentColor"/>
                    <path d="M3 20h8l5 7 7 2v-8h-5l-5-6H5a5 5 0 0 0-5 5v22h7V29l5 6v7h7V32l-8-9-3-4" fill="currentColor"/>
                    <path d="M25 5h5v38h-5zM34 5h5v38h-5zM43 5h3v38h-3z" fill="currentColor"/>
                  </>
                )}

                {outcome.icon === "structure" && (
                  <>
                    <path d="M9 43V12M9 12 2 19M9 12l7 7" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M22 13h8M22 23h13M22 33h18M22 43h23" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
                  </>
                )}

                {outcome.icon === "growth" && (
                  <>
                    <path d="M5 18h7v25H5z" fill="currentColor"/>
                    <path d="M20 18c0-2 2-4 4-4s4 2 4 4v2h7c4 0 7 3 7 7v16H18V25c0-4 2-7 5-7h-3Z" fill="currentColor"/>
                    <path d="M28 5a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z" fill="currentColor"/>
                  </>
                )}
              </svg>
            </div>

            <span class="font-heading text-2xl font-bold text-vb-blue-soft transition-colors duration-300 group-hover:text-vb-blue/30">
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>

          <p class="mt-4 font-sans text-sm font-medium leading-relaxed text-vb-navy md:text-base">
            {outcome.description}
          </p>

        </article>
      ))}
    </div>

  </div>
</section>
