
---
import VBButton from "../global/VBButton.astro";
import VBBackButton from "../global/VBBackbutton.astro";


interface Props {
  heading?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  backLabel?: string;
  backHref?: string;
}

const {
  heading = "Ready to Strengthen Your Organisation?",
  description = "Let's start with a simple, strategic conversation to understand what your business needs.",
  ctaLabel = "Book a Discovery Call",
  ctaHref = "/contact/",
  backLabel = "Back to Solutions",
  backHref = "/solutions/",
} = Astro.props;
---

<section class="w-full bg-white py-9 md:py-11 lg:py-12">
  <div class="mx-auto w-full max-w-vb px-6 sm:px-8 lg:px-12">

    <!-- Main CTA -->
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="font-heading text-3xl font-bold leading-tight text-vb-navy sm:text-4xl md:text-5xl">
        {heading}
      </h2>

      <p class="mx-auto mt-3 max-w-3xl font-sans text-base leading-relaxed text-vb-text md:text-lg">
        {description}
      </p>

      <div class="mt-6">
        <VBButton
          href={ctaHref}
          label={ctaLabel}
          size="lg"
        />
      </div>
    </div>

    <!-- Back to Solutions -->
    <div class="mt-8 flex justify-start">
 <VBBackButton
  href="/solutions/"
  label="Back to Solutions"
  variant="light"
/>
    </div>

   

  </div>
</section>
