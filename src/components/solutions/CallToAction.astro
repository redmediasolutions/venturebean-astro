---
/**
 * Solutions page: “Ready to Scale with Clarity and Structure?” section.
 */
---

<div
  class="vb-element vb-element-ded8f15 e-flex e-con-boxed e-con e-parent"
  data-id="ded8f15"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-4894cca vb-widget vb-widget-heading"
      data-id="4894cca"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="heading.default"
    >
      <div class="vb-widget-container">
        <h2 class="vb-heading-title vb-size-default">Ready to Scale with Clarity and Structure?</h2>
      </div>
    </div>
    <div
      class="vb-element vb-element-66e50fe vb-widget vb-widget-text-editor"
      data-id="66e50fe"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="text-editor.default"
    >
      <div class="vb-widget-container">
        Partner with VentureBean to strengthen leadership, improve operational efficiency, scale sustainably, and build
        a future-ready organisation.
      </div>
    </div>
    <div
      class="vb-element vb-element-7bce6bb vb-align-left vb-widget vb-widget-button"
      data-id="7bce6bb"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="button.default"
    >
      <div class="vb-widget-container">
        <div class="vb-button-wrapper">
          <a class="vb-button vb-button-link vb-size-sm" href="/contact-us/">
            <span class="vb-button-content-wrapper">
              <span class="vb-button-text">Book a Discovery Discussion</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
