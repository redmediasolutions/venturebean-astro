
---
/**
 * VentureBean – Business Challenges
 * Self-contained Astro component
 */

const challenges = [
  {
    title: "Founder dependency and leadership overload",
    icon: "signal",
  },
  {
    title: "Organisational inefficiencies affecting growth and profitability",
    icon: "calendar",
  },
  {
    title: "Weak operational systems, accountability, governance frameworks",
    icon: "briefcase",
  },
  {
    title: "Leadership capability or succession planning, team collaboration",
    icon: "leadership",
  },
  {
    title: "GCC setup, operational scaling and sustenance",
    icon: "globe",
  },
];

const icons: Record<string, string> = {
  signal: "M4 20V10m5 10V4m5 16v-7m5 7V7",
  calendar:
    "M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z",
  briefcase:
    "M3 7h18v14H3zM8 7V4h8v3M3 12h18m-11 0v2h4v-2",
  leadership:
    "M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m6-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7-4h5m-2.5-2.5v5",
  globe:
    "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Zm0-20c2.5 2.7 3.7 6 3.7 10s-1.2 7.3-3.7 10c-2.5-2.7-3.7-6-3.7-10S9.5 4.7 12 2Zm-9 10h18",
};
---

<section class="w-full bg-vb-navy py-16 text-white md:py-20 lg:py-10">
  <div
    class="mx-auto grid w-full max-w-vb grid-cols-1 items-center gap-12 px-6 sm:px-8 lg:grid-cols-2 lg:gap-16 lg:px-10"
  >
    <!-- Left: Introduction -->
    <div>
      <h2
        class="max-w-2xl font-heading text-4xl font-bold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-5xl xl:text-[56px]"
      >
        Business Challenges
        <span class="block">our Solutions Solve</span>
      </h2>

      <p class="mt-6 max-w-2xl font-sans text-base leading-relaxed text-vb-footer-text md:text-lg">
        Every structured, customised engagement is practical,
        execution-focused and outcome-driven.
      </p>

      <p class="mt-4 max-w-2xl font-sans text-base leading-relaxed text-vb-footer-text md:text-lg">
        We are flexible – either the whole solution could be opted for to
        get optimal, comprehensive results, else, specific modules with
        function-focus could be chosen. Each assignment is customised to
        maximise relevant impact.
      </p>
    </div>

    <!-- Right: Business Challenges -->
    <div class="flex flex-col gap-4">
      {challenges.map((challenge) => (
        <article
          class="flex min-h-[40px] items-center gap-5 bg-vb-footer-surface px-5 py-5 transition-colors duration-300 hover:bg-vb-blue/50 sm:px-6"
        >
          <span class="flex size-6 shrink-0 items-center justify-center text-vb-blue-soft">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="23"
              height="23"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icons[challenge.icon]} />
            </svg>
          </span>

          <p class="font-sans text-sm font-medium leading-[22px] text-vb-footer-muted sm:text-base md:text-[17px]">
            {challenge.title}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
