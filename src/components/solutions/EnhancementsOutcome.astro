
---
interface EnhancementItem {
  title: string;
  icon?: "transition" | "ecosystem" | "coaching" | "culture" | "assessment" | "advisory";
}

interface Props {
  enhancements: EnhancementItem[];
  outcomes: string[];
  enhancementHeading?: string;
  outcomeHeading?: string;
  outcomeDescription?: string;
  backgroundImage?: string;
}

const {
  enhancements,
  outcomes,
  enhancementHeading = "Optional Enhancements",
  outcomeHeading = "Outcome",
  outcomeDescription = "",
  backgroundImage,
} = Astro.props;

const iconPaths: Record<string, string> = {
  transition: "M4 20V9a2 2 0 0 1 2-2h5v13M11 11h4a2 2 0 0 1 2 2v7M3 20h18M7 11h1M7 15h1M14 15h1M14 18h1M15 3v5M12 5l3-2 3 2",
  ecosystem: "M4 7h5M4 12h8M4 17h11M16 3l4 4-4 4M16 17l4 4",
  coaching: "M7 10V5a2 2 0 0 1 4 0v5M11 10V4a2 2 0 0 1 4 0v6M15 10V6a2 2 0 0 1 4 0v8a7 7 0 0 1-7 7h-2a7 7 0 0 1-6-3l-2-3a2 2 0 0 1 3-3l2 2",
  culture: "M12 3a9 9 0 1 0 9 9M12 7v5l4 2M19 3v5h-5",
  assessment: "M4 4h16v16H4zM8 8h8M8 12h8M8 16h5",
  advisory: "M12 3v18M5 7h14M5 7l-3 6h6L5 7ZM19 7l-3 6h6l-3-6ZM8 21h8",
};
---

<section
  class="relative isolate w-full overflow-hidden bg-gradient-to-br from-[#171B55] via-[#392B43] to-[#80432D] py-8 text-white md:py-9 lg:py-10"
  style={backgroundImage
    ? `background-image: linear-gradient(110deg, rgba(16,16,68,.94), rgba(55,35,65,.88), rgba(115,52,22,.88)), url("${backgroundImage}"); background-size: cover; background-position: center;`
    : undefined}
>
  <div class="mx-auto w-full max-w-vb px-6 sm:px-8 lg:px-12">

    <!-- Optional Enhancements -->
    <div>
      <h2 class="mb-4 font-heading !text-2xl font-bold leading-tight text-white sm:text-3xl md:mb-5 md:text-4xl">
        {enhancementHeading}
      </h2>

      <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 lg:gap-3">
        {enhancements.map((item: EnhancementItem) => (
          <article class="group flex min-h-[135px] flex-col justify-between rounded-vb-lg bg-white px-3.5 py-3.5 text-vb-navy transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg sm:min-h-[145px] lg:min-h-[155px]">

            <!-- Icon -->
            <div class="mb-3 flex h-8 w-8 items-center justify-start text-[#100057]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-8 w-8"
                aria-hidden="true"
              >
                <path d={iconPaths[item.icon || "coaching"] || iconPaths.coaching} />
              </svg>
            </div>

            <!-- Title -->
            <h3 class="font-sans !text-[16px] font-bold leading-snug text-[#333333] sm:text-sm">
              {item.title}
            </h3>

          </article>
        ))}
      </div>
    </div>

    <!-- Outcome -->
    <div class="mt-7 md:mt-8 lg:mt-9">
      <h2 class="font-heading !text-2xl font-bold leading-tight text-white sm:text-3xl md:text-4xl">
        {outcomeHeading}
      </h2>

      {outcomeDescription && (
        <p class="mt-2.5 max-w-3xl font-sans text-sm leading-relaxed text-white/90 sm:text-[15px]">
          {outcomeDescription}
        </p>
      )}

      {outcomes.length > 0 && (
        <ul class="mt-2.5 flex flex-col gap-1 pl-6">
          {outcomes.map((item: string) => (
            <li class="list-disc font-sans text-sm leading-relaxed text-white/90 sm:text-[15px]">
              {item}
            </li>
          ))}
        </ul>
      )}
    </div>

  </div>
</section>
