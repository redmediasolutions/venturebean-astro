---
/**
 * Consulting page: stats section.
 */
---

<div
  class="vb-element vb-element-8c6c180 e-grid e-con-boxed e-con e-child"
  data-id="8c6c180"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-42c8cc9 vb-invisible vb-widget vb-widget-counter"
      data-id="42c8cc9"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"_animation":"slideInUp"}'}
      data-widget_type="counter.default"
    >
      <div class="vb-widget-container">
        <div class="vb-counter">
          <div class="vb-counter-title">Years of Consulting</div>
          <div class="vb-counter-number-wrapper">
            <span class="vb-counter-number-prefix"></span>
            <span
              class="vb-counter-number"
              data-duration="2000"
              data-to-value="14"
              data-from-value="0"
              data-delimiter=",">0</span
            >
            <span class="vb-counter-number-suffix">+</span>
          </div>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-9205243 vb-invisible vb-widget vb-widget-counter"
      data-id="9205243"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"_animation":"slideInUp"}'}
      data-widget_type="counter.default"
    >
      <div class="vb-widget-container">
        <div class="vb-counter">
          <div class="vb-counter-title">Global Clients</div>
          <div class="vb-counter-number-wrapper">
            <span class="vb-counter-number-prefix"></span>
            <span
              class="vb-counter-number"
              data-duration="2000"
              data-to-value="300"
              data-from-value="0"
              data-delimiter=",">0</span
            >
            <span class="vb-counter-number-suffix">+</span>
          </div>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-65fed85 vb-invisible vb-widget vb-widget-counter"
      data-id="65fed85"
      data-element_type="widget"
      data-e-type="widget"
      data-settings={'{"_animation":"slideInUp"}'}
      data-widget_type="counter.default"
    >
      <div class="vb-widget-container">
        <div class="vb-counter">
          <div class="vb-counter-title">Global Markets</div>
          <div class="vb-counter-number-wrapper">
            <span class="vb-counter-number-prefix"></span>
            <span
              class="vb-counter-number"
              data-duration="2000"
              data-to-value="6"
              data-from-value="0"
              data-delimiter=",">0</span
            >
            <span class="vb-counter-number-suffix">+</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
