---
/**
 * Consulting page: consulting videos section.
 * Hidden on every screen size (kept as it was on the WordPress page).
 */
---

<div
  class="vb-element vb-element-4408215 vb-hidden-desktop vb-hidden-tablet vb-hidden-mobile e-flex e-con-boxed e-con e-parent"
  data-id="4408215"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-2440a1e e-con-full e-flex e-con e-child"
      data-id="2440a1e"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-edc4311 vb-widget vb-widget-video"
        data-id="edc4311"
        data-element_type="widget"
        data-e-type="widget"
        data-settings={'{"video_type":"hosted","controls":"yes"}'}
        data-widget_type="video.default"
      >
        <div class="vb-widget-container">
          <div class="e-hosted-video vb-wrapper vb-open-inline">
            <video
              class="vb-video"
              src="/assets/uploads/2024/06/Consulting-Services.mp4"
              controls=""
              preload="metadata"
              controlslist="nodownload"
              poster="/assets/uploads/2024/06/Consulting-Services.png"></video>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-8978638 vb-icon-list--layout-traditional vb-list-item-link-full_width vb-widget vb-widget-icon-list"
        data-id="8978638"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-list.default"
      >
        <div class="vb-widget-container">
          <ul class="vb-icon-list-items">
            <li class="vb-icon-list-item">
              <span class="vb-icon-list-icon"> <i aria-hidden="true" class="fas fa-video"></i> </span>
              <span class="vb-icon-list-text">Consulting</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-e22b210 e-con-full e-flex e-con e-child"
      data-id="e22b210"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-9239865 vb-widget vb-widget-video"
        data-id="9239865"
        data-element_type="widget"
        data-e-type="widget"
        data-settings={'{"video_type":"hosted","controls":"yes"}'}
        data-widget_type="video.default"
      >
        <div class="vb-widget-container">
          <div class="e-hosted-video vb-wrapper vb-open-inline">
            <video
              class="vb-video"
              src="/assets/uploads/2024/06/Consulting-Examples.mp4"
              controls=""
              preload="metadata"
              controlslist="nodownload"
              poster="/assets/uploads/2024/06/Consulting-Examples.png"></video>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-034bbd7 vb-icon-list--layout-traditional vb-list-item-link-full_width vb-widget vb-widget-icon-list"
        data-id="034bbd7"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-list.default"
      >
        <div class="vb-widget-container">
          <ul class="vb-icon-list-items">
            <li class="vb-icon-list-item">
              <span class="vb-icon-list-icon"> <i aria-hidden="true" class="fas fa-video"></i> </span>
              <span class="vb-icon-list-text">Consulting Examples</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
