/**
 * Consulting page: “Business Growth Consulting for SMBs and Founder-Led Businesses” section.
 */
---

<div
  class="vb-element vb-element-e7467df e-flex e-con-boxed e-con e-parent"
  data-id="e7467df"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-3d71ef0 vb-widget vb-widget-heading"
      data-id="3d71ef0"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="heading.default"
