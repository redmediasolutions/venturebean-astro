  /* 8 expertise boxes: 4 x 2 on desktop, no empty third row. */
  .vb-element.vb-element-3baeda0.e-con.e-grid {
    --e-con-grid-template-rows: auto;
    grid-template-rows: auto !important;
  }
</style>
