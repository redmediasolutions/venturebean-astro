---
/**
 * Consulting page: “Ready to Grow, Scale or Transform Your Business?” section.
 */
---

<div
  class="vb-element vb-element-f4c2606 e-flex e-con-boxed e-con e-parent"
  data-id="f4c2606"
  data-element_type="container"
  data-e-type="container"
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-7882f13 e-con-full e-flex e-con e-child"
      data-id="7882f13"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-3e3cab3 vb-widget vb-widget-heading"
        data-id="3e3cab3"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container">
          <h2 class="vb-heading-title vb-size-default">Ready to Grow, Scale or Transform Your Business?</h2>
        </div>
      </div>
      <div
        class="vb-element vb-element-2c34a8d vb-widget__width-initial vb-widget vb-widget-text-editor"
        data-id="2c34a8d"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container">
          <p class="p1">
            Whether you need support with business strategy, operational improvement, leadership development or business
            scaling, VentureBean can help.
          </p>
        </div>
      </div>
      <div
        class="vb-element vb-element-0e0cc87 e-con-full e-flex e-con e-child"
        data-id="0e0cc87"
        data-element_type="container"
        data-e-type="container"
      >
        <div
          class="vb-element vb-element-c961061 vb-align-center vb-widget vb-widget-button"
          data-id="c961061"
          data-element_type="widget"
          data-e-type="widget"
          data-widget_type="button.default"
        >
          <div class="vb-widget-container">
            <div class="vb-button-wrapper">
              <a class="vb-button vb-button-link vb-size-sm" href="/coaching/#call">
                <span class="vb-button-content-wrapper">
                  <span class="vb-button-icon"> <i aria-hidden="true" class="teenyicon ti-phonecall"></i> </span>
                  <span class="vb-button-text">Book a Discovery Call</span>
                </span>
              </a>
            </div>
          </div>
        </div>
        <div
          class="vb-element vb-element-9b03b02 vb-align-center vb-widget vb-widget-button"
          data-id="9b03b02"
          data-element_type="widget"
          data-e-type="widget"
          data-widget_type="button.default"
        >
          <div class="vb-widget-container">
            <div class="vb-button-wrapper">
              <a class="vb-button vb-button-link vb-size-sm" href="/testimonials/">
                <span class="vb-button-content-wrapper">
                  <span class="vb-button-icon"> <i aria-hidden="true" class="teenyicon ti-phonecall"></i> </span>
                  <span class="vb-button-text">Testimonial</span>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
