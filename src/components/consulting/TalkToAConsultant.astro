---
/**
 * Consulting page: “Talk to a Growth Consultant” section.
 */
---

<div
  class="vb-element vb-element-80cc9f1 e-flex e-con-boxed e-con e-parent"
  data-id="80cc9f1"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-4c6bc1f vb-widget vb-widget-heading"
      data-id="4c6bc1f"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="heading.default"
    >
      <div class="vb-widget-container">
        <h2 class="vb-heading-title vb-size-default">Talk to a Growth Consultant</h2>
      </div>
    </div>
    <div
      class="vb-element vb-element-13698af vb-align-left vb-widget vb-widget-button"
      data-id="13698af"
      data-element_type="widget"
      data-e-type="widget"
      data-widget_type="button.default"
    >
      <div class="vb-widget-container">
        <div class="vb-button-wrapper">
          <a class="vb-button vb-button-link vb-size-sm" href="/contact-us/">
            <span class="vb-button-content-wrapper"> <span class="vb-button-text">Book a Discovery Call</span> </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
