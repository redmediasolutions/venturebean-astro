---
/**
 * Consulting page: “Our Services” section.
 * Hidden on every screen size (kept as it was on the WordPress page).
 */
---

<div
  class="vb-element vb-element-e2d0b20 vb-hidden-desktop vb-hidden-tablet vb-hidden-mobile e-flex e-con-boxed e-con e-parent"
  data-id="e2d0b20"
  data-element_type="container"
  data-e-type="container"
  id="services"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-321957f e-con-full e-flex e-con e-child"
      data-id="321957f"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-dfe80c1 vb-widget vb-widget-heading"
        data-id="dfe80c1"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container"><h2 class="vb-heading-title vb-size-default">Our Services</h2></div>
      </div>
      <div
        class="vb-element vb-element-0ae42f8 vb-widget vb-widget-text-editor"
        data-id="0ae42f8"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container">
          <p class="p1">
            We help businesses achieve clear, disciplined growth by strengthening everything from business models and
            operations to leadership and financial systems. As your partner from strategy to execution, we implement the
            necessary frameworks and governance to deliver sustained results.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
