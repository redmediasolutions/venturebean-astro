---
/**
 * Consulting page: “Business Finance Practice” section.
 * Hidden on every screen size (kept as it was on the WordPress page).
 */
---

<div
  class="vb-element vb-element-fc87f58 vb-hidden-desktop vb-hidden-tablet vb-hidden-mobile e-flex e-con-boxed e-con e-parent"
  data-id="fc87f58"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-e6ce2a9 e-con-full e-flex e-con e-child"
      data-id="e6ce2a9"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"background_background":"classic","background_motion_fx_motion_fx_mouse":"yes"}'}
    >
      <div
        class="vb-element vb-element-a075cf7 vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
        data-id="a075cf7"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-icon-box-wrapper">
            <div class="vb-icon-box-icon">
              <a
                href="#vb-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjIwNDYxIiwidG9nZ2xlIjpmYWxzZX0%3D"
                class="vb-icon"
                tabindex="-1"
                aria-label="Business Finance Practice "
              >
                <i aria-hidden="true" class="fas fa-dollar-sign"></i>
              </a>
            </div>
            <div class="vb-icon-box-content">
              <h3 class="vb-icon-box-title">
                <a href="#vb-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjIwNDYxIiwidG9nZ2xlIjpmYWxzZX0%3D">
                  Business Finance Practice
                </a>
              </h3>
              <p class="vb-icon-box-description">
                Outsourced CFO for budgeting, compliance, MIS, risk management to improve cash flow, profitability.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-238a46c e-con-full e-flex e-con e-child"
      data-id="238a46c"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"background_background":"classic","background_motion_fx_motion_fx_mouse":"yes"}'}
    >
      <div
        class="vb-element vb-element-7f538ff vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
        data-id="7f538ff"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-icon-box-wrapper">
            <div class="vb-icon-box-icon">
              <a
                href="#vb-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjIwNDY0IiwidG9nZ2xlIjpmYWxzZX0%3D"
                class="vb-icon"
                tabindex="-1"
                aria-label="Digital Transformation Practice"
              >
                <i aria-hidden="true" class="fas fa-chess-board"></i>
              </a>
            </div>
            <div class="vb-icon-box-content">
              <h3 class="vb-icon-box-title">
                <a href="#vb-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjIwNDY0IiwidG9nZ2xlIjpmYWxzZX0%3D">
                  Digital Transformation Practice
                </a>
              </h3>
              <p class="vb-icon-box-description">
                Enrich brand presence via SEO, social media, content engagement, ROI through digital brand strategy.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-f2ba415 e-con-full e-flex e-con e-child"
      data-id="f2ba415"
      data-element_type="container"
      data-e-type="container"
      data-settings={'{"background_background":"classic","background_motion_fx_motion_fx_mouse":"yes"}'}
    >
      <div
        class="vb-element vb-element-c63cba9 vb-view-default vb-position-block-start vb-mobile-position-block-start vb-widget vb-widget-icon-box"
        data-id="c63cba9"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-icon-box-wrapper">
            <div class="vb-icon-box-icon">
              <a
                href="#vb-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjIwNDY3IiwidG9nZ2xlIjpmYWxzZX0%3D"
                class="vb-icon"
                tabindex="-1"
                aria-label="Business Operations Practice"
              >
                <i aria-hidden="true" class="fas fa-cannabis"></i>
              </a>
            </div>
            <div class="vb-icon-box-content">
              <h3 class="vb-icon-box-title">
                <a href="#vb-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjIwNDY3IiwidG9nZ2xlIjpmYWxzZX0%3D">
                  Business Operations Practice
                </a>
              </h3>
              <p class="vb-icon-box-description">
                BPR to streamline workflows, SOPs, KPIs to improve productivity, efficiency.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
