---
/**
 * Site header: logo, desktop menu and the mobile menu.
 * Menu links are in header/DesktopNav.astro and header/MobileNav.astro.
 */
import SiteLogo from './header/SiteLogo.astro';
import DesktopNav from './header/DesktopNav.astro';
import MobileNav from './header/MobileNav.astro';
---

<header data-vb-type="header" data-vb-id="19568" class="vb vb-19568 vb-location-header" data-vb-post-type="vb_library">
  <div
    class="vb-element vb-element-4d1c16f e-flex e-con-boxed e-con e-parent"
    data-id="4d1c16f"
    data-element_type="container"
    data-e-type="container"
    data-settings={'{"background_background":"classic","background_motion_fx_motion_fx_scrolling":"yes","background_motion_fx_opacity_effect":"yes","background_motion_fx_opacity_level":{"unit":"px","size":9,"sizes":[]},"background_motion_fx_blur_effect":"yes","background_motion_fx_blur_level":{"unit":"px","size":8,"sizes":[]},"sticky":"top","background_motion_fx_opacity_direction":"out-in","background_motion_fx_opacity_range":{"unit":"%","size":"","sizes":{"start":20,"end":80}},"background_motion_fx_blur_direction":"out-in","background_motion_fx_blur_range":{"unit":"%","size":"","sizes":{"start":20,"end":80}},"background_motion_fx_devices":["desktop","tablet","mobile"],"sticky_on":["desktop","tablet","mobile"],"sticky_offset":0,"sticky_effects_offset":0,"sticky_anchor_link_offset":0}'}
  >
    <div class="e-con-inner">
      <SiteLogo />
      <div
        class="vb-element vb-element-fccc482 e-con-full e-flex e-con e-child"
        data-id="fccc482"
        data-element_type="container"
        data-e-type="container"
      >
        <DesktopNav />
        <MobileNav />
      </div>
    </div>

    <!-- Full-Header Search Overlay (shared between Desktop and Mobile) -->
    <div
      id="header-search-overlay"
      class="header-search-overlay"
      role="dialog"
      aria-modal="true"
      aria-label="Site Search"
      hidden
    >
      <div class="header-search-overlay-inner">
        <form class="overlay-search-form" action="/" method="get">
          <label for="overlay-search-input" class="vb-screen-only">Search</label>
          <i class="fas fa-search overlay-search-icon" aria-hidden="true"></i>
          <input
            id="overlay-search-input"
            class="overlay-search-input"
            type="search"
            name="s"
            placeholder="Type to search..."
            autocomplete="off"
          />
          <button class="overlay-submit-btn" type="submit">Search</button>
        </form>
        <button
          id="search-close-btn"
          class="header-search-close-btn"
          type="button"
          aria-label="Close search dialog"
        >
          <i class="fas fa-times" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  function setupSearchOverlay() {
    const desktopOpenBtn = document.getElementById('search-open-btn');
    const mobileOpenBtn = document.getElementById('mobile-search-open-btn');
    const closeBtn = document.getElementById('search-close-btn');
    const overlay = document.getElementById('header-search-overlay');
    const input = document.getElementById('overlay-search-input') as HTMLInputElement | null;

    if (!overlay || !closeBtn) return;

    const openBtns = [desktopOpenBtn, mobileOpenBtn].filter((b): b is HTMLElement => Boolean(b));
    if (openBtns.length === 0) return;

    function openSearch() {
      overlay?.removeAttribute('hidden');
      requestAnimationFrame(() => {
        overlay?.classList.add('is-active');
        openBtns.forEach((btn) => btn.setAttribute('aria-expanded', 'true'));
        input?.focus();
      });
    }

    function closeSearch() {
      overlay?.classList.remove('is-active');
      openBtns.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
      setTimeout(() => {
        if (!overlay?.classList.contains('is-active')) {
          overlay?.setAttribute('hidden', '');
        }
      }, 250);
    }

    openBtns.forEach((btn) => {
      btn.removeEventListener('click', openSearch);
      btn.addEventListener('click', openSearch);
    });

    closeBtn.removeEventListener('click', closeSearch);
    closeBtn.addEventListener('click', closeSearch);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay?.classList.contains('is-active')) {
        closeSearch();
      }
    });
  }

  setupSearchOverlay();
  document.addEventListener('astro:page-load', setupSearchOverlay);
</script>
