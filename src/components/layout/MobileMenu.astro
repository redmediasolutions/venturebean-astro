---
import Icon from '../ui/Icon.astro';
import { mainNav, headerCtas, footer } from '../../data/site.js';
import { link } from '../../utils/links.js';

// Flatten for the large mobile list; children render as a sub-row.
const items = [...mainNav, headerCtas.secondary];
---

<div class="mm" id="mobile-menu" data-menu aria-hidden="true" inert>
  <div class="mm__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="mm__top container">
      <a href="/" class="mm__logo" aria-label="VentureBean — home">
        <img src="/images/logo.svg" alt="" width="140" height="40" />
      </a>
      <button class="mm__close" type="button" data-menu-close>
        <Icon name="close" size={22} />
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>

    <nav class="mm__nav container" aria-label="Mobile">
      <ol role="list" class="mm__list">
        {
          items.map((item, i) => (
            <li class="mm__item" style={`--i:${i}`}>
              <a href={link(item.href)} class="mm__link">
                <span class="mm__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="mm__label">{item.label}</span>
                <Icon name="arrow-up-right" size={22} class="mm__arrow" />
              </a>
              {item.children && (
                <ul role="list" class="mm__sub">
                  {item.children.map((c) => (
                    <li>
                      <a href={link(c.href)}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="mm__foot container">
      <a href={link(headerCtas.primary.href)} class="mm__cta">
        {headerCtas.primary.label}
        <Icon name="arrow-right" size={20} />
      </a>
      <div class="mm__contact">
        <a href={footer.phone.href}>{footer.phone.label}</a>
        <a href={footer.email.href}>{footer.email.label}</a>
      </div>
    </div>
  </div>
</div>

<style>
  .mm {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
  }
  .mm__panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--vb-navy-950);
    color: #fff;
    clip-path: circle(0% at calc(100% - 2.6rem) 2rem);
    transition: clip-path 700ms var(--ease-in-out);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mm.is-open {
    pointer-events: auto;
  }
  .mm.is-open .mm__panel {
    clip-path: circle(150% at calc(100% - 2.6rem) 2rem);
  }
  .mm__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    flex: none;
  }
  .mm__logo {
    background: #fff;
    padding: 0.45rem 0.75rem;
    border-radius: 10px;
  }
  .mm__logo img {
    width: 120px;
    height: auto;
  }
  .mm__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--color-border-dark);
    color: #fff;
  }
  .mm__nav {
    flex: 1;
    padding-block: 1.5rem;
  }
  .mm__item {
    border-bottom: 1px solid var(--color-border-dark);
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 500ms var(--ease-out),
      transform 700ms var(--ease-out);
  }
  .mm.is-open .mm__item {
    opacity: 1;
    transform: none;
    transition-delay: calc(250ms + var(--i) * 60ms);
  }
  .mm__link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    min-height: 3.5rem;
  }
  .mm__num {
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    color: var(--vb-brown-300);
    width: 1.75rem;
    flex: none;
  }
  .mm__label {
    flex: 1;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .mm__link :global(.mm__arrow) {
    color: var(--color-on-dark-muted);
  }
  .mm__sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 0 1.2rem 2.75rem;
  }
  .mm__sub a {
    display: inline-block;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-dark);
    font-size: 0.9375rem;
    color: var(--color-on-dark-muted);
  }
  .mm__foot {
    display: grid;
    gap: 1.25rem;
    padding-block: 1.5rem 2rem;
  }
  .mm__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--vb-blue-700);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.875rem;
  }
  .mm__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-on-dark-muted);
  }
</style>

<script>
  const menu = document.querySelector('[data-menu]');
  const openBtn = document.querySelector('[data-menu-open]');
  const closeBtn = menu.querySelector('[data-menu-close]');

  const setOpen = (open) => {
    menu.classList.toggle('is-open', open);
    menu.toggleAttribute('inert', !open);
    menu.setAttribute('aria-hidden', String(!open));
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn).focus({ preventScroll: true });
  };

  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  menu.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
