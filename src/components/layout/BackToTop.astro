---
import Icon from '../ui/Icon.astro';
---

<a href="#main" class="btt" data-btt aria-label="Back to Top">
  <svg class="btt__ring" viewBox="0 0 48 48" aria-hidden="true">
    <circle cx="24" cy="24" r="22" pathLength="100"></circle>
  </svg>
  <Icon name="arrow-up" size={18} stroke={2} />
</a>

<style>
  .btt {
    position: fixed;
    right: clamp(1rem, 2vw, 1.75rem);
    bottom: clamp(1rem, 2vw, 1.75rem);
    z-index: 90;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--vb-navy-800);
    color: #fff;
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 400ms var(--ease-out),
      transform 400ms var(--ease-out),
      visibility 0s linear 400ms,
      background-color var(--dur-fast);
  }
  .btt.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .btt:hover {
    background: var(--vb-brown-700);
  }
  .btt > :global(svg:last-child) {
    grid-area: 1 / 1;
  }
  .btt__ring {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .btt__ring circle {
    fill: none;
    stroke: var(--vb-brown-300);
    stroke-width: 2;
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - var(--progress, 0) * 100);
  }
</style>

<script>
  const btn = document.querySelector('[data-btt]');
  let raf = 0;
  const update = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? scrollY / max : 0;
    btn.style.setProperty('--progress', p.toFixed(4));
    btn.classList.toggle('is-visible', scrollY > innerHeight * 0.8);
    raf = 0;
  };
  addEventListener('scroll', () => (raf ||= requestAnimationFrame(update)), { passive: true });
  update();
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    document.getElementById('main')?.focus({ preventScroll: true });
  });
</script>
