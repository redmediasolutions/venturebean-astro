---
/**
 * Mobile header: menu button and the slide-out menu.
 * Hidden on desktop and tablet.
 */
---

<div
  class="vb-element vb-element-dff3e0d e-con-full vb-hidden-desktop e-flex e-con e-child"
  data-id="dff3e0d"
  data-element_type="container"
  data-e-type="container"
>
  <div
    class="vb-element vb-element-2fc5a38 vb-hidden-desktop vb-view-default vb-widget vb-widget-icon"
    data-id="2fc5a38"
    data-element_type="widget"
    data-e-type="widget"
    data-widget_type="icon.default"
  >
    <div class="vb-widget-container">
      <div class="vb-icon-wrapper">
        <a
          class="vb-icon"
          href="#vb-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjIwNDA3IiwidG9nZ2xlIjp0cnVlfQ%3D%3D"
        >
          <i aria-hidden="true" class="feather icon-search"></i>
        </a>
      </div>
    </div>
  </div>
  <div
    class="vb-element vb-element-02ebb5d vb-hidden-desktop vb-view-default vb-widget vb-widget-icon"
    data-id="02ebb5d"
    data-element_type="widget"
    data-e-type="widget"
    data-widget_type="icon.default"
  >
    <div class="vb-widget-container">
      <div class="vb-icon-wrapper">
        <a
          class="vb-icon"
          href="#vb-action%3Aaction%3Doff_canvas%3Aopen%26settings%3DeyJpZCI6IjgyZjUxMDEiLCJkaXNwbGF5TW9kZSI6Im9wZW4ifQ%3D%3D"
        >
          <i aria-hidden="true" class="fas fa-bars"></i>
        </a>
      </div>
    </div>
  </div>
  <div
    class="vb-element vb-element-82f5101 vb-widget vb-widget-off-canvas"
    data-id="82f5101"
    data-element_type="widget"
    data-e-type="widget"
    data-settings={'{"entrance_animation":"slideInLeft","exit_animation":"slideInLeft"}'}
    data-widget_type="off-canvas.default"
  >
    <div class="vb-widget-container">
      <div
        id="off-canvas-82f5101"
        class="e-off-canvas"
        role="dialog"
        aria-hidden="true"
        aria-label="Off-Canvas"
        aria-modal="true"
        inert=""
        data-delay-child-handlers="true"
      >
        <div class="e-off-canvas__overlay"></div>
        <div class="e-off-canvas__main">
          <div class="e-off-canvas__content">
            <div
              class="vb-element vb-element-914a433 e-con-full e-flex e-con e-child"
              data-id="914a433"
              data-element_type="container"
              data-e-type="container"
              data-settings={'{"background_background":"classic"}'}
            >
              <div
                class="vb-element vb-element-27a429a e-con-full e-flex e-con e-child"
                data-id="27a429a"
                data-element_type="container"
                data-e-type="container"
                data-settings={'{"background_background":"classic"}'}
              >
                <div
                  class="vb-element vb-element-04eb703 vb-widget vb-widget-theme-site-logo vb-widget-image"
                  data-id="04eb703"
                  data-element_type="widget"
                  data-e-type="widget"
                  data-widget_type="theme-site-logo.default"
                >
                  <div class="vb-widget-container">
                    <a href="/">
                      <img
                        width="100"
                        height="100"
                        src="/assets/uploads/2023/03/Venture-bean-logo.svg"
                        class="attachment-full size-full site-image-23042"
                        alt=""
                      />
                    </a>
                  </div>
                </div>
              </div>
              <div
                class="vb-element vb-element-a2c54a5 e-flex e-con-boxed e-con e-child"
                data-id="a2c54a5"
                data-element_type="container"
                data-e-type="container"
              >
                <div class="e-con-inner">
                  <div
                    class="vb-element vb-element-f526c5f vb-icon-list--layout-traditional vb-list-item-link-full_width vb-widget vb-widget-icon-list"
                    data-id="f526c5f"
                    data-element_type="widget"
                    data-e-type="widget"
                    data-widget_type="icon-list.default"
                  >
                    <div class="vb-widget-container">
                      <ul class="vb-icon-list-items">
                        <li class="vb-icon-list-item">
                          <a href="/">
                            <span class="vb-icon-list-icon">
                              <i aria-hidden="true" class="feather icon-home"></i>
                            </span>
                            <span class="vb-icon-list-text">HOME</span>
                          </a>
                        </li>
                        <li class="vb-icon-list-item">
                          <a href="/about-us/">
                            <span class="vb-icon-list-icon">
                              <i aria-hidden="true" class="feather icon-globe"></i>
                            </span>
                            <span class="vb-icon-list-text">ABOUT</span>
                          </a>
                        </li>
                        <li class="vb-icon-list-item">
                          <a href="/business-consulting/">
                            <span class="vb-icon-list-icon">
                              <i aria-hidden="true" class="feather icon-layers"></i>
                            </span>
                            <span class="vb-icon-list-text">Consulting</span>
                          </a>
                        </li>
                        <li class="vb-icon-list-item">
                          <a href="/coaching/">
                            <span class="vb-icon-list-icon">
                              <i aria-hidden="true" class="feather icon-grid"></i>
                            </span>
                            <span class="vb-icon-list-text">Coaching</span>
                          </a>
                        </li>
                        <li class="vb-icon-list-item">
                          <a href="/venturebean-solutions-page/">
                            <span class="vb-icon-list-icon">
                              <i aria-hidden="true" class="feather icon-grid"></i>
                            </span>
                            <span class="vb-icon-list-text">Solutions</span>
                          </a>
                        </li>
                        <li class="vb-icon-list-item">
                          <a href="/knowledge-hub/">
                            <span class="vb-icon-list-icon">
                              <i aria-hidden="true" class="feather icon-layers"></i>
                            </span>
                            <span class="vb-icon-list-text">Knowledge Hub</span>
                          </a>
                        </li>
                      </ul>
                    </div>
                  </div>
                  <div
                    class="vb-element vb-element-3d97339 vb-icon-list--layout-traditional vb-list-item-link-full_width vb-widget vb-widget-icon-list"
                    data-id="3d97339"
                    data-element_type="widget"
                    data-e-type="widget"
                    data-widget_type="icon-list.default"
                  >
                    <div class="vb-widget-container">
                      <ul class="vb-icon-list-items">
                        <li class="vb-icon-list-item">
                          <a href="/testimonials/">
                            <span class="vb-icon-list-icon">
                              <i aria-hidden="true" class="remixicon ri-speaker-3-fill"></i>
                            </span>
                            <span class="vb-icon-list-text">TESTIMONIAL</span>
                          </a>
                        </li>
                        <li class="vb-icon-list-item">
                          <a href="/clients/">
                            <span class="vb-icon-list-icon"> <i aria-hidden="true" class="far fa-hourglass"></i> </span>
                            <span class="vb-icon-list-text">CLIENTS</span>
                          </a>
                        </li>
                        <li class="vb-icon-list-item">
                          <a href="/knowledge-hub/insights/">
                            <span class="vb-icon-list-icon">
                              <i aria-hidden="true" class="feather icon-grid"></i>
                            </span>
                            <span class="vb-icon-list-text">Insights</span>
                          </a>
                        </li>
                      </ul>
                    </div>
                  </div>
                  <div
                    class="vb-element vb-element-e4adf41 vb-align-left vb-mobile-align-justify vb-widget vb-widget-button"
                    data-id="e4adf41"
                    data-element_type="widget"
                    data-e-type="widget"
                    data-widget_type="button.default"
                  >
                    <div class="vb-widget-container">
                      <div class="vb-button-wrapper">
                        <a class="vb-button vb-button-link vb-size-sm" href="/contact-us/">
                          <span class="vb-button-content-wrapper">
                            <span class="vb-button-icon">
                              <i aria-hidden="true" class="remixicon ri-contacts-line"></i>
                            </span>
                            <span class="vb-button-text">Reach Us</span>
                          </span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="vb-element vb-element-79e796b e-con-full e-flex e-con e-child"
                data-id="79e796b"
                data-element_type="container"
                data-e-type="container"
              >
                <div
                  class="vb-element vb-element-952c6f0 vb-widget vb-widget-text-editor"
                  data-id="952c6f0"
                  data-element_type="widget"
                  data-e-type="widget"
                  data-widget_type="text-editor.default"
                >
                  <div class="vb-widget-container">
                    <p>
                      <strong>VentureBean Consulting Pvt. Ltd.</strong><br />We Work Salarpuria Symbiosis,<br />Arekere
                      Village<br />Begur Hobli,<br />Bannerghatta Road,<br />Bengaluru – 560076, India
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
