
---
/**
 * VentureBean – Mobile & Tablet Header
 * Shared navigation data with desktop header.
 */

import { navigation } from "../../../data/navigation";

const mobileNavigation = navigation.filter(
  (item) => !item.mobileOnly ? true : true
);

const reachUs = mobileNavigation.find(
  (item) => item.label === "Reach Us"
);

const menuItems = mobileNavigation.filter(
  (item) => item.label !== "Reach Us"
);
---

<div class="vb-mobile-header">

  <!-- Search Button -->
  <div class="mobile-header-btn-wrap">
    <button
      id="mobile-search-open-btn"
      class="mobile-header-icon-btn"
      type="button"
      aria-label="Open search dialog"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="header-search-overlay"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-4-4" />
      </svg>
    </button>
  </div>

  <!-- Hamburger Button -->
  <div class="mobile-header-btn-wrap">
    <button
      id="mobile-menu-toggle-btn"
      class="mobile-header-icon-btn"
      type="button"
      aria-label="Open navigation menu"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="off-canvas-82f5101"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-6 w-6"
        aria-hidden="true"
      >
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Off Canvas Drawer -->
  <div
    id="off-canvas-82f5101"
    class="mobile-drawer"
    role="dialog"
    aria-hidden="true"
    aria-label="Navigation Menu"
    aria-modal="true"
    inert
  >
    <!-- Overlay -->
    <button
      class="mobile-drawer-overlay"
      type="button"
      aria-label="Close navigation menu"
      data-drawer-close
    ></button>

    <!-- Drawer Panel -->
    <div class="mobile-drawer-panel">

      <!-- Drawer Header -->
      <div class="mobile-drawer-header">

        <a href="/" class="mobile-drawer-logo" aria-label="VentureBean Home">
          <img
            src="/assets/uploads/2023/03/Venture-bean-logo.svg"
            alt="VentureBean"
            width="135"
            height="34"
          />
        </a>

        <button
          id="mobile-drawer-close-btn"
          class="mobile-drawer-close-btn"
          type="button"
          aria-label="Close navigation menu"
          data-drawer-close
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path d="m18 6-12 12M6 6l12 12" />
          </svg>
        </button>

      </div>

      <!-- Drawer Search -->
      <div class="mobile-drawer-search">
        <form
          class="mobile-drawer-search-form"
          action="/search/"
          method="get"
          role="search"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mobile-drawer-search-icon"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-4-4" />
          </svg>

          <input
            type="search"
            name="s"
            placeholder="Search VentureBean..."
            class="mobile-drawer-search-input"
            autocomplete="off"
          />

          <button
            type="submit"
            class="mobile-drawer-search-submit"
            aria-label="Submit Search"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </button>
        </form>
      </div>

      <!-- Navigation -->
      <nav class="mobile-drawer-nav" aria-label="Mobile navigation">
        <ul class="mobile-nav-list">

          {menuItems.map((item) => (
            <li class:list={["mobile-nav-item", { "has-accordion": item.children?.length }]}>

              <div class="mobile-nav-row">

                <a href={item.href} class="mobile-nav-link">
                  <span class="mobile-nav-text">
                    {item.icon && (
                      <i class={`${item.icon} mobile-nav-icon`} aria-hidden="true"></i>
                    )}
                    {item.label}
                  </span>
                </a>

                {item.children?.length && (
                  <button
                    type="button"
                    class="mobile-accordion-btn"
                    aria-expanded="false"
                    aria-label={`Toggle ${item.label} submenu`}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.22 7.47a.75.75 0 0 1 1.06 0L10 11.19l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 8.53a.75.75 0 0 1 0-1.06Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                )}

              </div>

              {item.children?.length && (
                <ul class="mobile-sub-menu" hidden>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="mobile-sub-link">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}

            </li>
          ))}

          <!-- Reach Us CTA -->
          {reachUs && (
            <li class="mobile-nav-cta">
              <a href={reachUs.href} class="mobile-cta-btn">
                <i class={reachUs.icon || "fas fa-paper-plane"} aria-hidden="true"></i>
                <span>{reachUs.label}</span>
              </a>
            </li>
          )}

        </ul>
      </nav>

      <!-- Drawer Footer -->
      <div class="mobile-drawer-footer">
        <p class="mobile-company-title">
          VentureBean Consulting Pvt. Ltd.
        </p>

        <p class="mobile-company-address">
          We Work Salarpuria Symbiosis,<br />
          Arekere Village, Begur Hobli,<br />
          Bannerghatta Road, Bengaluru – 560076, India
        </p>
      </div>

    </div>
  </div>

</div>

<style>
  /* ========================================
     MOBILE HEADER
  ======================================== */

  .vb-mobile-header {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    width: 100%;
  }

  @media (max-width: 1024px) {
    .vb-mobile-header {
      display: flex;
    }
  }

  .mobile-header-btn-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-header-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: #1a1a1a;
    cursor: pointer;
    text-decoration: none;
    transition: background-color .2s ease, color .2s ease, transform .15s ease;
  }

  .mobile-header-icon-btn:hover,
  .mobile-header-icon-btn:focus-visible {
    background: #f7f7f7;
    color: #8b2332;
  }

  .mobile-header-icon-btn:active {
    transform: scale(.94);
  }

  /* ========================================
     DRAWER
  ======================================== */

  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 99999;
    visibility: hidden;
    pointer-events: none;
  }

  .mobile-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-drawer-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, .48);
    opacity: 0;
    cursor: default;
    transition: opacity .3s ease;
  }

  .mobile-drawer.is-open .mobile-drawer-overlay {
    opacity: 1;
  }

  .mobile-drawer-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    width: min(340px, 86vw);
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #ffffff;
    box-shadow: 4px 0 24px rgba(0, 0, 0, .16);
    transform: translateX(-100%);
    transition: transform .3s ease;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-drawer.is-open .mobile-drawer-panel {
    transform: translateX(0);
  }

  /* ========================================
     DRAWER HEADER
  ======================================== */

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 16px 20px;
    border-bottom: 1px solid #eeeeee;
    background: #ffffff;
  }

  .mobile-drawer-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .mobile-drawer-logo img {
    display: block;
    width: auto;
    height: 34px;
    max-width: 150px;
    object-fit: contain;
  }

  .mobile-drawer-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid #e5e5e5;
    border-radius: 50%;
    background: #fafafa;
    color: #444444;
    cursor: pointer;
    transition: all .2s ease;
  }

  .mobile-drawer-close-btn:hover,
  .mobile-drawer-close-btn:focus-visible {
    border-color: #8b2332;
    background: #fcf4f5;
    color: #8b2332;
    transform: rotate(90deg);
  }

  /* ========================================
     SEARCH
  ======================================== */

  .mobile-drawer-search {
    flex-shrink: 0;
    padding: 14px 20px 8px;
    background: #ffffff;
  }

  .mobile-drawer-search-form {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .mobile-drawer-search-icon {
    position: absolute;
    left: 14px;
    width: 17px;
    height: 17px;
    color: #888888;
    pointer-events: none;
  }

  .mobile-drawer-search-input {
    box-sizing: border-box;
    width: 100%;
    height: 42px;
    padding: 0 44px 0 38px;
    border: 1px solid #dedede;
    border-radius: 21px;
    outline: none;
    background: #f8f9fa;
    color: #1a1a1a;
    font-size: .92rem;
    transition: all .2s ease;
  }

  .mobile-drawer-search-input:focus {
    border-color: #8b2332;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(139, 35, 50, .12);
  }

  .mobile-drawer-search-submit {
    position: absolute;
    right: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: #8b2332;
    color: #ffffff;
    cursor: pointer;
    transition: opacity .2s ease, transform .15s ease;
  }

  .mobile-drawer-search-submit:hover {
    opacity: .9;
  }

  .mobile-drawer-search-submit:active {
    transform: scale(.92);
  }

  /* ========================================
     NAVIGATION
  ======================================== */

  .mobile-drawer-nav {
    flex: 1 1 auto;
    padding: 8px 0;
  }

  .mobile-nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-nav-item {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid #f2f2f2;
    list-style: none;
  }

  .mobile-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    padding: 13px 20px;
    color: #1a1a1a;
    font-size: .95rem;
    font-weight: 700;
    letter-spacing: .03em;
    text-decoration: none;
    text-transform: uppercase;
    transition: all .18s ease;
  }

  .mobile-nav-text {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .mobile-nav-icon {
    width: 18px;
    color: #8b2332;
    font-size: 1rem;
    text-align: center;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible,
  .mobile-nav-link.is-active {
    background: #fcf4f5;
    color: #8b2332;
  }

  /* Accordion Button */

  .mobile-accordion-btn {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    background: transparent;
    color: #777777;
    cursor: pointer;
    transition: all .2s ease;
  }

  .mobile-accordion-btn:hover,
  .mobile-accordion-btn:focus-visible {
    background: #fcf4f5;
    color: #8b2332;
  }

  .mobile-accordion-btn svg {
    transition: transform .2s ease;
  }

  .mobile-accordion-btn[aria-expanded="true"] svg {
    transform: rotate(180deg);
    color: #8b2332;
  }

  /* ========================================
     SUBMENU
  ======================================== */

  .mobile-sub-menu {
    margin: 0 0 0 20px;
    padding: 4px 0 8px;
    border-left: 3px solid #8b2332;
    background: #fbfbfb;
    list-style: none;
    animation: mobileSlideDown .2s ease-out;
  }

  .mobile-sub-menu[hidden] {
    display: none !important;
  }

  .mobile-sub-menu li {
    margin: 0;
    list-style: none;
  }

  .mobile-sub-link {
    display: block;
    padding: 10px 18px;
    color: #333333;
    font-size: .9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all .18s ease;
  }

  .mobile-sub-link:hover,
  .mobile-sub-link:focus-visible,
  .mobile-sub-link.is-active {
    padding-left: 22px;
    background: #f4eaec;
    color: #8b2332;
  }

  @keyframes mobileSlideDown {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ========================================
     REACH US CTA
  ======================================== */

  .mobile-nav-cta {
    padding: 20px 20px 10px;
    list-style: none;
  }

  .mobile-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    width: 100%;
    height: 46px;
    border-radius: 6px;
    background: #8b2332;
    box-shadow: 0 4px 12px rgba(139, 35, 50, .26);
    color: #ffffff !important;
    font-size: .95rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: all .2s ease;
  }

  .mobile-cta-btn:hover,
  .mobile-cta-btn:focus-visible {
    background: #721c28;
    box-shadow: 0 6px 16px rgba(139, 35, 50, .38);
    transform: translateY(-1px);
  }

  /* ========================================
     DRAWER FOOTER
  ======================================== */

  .mobile-drawer-footer {
    flex-shrink: 0;
    padding: 18px 20px 24px;
    border-top: 1px solid #eeeeee;
    background: #fafafa;
  }

  .mobile-company-title {
    margin: 0 0 6px;
    color: #1a1a1a;
    font-size: .85rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .mobile-company-address {
    margin: 0;
    color: #666666;
    font-size: .78rem;
    line-height: 1.5;
  }

  body.mobile-drawer-open {
    overflow: hidden;
  }
</style>

<script>
  function setupMobileNav() {
    const drawer = document.getElementById("off-canvas-82f5101");
    const openButton = document.getElementById("mobile-menu-toggle-btn");

    if (!drawer || !openButton) return;

    if (drawer.dataset.initialized === "true") return;
    drawer.dataset.initialized = "true";

    const closeButtons = drawer.querySelectorAll<HTMLButtonElement>(
      "[data-drawer-close]"
    );

    const closeDrawer = () => {
      drawer.classList.remove("is-open");
      drawer.setAttribute("aria-hidden", "true");
      drawer.setAttribute("inert", "");

      openButton.setAttribute("aria-expanded", "false");
      document.body.classList.remove("mobile-drawer-open");
    };

    const openDrawer = () => {
      drawer.classList.add("is-open");
      drawer.removeAttribute("inert");
      drawer.setAttribute("aria-hidden", "false");

      openButton.setAttribute("aria-expanded", "true");
      document.body.classList.add("mobile-drawer-open");

      const closeButton = drawer.querySelector<HTMLButtonElement>(
        "#mobile-drawer-close-btn"
      );

      closeButton?.focus();
    };

    openButton.addEventListener("click", openDrawer);

    closeButtons.forEach((button) => {
      button.addEventListener("click", closeDrawer);
    });

    // Close with Escape
    drawer.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeDrawer();
        openButton.focus();
      }
    });

    // Accordion handling
    const accordionButtons = drawer.querySelectorAll<HTMLButtonElement>(
      ".mobile-accordion-btn"
    );

    accordionButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const parent = button.closest("li");
        const submenu = parent?.querySelector<HTMLElement>(
          ":scope > .mobile-sub-menu"
        );

        if (!submenu) return;

        const expanded =
          button.getAttribute("aria-expanded") === "true";

        button.setAttribute("aria-expanded", String(!expanded));

        if (expanded) {
          submenu.setAttribute("hidden", "");
        } else {
          submenu.removeAttribute("hidden");
        }
      });
    });

    // Active page highlighting
    const normalizePath = (path: string) => {
      if (path === "/") return "/";
      return path.endsWith("/") ? path : `${path}/`;
    };

    const currentPath = normalizePath(window.location.pathname);

    const links = drawer.querySelectorAll<HTMLAnchorElement>(
      ".mobile-nav-link, .mobile-sub-link"
    );

    links.forEach((link) => {
      try {
        const url = new URL(link.href, window.location.href);

        if (
          url.origin === window.location.origin &&
          normalizePath(url.pathname) === currentPath
        ) {
          link.classList.add("is-active");
          link.setAttribute("aria-current", "page");

          const submenu = link.closest<HTMLElement>(".mobile-sub-menu");

          if (submenu) {
            submenu.removeAttribute("hidden");

            const parentItem = submenu.parentElement;
            const parentButton =
              parentItem?.querySelector<HTMLButtonElement>(
                ":scope > .mobile-nav-row .mobile-accordion-btn"
              );

            parentButton?.setAttribute("aria-expanded", "true");
          }
        }
      } catch {
        // Ignore invalid navigation URLs.
      }
    });

    // Close drawer when a navigation link is selected
    drawer.querySelectorAll<HTMLAnchorElement>(
      ".mobile-nav-link, .mobile-sub-link, .mobile-cta-btn"
    ).forEach((link) => {
      link.addEventListener("click", () => {
        closeDrawer();
      });
    });

  }

  setupMobileNav();
  document.addEventListener("astro:page-load", setupMobileNav);
</script>
