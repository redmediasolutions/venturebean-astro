---
/**
 * Desktop header: search box and the main menu.
 * Hidden on tablet and mobile.
 */
---

<div
  class="vb-element vb-element-99fb249 e-con-full vb-hidden-tablet vb-hidden-mobile e-flex e-con e-child"
  data-id="99fb249"
  data-element_type="container"
  data-e-type="container"
>
  <div
    class="vb-element vb-element-9c1ee08 vb-widget__width-initial vb-hidden-tablet vb-hidden-mobile vb-widget vb-widget-search"
    data-id="9c1ee08"
    data-element_type="widget"
    data-e-type="widget"
    data-settings={'{"submit_trigger":"key_enter","pagination_type_options":"none"}'}
    data-widget_type="search.default"
  >
    <div class="vb-widget-container">
      <search class="e-search hidden" role="search">
        <form class="e-search-form" action="/" method="get">
          <label class="e-search-label" for="search-9c1ee08"> <span class="vb-screen-only"> Search </span> </label>
          <div class="e-search-input-wrapper">
            <input
              id="search-9c1ee08"
              placeholder="Type to start searching..."
              class="e-search-input"
              type="search"
              name="s"
              value=""
              autocomplete="on"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="results-9c1ee08"
              aria-haspopup="listbox"
            />
            <i aria-hidden="true" class="fas fa-times"></i>
            <output
              id="results-9c1ee08"
              class="e-search-results-container hide-loader"
              aria-live="polite"
              aria-atomic="true"
              aria-label="Results for search"
              tabindex="0"
            >
              <div class="e-search-results"></div>
            </output>
          </div>
          <button class="e-search-submit vb-screen-only" type="submit" aria-label="Search"> </button>
          <input type="hidden" name="e_search_props" value="9c1ee08-19568" />
        </form>
      </search>
    </div>
  </div>
  <div
