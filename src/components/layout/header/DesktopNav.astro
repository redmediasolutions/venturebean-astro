
---
/**
 * VentureBean – Desktop Navigation
 * Shared navigation data with mobile header.
 */

import { navigation } from "../../../data/navigation";

const desktopNavigation = navigation.filter(
  (item) => !item.mobileOnly && item.label !== "Reach Us"
);

const reachUs = navigation.find(
  (item) => item.label === "Reach Us"
);
---

<div
  class="vb-header-desktop-bar vb-element vb-element-99fb249 e-con-full vb-hidden-tablet vb-hidden-mobile e-flex e-con e-child"
  data-id="99fb249"
  data-element_type="container"
  data-e-type="container"
>
  <!-- Navigation Container -->
  <div
    class="vb-element vb-element-36794c7 vb-nav-menu__align-end vb-hidden-tablet vb-hidden-mobile vb-widget__width-auto vb-nav-menu--dropdown-tablet vb-nav-menu__text-align-aside vb-nav-menu--toggle vb-nav-menu--burger vb-widget vb-widget-nav-menu"
    data-id="36794c7"
    data-element_type="widget"
    data-e-type="widget"
  >
    <div class="vb-widget-container">
      <nav
        aria-label="Desktop navigation"
        class="vb-nav-menu--main vb-nav-menu__container vb-nav-menu--layout-horizontal"
      >
        <ul id="menu-1-36794c7" class="vb-nav-menu">

          {desktopNavigation.map((item) => (
            <li
              class:list={[
                "menu-item",
                { "menu-item-has-children": item.children?.length },
              ]}
            >
              <a
                href={item.href}
                class:list={[
                  "vb-item",
                  { "has-submenu": item.children?.length },
                ]}
                aria-haspopup={item.children?.length ? "true" : undefined}
                aria-expanded={item.children?.length ? "false" : undefined}
              >
                {item.label}

                {item.children?.length && (
                  <span class="sub-arrow" aria-hidden="true">
                    <i class="fas fa-caret-down"></i>
                  </span>
                )}
              </a>

              {item.children?.length && (
                <ul class="sub-menu vb-nav-menu--dropdown">

                  {item.children.map((child) => (
                    <li
                      class:list={[
                        "menu-item",
                        {
                          "menu-item-has-children has-flyout":
                            child.children?.length,
                        },
                      ]}
                    >
                      <a
                        href={child.href}
                        class:list={[
                          "vb-sub-item",
                          { "has-submenu": child.children?.length },
                        ]}
                        aria-haspopup={
                          child.children?.length ? "true" : undefined
                        }
                      >
                        {child.label}

                        {child.children?.length && (
                          <span class="flyout-arrow" aria-hidden="true">
                            <i class="fas fa-chevron-right"></i>
                          </span>
                        )}
                      </a>

                      {child.children?.length && (
                        <ul class="vb-sub-flyout">
                          {child.children.map((nested) => (
                            <li class="menu-item">
                              <a
                                href={nested.href}
                                class="vb-sub-item"
                              >
                                {nested.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}

                </ul>
              )}
            </li>
          ))}

          <!-- Reach Us -->
          {reachUs && (
            <li class="menu-item">
              <a href={reachUs.href} class="vb-item">
                {reachUs.label}
              </a>
            </li>
          )}

        </ul>
      </nav>
    </div>
  </div>

  <!-- Search Button -->
  <div class="header-search-trigger-container">
    <button
      id="search-open-btn"
      class="header-search-btn"
      type="button"
      aria-label="Open search dialog"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="header-search-overlay"
    >
      <i class="fas fa-search" aria-hidden="true"></i>
    </button>
  </div>
</div>

<style>
  /* ========================================
     DROPDOWN RESET
  ======================================== */

  .vb-nav-menu .sub-menu.vb-nav-menu--dropdown li,
  .vb-nav-menu .sub-menu.vb-sub-flyout li {
    background: transparent !important;
    background-color: transparent !important;
  }

  .vb-nav-menu .sub-menu.vb-nav-menu--dropdown a.vb-sub-item,
  .vb-nav-menu .sub-menu.vb-sub-flyout a.vb-sub-item {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 11px 20px !important;
    color: #2b2b2b !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    text-decoration: none !important;
    transition: all .18s ease-in-out !important;
  }

  .vb-nav-menu .sub-menu.vb-nav-menu--dropdown li:hover > a.vb-sub-item,
  .vb-nav-menu .sub-menu.vb-sub-flyout li:hover > a.vb-sub-item,
  .vb-nav-menu .sub-menu a.vb-sub-item:hover,
  .vb-nav-menu .sub-menu a.vb-sub-item:focus-visible {
    padding-left: 24px !important;
    background-color: #fcf4f5 !important;
    color: #8b2332 !important;
  }

  .vb-nav-menu .sub-menu li:hover > a.vb-sub-item .flyout-arrow {
    color: #8b2332 !important;
  }

  /* ========================================
     HEADER LAYOUT
  ======================================== */

  .vb-header-desktop-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    width: 100%;
  }

  .vb-nav-menu--main {
    display: flex;
    align-items: center;
  }

  /* ========================================
     MAIN NAVIGATION
  ======================================== */

  .vb-nav-menu {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vb-nav-menu > li {
    position: relative;
    list-style: none;
  }

  .vb-nav-menu > li > a.vb-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 14px !important;
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: #1a1a1a !important;
    font-size: .88rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color .18s ease;
  }

  .vb-nav-menu > li:hover > a.vb-item,
  .vb-nav-menu > li:focus-within > a.vb-item {
    color: #8b2332 !important;
  }

  .vb-nav-menu .sub-arrow {
    display: inline-flex;
    align-items: center;
    margin-left: 2px;
    font-size: .72rem;
    transition: transform .2s ease;
  }

  .vb-nav-menu > li:hover > a .sub-arrow {
    transform: rotate(180deg);
  }

  /* ========================================
     FIRST LEVEL DROPDOWN
  ======================================== */

  .vb-nav-menu .sub-menu.vb-nav-menu--dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 999;
    min-width: 260px;
    margin: 0;
    padding: 8px 0;
    border: 1px solid #ebebeb;
    border-top: 3px solid #8b2332;
    border-radius: 0 0 6px 6px;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, .12);
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity .2s ease,
      transform .2s ease,
      visibility .2s;
  }

  .vb-nav-menu > li:hover > .sub-menu,
  .vb-nav-menu > li:focus-within > .sub-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* ========================================
     DROPDOWN LINKS
  ======================================== */

  .vb-submenu-item,
  .vb-nav-menu .sub-menu > li {
    position: relative;
    list-style: none;
  }

  .vb-nav-menu .sub-menu li a.vb-sub-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    color: #333333;
    font-size: .9rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    transition:
      background-color .15s ease,
      color .15s ease,
      padding-left .15s ease;
  }

  .vb-nav-menu .sub-menu li a.vb-sub-item:hover,
  .vb-nav-menu .sub-menu li:hover > a.vb-sub-item,
  .vb-nav-menu .sub-menu li:focus-within > a.vb-sub-item {
    padding-left: 22px;
    background-color: #fbf5f5 !important;
    color: #8b2332 !important;
  }

  .flyout-arrow {
    display: inline-flex;
    align-items: center;
    margin-left: 12px;
    color: #888888;
    font-size: .75rem;
  }

  /* ========================================
     SECOND LEVEL FLYOUT
  ======================================== */

  .vb-nav-menu .sub-menu .vb-sub-flyout {
    position: absolute;
    top: 0;
    left: 100%;
    z-index: 1000;
    min-width: 240px;
    margin: 0;
    padding: 8px 0;
    border: 1px solid #ebebeb;
    border-radius: 4px;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, .12);
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateX(8px);
    transition:
      opacity .2s ease,
      transform .2s ease,
      visibility .2s;
  }

  .vb-nav-menu .sub-menu li:hover > .vb-sub-flyout,
  .vb-nav-menu .sub-menu li:focus-within > .vb-sub-flyout {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  /* ========================================
     SEARCH BUTTON
  ======================================== */

  .header-search-trigger-container {
    display: flex;
    align-items: center;
    margin-left: 8px;
  }

  .header-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: #1a1a1a;
    font-size: 1.05rem;
    cursor: pointer;
    transition: background-color .2s ease, color .2s ease;
  }

  .header-search-btn:hover,
  .header-search-btn:focus-visible {
    background-color: rgba(0, 0, 0, .05);
    color: #8b2332;
  }

  .header-search-btn:focus-visible {
    outline: 2px solid #8b2332;
    outline-offset: 3px;
  }

  /* ========================================
     RESPONSIVE
  ======================================== */

  @media (max-width: 1024px) {
    .vb-header-desktop-bar {
      display: none;
    }
  }
</style>
