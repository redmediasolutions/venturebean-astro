---
/**
 * Desktop header: main menu with clean multi-level dropdowns 
 * and a slide-over search trigger on the right.
 * Hidden on tablet and mobile.
 */
---

<div
  class="vb-header-desktop-bar vb-element vb-element-99fb249 e-con-full vb-hidden-tablet vb-hidden-mobile e-flex e-con e-child"
  data-id="99fb249"
  data-element_type="container"
  data-e-type="container"
>
  <!-- Navigation Container -->
  <div
    class="vb-element vb-element-36794c7 vb-nav-menu__align-end vb-hidden-tablet vb-hidden-mobile vb-widget__width-auto vb-nav-menu--dropdown-tablet vb-nav-menu__text-align-aside vb-nav-menu--toggle vb-nav-menu--burger vb-widget vb-widget-nav-menu"
    data-id="36794c7"
    data-element_type="widget"
    data-e-type="widget"
    data-settings={'{"layout":"horizontal","submenu_icon":{"value":"<i class=\\"fas fa-caret-down\\" aria-hidden=\\"true\\"><\\/i>","library":"fa-solid"},"toggle":"burger"}'}
    data-widget_type="nav-menu.default"
  >
    <div class="vb-widget-container">
      <nav
        aria-label="Menu"
        class="vb-nav-menu--main vb-nav-menu__container vb-nav-menu--layout-horizontal e--pointer-none"
      >
        <ul id="menu-1-36794c7" class="vb-nav-menu">
          
          <!-- 1. About Us -->
          <li class="menu-item menu-item-has-children">
            <a aria-expanded="false" aria-haspopup="true" href="/about-us/" class="vb-item has-submenu">
              About Us<span class="sub-arrow"><i class="fas fa-caret-down" aria-hidden="true"></i></span>
            </a>
            <ul class="sub-menu vb-nav-menu--dropdown">
              <li class="menu-item">
                <a href="/clients/" class="vb-sub-item">Clients</a>
              </li>
              <li class="menu-item">
                <a href="/testimonials/" class="vb-sub-item">Testimonials</a>
              </li>
              <li class="menu-item">
                <a href="/case-studies/" class="vb-sub-item">Case Studies</a>
              </li>
            </ul>
          </li>

          <!-- 2. Services (Multi-level Flyout) -->
          <li class="menu-item menu-item-has-children">
            <a aria-expanded="false" aria-haspopup="true" href="/services/" class="vb-item has-submenu">
              Services<span class="sub-arrow"><i class="fas fa-caret-down" aria-hidden="true"></i></span>
            </a>
            <ul class="sub-menu vb-nav-menu--dropdown">
              <li class="menu-item">
                <a href="/business-consulting/" class="vb-sub-item">Consulting</a>
              </li>
              <li class="menu-item">
                <a href="/coaching/" class="vb-sub-item">Coaching</a>
              </li>
              
              <li class="menu-item">
                <a href="/organisational-development/" class="vb-sub-item">Organisational Development</a>
              </li>
              <li class="menu-item">
                <a href="/assessments/" class="vb-sub-item">Assessment</a>
              </li>
            </ul>
          </li>

          <!-- 4. Knowledge Hub (Single-level Dropdown) -->
          <li class="menu-item menu-item-has-children">
            <a aria-expanded="false" aria-haspopup="true" href="/knowledge-hub/" class="vb-item has-submenu">
              Knowledge Hub<span class="sub-arrow"><i class="fas fa-caret-down" aria-hidden="true"></i></span>
            </a>
            <ul class="sub-menu vb-nav-menu--dropdown">
              <li class="menu-item">
                <a href="/knowledge-hub/media-spotlight/" class="vb-sub-item">Media Spotlight</a>
              </li>
              <li class="menu-item">
                <a href="/knowledge-hub/industry-perspectives/" class="vb-sub-item">Industry Perspectives</a>
              </li>
              <li class="menu-item">
                <a href="/knowledge-hub/toolkit/" class="vb-sub-item">Toolkit</a>
              </li>
              <li class="menu-item">
                <a href="/knowledge-hub/insights/" class="vb-sub-item">Insights</a>
              </li>
            </ul>
          </li>

          <!-- 5. Reach Us -->
          <li class="menu-item">
            <a href="/contact-us/" class="vb-item">Reach us</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <!-- Search Button (Right-aligned) -->
  <div class="header-search-trigger-container">
    <button
      id="search-open-btn"
      class="header-search-btn"
      type="button"
      aria-label="Open search dialog"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="header-search-overlay"
    >
      <i class="fas fa-search" aria-hidden="true"></i>
    </button>
  </div>
</div>

<style>
  /* Fix Dropdown Hover & Background Overrides */
.vb-nav-menu .sub-menu.vb-nav-menu--dropdown li,
.vb-nav-menu .sub-menu.vb-sub-flyout li {
  background: transparent !important;
  background-color: transparent !important;
}

/* Base item appearance */
.vb-nav-menu .sub-menu.vb-nav-menu--dropdown a.vb-sub-item,
.vb-nav-menu .sub-menu.vb-sub-flyout a.vb-sub-item {
  color: #2b2b2b !important;
  background: transparent !important;
  background-color: transparent !important;
  padding: 11px 20px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  text-decoration: none !important;
  transition: all 0.18s ease-in-out !important;
}

/* Hover state: Subtle brand background + clear red text */
.vb-nav-menu .sub-menu.vb-nav-menu--dropdown li:hover > a.vb-sub-item,
.vb-nav-menu .sub-menu.vb-sub-flyout li:hover > a.vb-sub-item,
.vb-nav-menu .sub-menu a.vb-sub-item:hover,
.vb-nav-menu .sub-menu a.vb-sub-item:focus {
  background-color: #fcf4f5 !important; /* Soft rose tint */
  color: #8b2332 !important;            /* High-contrast brand red */
  padding-left: 24px !important;        /* Smooth nudge effect */
}

/* Flyout arrow color sync on hover */
.vb-nav-menu .sub-menu li:hover > a.vb-sub-item .flyout-arrow,
.vb-nav-menu .sub-menu a.vb-sub-item:hover .flyout-arrow {
  color: #8b2332 !important;
}

  /* Header Bar Layout */
  .vb-header-desktop-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    width: 100%;
  }

  /* Reset Top-Level Menu Items */
  .vb-nav-menu {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 4px;
  }

  .vb-nav-menu > li {
    position: relative;
  }

  .vb-nav-menu > li > a.vb-item {
    background: transparent !important;
    background-color: transparent !important;
    color: #1a1a1a !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 12px 14px !important;
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .vb-nav-menu > li:hover > a.vb-item,
  .vb-nav-menu > li > a.vb-item:hover {
    color: #8b2332 !important;
  }

  .vb-nav-menu .sub-arrow {
    display: inline-flex;
    font-size: 0.72rem;
    margin-left: 2px;
  }

  /* Level 1 Dropdown */
  .vb-nav-menu .sub-menu.vb-nav-menu--dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 260px;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    border: 1px solid #ebebeb;
    border-top: 3px solid #8b2332;
    border-radius: 0 0 6px 6px;
    list-style: none;
    padding: 8px 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 999;
  }

  .vb-nav-menu > li:hover > .sub-menu.vb-nav-menu--dropdown,
  .vb-nav-menu > li:focus-within > .sub-menu.vb-nav-menu--dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Dropdown Link Items */
  .sub-menu li {
    position: relative;
    list-style: none;
  }

  .sub-menu li a.vb-sub-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    color: #333333;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    line-height: 1.4;
    transition: background-color 0.15s ease, color 0.15s ease, padding-left 0.15s ease;
  }

  .sub-menu li a.vb-sub-item:hover,
  .sub-menu li:hover > a.vb-sub-item {
    background-color: #fbf5f5;
    color: #8b2332;
    padding-left: 22px;
  }

  .flyout-arrow {
    font-size: 0.75rem;
    color: #888888;
    margin-left: 12px;
  }

  /* Level 2 Sub-Flyout */
  .sub-menu .vb-sub-flyout {
    position: absolute;
    top: 0;
    left: 100%;
    min-width: 240px;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    border: 1px solid #ebebeb;
    border-radius: 4px;
    list-style: none;
    padding: 8px 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateX(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 1000;
  }

  .sub-menu li.has-flyout:hover > .vb-sub-flyout,
  .sub-menu li.has-flyout:focus-within > .vb-sub-flyout {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  /* Right-Aligned Search Trigger */
  .header-search-trigger-container {
    display: flex;
    align-items: center;
    margin-left: 8px;
  }

  .header-search-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    width: 40px;
    height: 40px;
    font-size: 1.05rem;
    color: #1a1a1a;
    border-radius: 50%;
    transition: background-color 0.2s ease, color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-search-btn:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: #8b2332;
  }
</style>
