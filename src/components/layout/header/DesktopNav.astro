---
/**
 * Desktop header: main menu with clean multi-level dropdowns 
 * and a slide-over search trigger on the right.
 * Hidden on tablet and mobile.
 */
---

<div
  class="vb-header-desktop-bar vb-element vb-element-99fb249 e-con-full vb-hidden-tablet vb-hidden-mobile e-flex e-con e-child"
  data-id="99fb249"
  data-element_type="container"
  data-e-type="container"
>
  <!-- Navigation Container -->
  <div
    class="vb-element vb-element-36794c7 vb-nav-menu__align-end vb-hidden-tablet vb-hidden-mobile vb-widget__width-auto vb-nav-menu--dropdown-tablet vb-nav-menu__text-align-aside vb-nav-menu--toggle vb-nav-menu--burger vb-widget vb-widget-nav-menu"
    data-id="36794c7"
    data-element_type="widget"
    data-e-type="widget"
    data-settings={'{"layout":"horizontal","submenu_icon":{"value":"<i class=\\"fas fa-caret-down\\" aria-hidden=\\"true\\"><\\/i>","library":"fa-solid"},"toggle":"burger"}'}
    data-widget_type="nav-menu.default"
  >
    <div class="vb-widget-container">
      <nav
        aria-label="Menu"
        class="vb-nav-menu--main vb-nav-menu__container vb-nav-menu--layout-horizontal e--pointer-none"
      >
        <ul id="menu-1-36794c7" class="vb-nav-menu">
          
          <!-- 1. About Us -->
          <li class="menu-item menu-item-has-children">
            <a aria-expanded="false" aria-haspopup="true" href="/about-us/" class="vb-item has-submenu">
