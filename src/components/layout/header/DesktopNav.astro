            </a>
            <ul class="sub-menu vb-nav-menu--dropdown">
              <li class="menu-item">
                <a href="/clients/" class="vb-sub-item">Clients</a>
              </li>
              <li class="menu-item">
                <a href="/testimonials/" class="vb-sub-item">Testimonials</a>
              </li>
              <li class="menu-item">
                <a href="/case-studies/" class="vb-sub-item">Case Studies</a>
              </li>
            </ul>
          </li>

          <!-- 2. Services (Multi-level Flyout) -->
          <li class="menu-item menu-item-has-children">
            <a aria-expanded="false" aria-haspopup="true" href="/services/" class="vb-item has-submenu">
              Services<span class="sub-arrow"><i class="fas fa-caret-down" aria-hidden="true"></i></span>
            </a>
            <ul class="sub-menu vb-nav-menu--dropdown">
              <li class="menu-item">
                <a href="/business-consulting/" class="vb-sub-item">Consulting</a>
              </li>
              <li class="menu-item">
                <a href="/coaching/" class="vb-sub-item">Coaching</a>
              </li>
              
              <!-- Nested: Organisational Development 
              <li class="menu-item menu-item-has-children has-flyout">
                <a href="/organisational-development/" class="vb-sub-item has-submenu">
                  Organisational Development
                  <span class="flyout-arrow"><i class="fas fa-caret-right" aria-hidden="true"></i></span>
                </a>
                <ul class="sub-menu vb-sub-flyout">
                  <li class="menu-item">
                    <a href="/organisational-development/" class="vb-sub-item">OD Consulting</a>
                  </li>
                  <li class="menu-item">
                    <a href="/management-games/" class="vb-sub-item">Management Games</a>
                  </li>
                </ul>
              </li>
              -->

              <!-- Nested: Assessments 
              <li class="menu-item menu-item-has-children has-flyout">
                <a href="/assessments/" class="vb-sub-item has-submenu">
                  Assessments
                  <span class="flyout-arrow"><i class="fas fa-caret-right" aria-hidden="true"></i></span>
                </a>
                <ul class="sub-menu vb-sub-flyout">
                  <li class="menu-item">
                    <a href="/assessments/motivation-factor/" class="vb-sub-item">Motivation Factor</a>
                  </li>
                  <li class="menu-item">
                    <a href="/assessments/mcode/" class="vb-sub-item">Mcode</a>
                  </li>
                  <li class="menu-item">
                    <a href="/assessments/greenspire/" class="vb-sub-item">Greenspire</a>
                  </li>
                </ul>
              </li>
              -->
            </ul>
          </li>

          <!-- 4. Knowledge Hub (Single-level Dropdown) -->
          <li class="menu-item menu-item-has-children">
            <a aria-expanded="false" aria-haspopup="true" href="/knowledge-hub/" class="vb-item has-submenu">
              Knowledge Hub<span class="sub-arrow"><i class="fas fa-caret-down" aria-hidden="true"></i></span>
            </a>
            <ul class="sub-menu vb-nav-menu--dropdown">
              <li class="menu-item">
                <a href="/knowledge-hub/media-spotlight/" class="vb-sub-item">Media Spotlight</a>
              </li>
              <li class="menu-item">
                <a href="/knowledge-hub/industry-perspectives/" class="vb-sub-item">Industry Perspectives</a>
              </li>
              <li class="menu-item">
                <a href="/knowledge-hub/toolkit/" class="vb-sub-item">Toolkit</a>
