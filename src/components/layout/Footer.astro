---
import Icon from '../ui/Icon.astro';
import { footer } from '../../data/site.js';
import { link } from '../../utils/links.js';
---

<footer class="ftr" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="visually-hidden">Footer</h2>
  <div class="container">
    <div class="ftr__top">
      <div class="ftr__brand" data-reveal>
        <a href="/" class="ftr__logo" aria-label="VentureBean — home">
          <img src="/images/logo.svg" alt="VentureBean" width="180" height="51" loading="lazy" />
        </a>
        <p class="ftr__tagline">{footer.tagline}</p>
      </div>

      <div class="ftr__cols">
        <section class="ftr__col" data-reveal style="--i:1">
          <h3 class="ftr__title">{footer.quickLinksTitle}</h3>
          <ul role="list" class="ftr__links">
            {
              footer.quickLinks.map((l) => (
                <li>
                  <a href={link(l.href)}>
                    <span>{l.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="ftr__col" data-reveal style="--i:2">
          <h3 class="ftr__title">{footer.locationTitle}</h3>
          <address class="ftr__address">
            <Icon name="pin" size={18} class="ftr__ico" />
            <span>
              <strong>{footer.address[0]}</strong>
              {footer.address.slice(1).map((line) => <><br />{line}</>)}
            </span>
          </address>
        </section>

        <section class="ftr__col" data-reveal style="--i:3">
          <h3 class="ftr__title">{footer.contactTitle}</h3>
          <ul role="list" class="ftr__contact">
            <li>
              <Icon name="phone" size={18} class="ftr__ico" />
              <a href={footer.phone.href}>{footer.phone.label}</a>
            </li>
            <li>
              <Icon name="mail" size={18} class="ftr__ico" />
              <a href={footer.email.href}>{footer.email.label}</a>
            </li>
            <li>
              <Icon name="id" size={18} class="ftr__ico" />
              <span>{footer.cin}</span>
            </li>
          </ul>
          <ul role="list" class="ftr__social">
            {
              footer.social.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener noreferrer">
                    <Icon name={s.icon} size={18} />
                    <span>{s.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>

    <div class="ftr__bottom">
      <p>
        {footer.copyright}{' '}
        <a href={footer.credit.href} target="_blank" rel="noopener noreferrer">{footer.credit.label}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    background: var(--vb-navy-950);
    color: var(--color-on-dark-muted);
    padding-top: clamp(4rem, 3rem + 5vw, 7.5rem);
    overflow: hidden;
  }
  .ftr::before {
    /* soft brand glow */
    content: '';
    position: absolute;
    width: 60vw;
    aspect-ratio: 1;
    right: -20vw;
    top: -30vw;
    background: radial-gradient(closest-side, rgb(107 50 52 / 0.35), transparent);
    pointer-events: none;
  }
  .ftr__top {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(2.5rem, 5vw, 6rem);
    padding-bottom: clamp(3rem, 5vw, 5rem);
  }
  .ftr__logo {
    display: inline-block;
    padding: 0.8rem 1.1rem;
    background: #fff;
    border-radius: var(--radius-md);
    transition: transform var(--dur) var(--ease-out);
  }
  .ftr__logo:hover {
    transform: translateY(-3px);
  }
  .ftr__logo img {
    width: 170px;
    height: auto;
  }
  .ftr__tagline {
    margin-top: 1.75rem;
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: #fff;
  }
  .ftr__cols {
    display: grid;
    grid-template-columns: 0.8fr 1.1fr 1.1fr;
    gap: 2.5rem;
  }
  .ftr__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #fff;
    margin-bottom: 1.4rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-dark);
  }
  .ftr__links {
    display: grid;
    gap: 0.35rem;
  }
  .ftr__links a {
    position: relative;
    display: inline-flex;
    padding-block: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-on-dark-muted);
    transition:
      color var(--dur-fast),
      transform var(--dur) var(--ease-out);
  }
  .ftr__links a:hover {
    color: #fff;
    transform: translateX(6px);
  }
  .ftr__address,
  .ftr__contact li {
    display: flex;
    gap: 0.75rem;
    font-style: normal;
    line-height: 1.7;
    font-size: 0.9375rem;
  }
  .ftr__address strong {
    color: #fff;
    font-weight: 600;
  }
  .ftr__contact {
    display: grid;
    gap: 0.7rem;
  }
  .ftr__contact a {
    color: #fff;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size var(--dur) var(--ease-out);
  }
  .ftr__contact a:hover {
    background-size: 100% 1px;
  }
  .ftr :global(.ftr__ico) {
    flex: none;
    margin-top: 0.3rem;
    color: var(--vb-brown-300);
  }
  .ftr__social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .ftr__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-dark);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      background-color var(--dur-fast),
      border-color var(--dur-fast),
      color var(--dur-fast);
  }
  .ftr__social a:hover {
    background: #fff;
    border-color: #fff;
    color: var(--vb-navy-800);
  }
  .ftr__bottom {
    position: relative;
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-border-dark);
    font-size: 0.8125rem;
  }
  .ftr__bottom a {
    color: #fff;
    font-weight: 600;
  }
  .ftr__bottom a:hover {
    color: var(--vb-brown-300);
  }

  @media (max-width: 1023px) {
    .ftr__top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 719px) {
    .ftr__cols {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .ftr__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
