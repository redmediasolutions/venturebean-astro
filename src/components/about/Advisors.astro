            <div class="vb-image-box-content">
              <h3 class="vb-image-box-title">
                <a href="#vb-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjIwMjcwIiwidG9nZ2xlIjpmYWxzZX0%3D"
                  >Vinod Thomas</a>
              </h3>
              <p class="vb-image-box-description"><strong>Technology and Digital Transformation</strong></p>
            </div>
          </div>
        </div>
      </div>
      <div
        class="vb-element vb-element-35e48a8 vb-position-left vb-vertical-align-middle vb-widget vb-widget-image-box"
        data-id="35e48a8"
        data-element_type="widget"
        data-e-type="widget"
