---
/**
 * About Us page: “Our Advisors” section.
 */
---

<div
  class="vb-element vb-element-bd3ec2f e-flex e-con-boxed e-con e-parent"
  data-id="bd3ec2f"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic","shape_divider_top":"opacity-tilt"}'}
>
  <div class="e-con-inner">
    <div class="vb-shape vb-shape-top" aria-hidden="true" data-negative="false">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2600 131.1" preserveAspectRatio="none">
        <path class="vb-shape-fill" d="M0 0L2600 0 2600 69.1 0 0z"></path>
        <path class="vb-shape-fill" style="opacity:0.5" d="M0 0L2600 0 2600 69.1 0 69.1z"></path>
        <path class="vb-shape-fill" style="opacity:0.25" d="M2600 0L0 0 0 130.1 2600 69.1z"></path>
      </svg>
    </div>
    <div
      class="vb-element vb-element-fc89054 e-con-full e-flex e-con e-child"
      data-id="fc89054"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-675dd1e vb-widget vb-widget-heading"
        data-id="675dd1e"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="heading.default"
      >
        <div class="vb-widget-container">
          <h2 class="vb-heading-title vb-size-default">Our Advisors</h2>
        </div>
      </div>
      <div
        class="vb-element vb-element-f125c08 vb-widget vb-widget-text-editor"
        data-id="f125c08"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="text-editor.default"
      >
        <div class="vb-widget-container">
          <p class="p1"><b>Strategic Advisors Enabling Visionary Growth and Leadership.</b></p>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-6efc405 e-grid e-con-full e-con e-child"
      data-id="6efc405"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-0f68639 vb-position-left vb-vertical-align-middle vb-widget vb-widget-image-box"
        data-id="0f68639"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="image-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-image-box-wrapper">
            <figure class="vb-image-box-img">
              <a
                href="#vb-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjIwMjY3IiwidG9nZ2xlIjpmYWxzZX0%3D"
                tabindex="-1"
                ><img
                  loading="lazy"
                  decoding="async"
                  width="210"
                  height="210"
                  src="/assets/uploads/2024/06/tm9.png"
                  class="vb-animation-pop attachment-full size-full site-image-12319"
                  alt="Marketing and Branding ​| VentureBean"
                  srcset="/assets/uploads/2024/06/tm9.png 210w, /assets/uploads/2024/06/tm9-150x150.png 150w, /assets/uploads/2024/06/tm9-75x75.png 75w"
                  sizes="(max-width: 210px) 100vw, 210px"
                /></a>
            </figure>
            <div class="vb-image-box-content">
              <h3 class="vb-image-box-title">
                <a href="#vb-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjIwMjY3IiwidG9nZ2xlIjpmYWxzZX0%3D"
