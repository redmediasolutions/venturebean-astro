---
/**
 * About Us page: “Stewardship” section.
 */
---

<div
  class="vb-element vb-element-cce314c e-grid e-con-boxed e-con e-parent"
  data-id="cce314c"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-9833715 e-con-full e-flex e-con e-child"
      data-id="9833715"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-ef1e786 vb-position-inline-start vb-view-default vb-mobile-position-block-start vb-widget vb-widget-icon-box"
        data-id="ef1e786"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-icon-box-wrapper">
            <div class="vb-icon-box-icon">
              <span class="vb-icon"> <i aria-hidden="true" class="fas fa-th-large"></i> </span>
            </div>
            <div class="vb-icon-box-content">
              <h3 class="vb-icon-box-title"><span> Stewardship </span></h3>
              <p class="vb-icon-box-description">
                We build trust through integrity, accountability and responsible leadership.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-c5328af e-con-full e-flex e-con e-child"
      data-id="c5328af"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-ad3be48 vb-position-inline-start vb-view-default vb-mobile-position-block-start vb-widget vb-widget-icon-box"
        data-id="ad3be48"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-icon-box-wrapper">
            <div class="vb-icon-box-icon">
              <span class="vb-icon"> <i aria-hidden="true" class="fas fa-toggle-off"></i> </span>
            </div>
            <div class="vb-icon-box-content">
              <h3 class="vb-icon-box-title"><span> Growth </span></h3>
              <p class="vb-icon-box-description">We encourage continuous learning, development and transformation.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-c4a3172 e-con-full e-flex e-con e-child"
      data-id="c4a3172"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-5f5d871 vb-position-inline-start vb-view-default vb-mobile-position-block-start vb-widget vb-widget-icon-box"
        data-id="5f5d871"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-icon-box-wrapper">
            <div class="vb-icon-box-icon">
              <span class="vb-icon"> <i aria-hidden="true" class="fas fa-sync-alt"></i> </span>
            </div>
            <div class="vb-icon-box-content">
              <h3 class="vb-icon-box-title"><span> Impact </span></h3>
              <p class="vb-icon-box-description">
                We translate strategy, leadership and capability into measurable, sustainable value.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
