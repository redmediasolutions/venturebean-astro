---
/**
 * About Us page: “Purpose-Led” section.
 */
---

<div
  class="vb-element vb-element-5378d20 e-flex e-con-boxed e-con e-parent"
  data-id="5378d20"
  data-element_type="container"
  data-e-type="container"
  data-settings={'{"background_background":"classic"}'}
>
  <div class="e-con-inner">
    <div
      class="vb-element vb-element-c4fc9bc e-con-full e-flex e-con e-child"
      data-id="c4fc9bc"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-efa5daf vb-position-inline-start vb-view-default vb-mobile-position-block-start vb-widget vb-widget-icon-box"
        data-id="efa5daf"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-icon-box-wrapper">
            <div class="vb-icon-box-icon">
              <span class="vb-icon"> <i aria-hidden="true" class="fas fa-street-view"></i> </span>
            </div>
            <div class="vb-icon-box-content">
              <h3 class="vb-icon-box-title"><span> Purpose-Led </span></h3>
              <p class="vb-icon-box-description">
                We seek to understand before we advise, to build stronger leaders, teams and organisations.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="vb-element vb-element-739c2e8 e-con-full e-flex e-con e-child"
      data-id="739c2e8"
      data-element_type="container"
      data-e-type="container"
    >
      <div
        class="vb-element vb-element-56f0755 vb-position-inline-start vb-view-default vb-mobile-position-block-start vb-widget vb-widget-icon-box"
        data-id="56f0755"
        data-element_type="widget"
        data-e-type="widget"
        data-widget_type="icon-box.default"
      >
        <div class="vb-widget-container">
          <div class="vb-icon-box-wrapper">
            <div class="vb-icon-box-icon">
              <span class="vb-icon"> <i aria-hidden="true" class="fas fa-stream"></i> </span>
            </div>
            <div class="vb-icon-box-content">
              <h3 class="vb-icon-box-title"><span> Excellence </span></h3>
              <p class="vb-icon-box-description">
                We take ownership to deliver high-quality, practical and outcome-focused solutions.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
