  youtube: '<path d="M22 8.2s-.2-1.6-.9-2.3c-.9-.9-1.8-.9-2.3-1C15.6 4.7 12 4.7 12 4.7s-3.6 0-6.8.2c-.5.1-1.4.1-2.3 1-.7.7-.9 2.3-.9 2.3S1.8 10 1.8 11.9v1.7c0 1.9.2 3.7.2 3.7s.2 1.6.9 2.3c.9.9 2 .9 2.5 1 1.8.2 7.6.2 7.6.2s3.6 0 6.8-.2c.5-.1 1.4-.1 2.3-1 .7-.7.9-2.3.9-2.3s.2-1.8.2-3.7v-1.7c0-1.9-.2-3.7-.2-3.7zM9.9 15.1V8.9l5.5 3.1z" fill="currentColor" stroke="none"/>',
