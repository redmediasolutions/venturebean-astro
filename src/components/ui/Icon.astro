  signal: '<path d="M4 20v-3M8.5 20v-6M13 20v-9M17.5 20V7M22 20V4"/>',
  target: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="currentColor"/>',
