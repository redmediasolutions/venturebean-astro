  teacher: '<rect x="8" y="3.5" width="12.5" height="9" rx="1"/><circle cx="6" cy="10" r="2.2"/><path d="M2.5 20v-2.5A3.5 3.5 0 0 1 6 14h1.5l3.5-2.5M11 20h9"/>',
