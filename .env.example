# Firebase keys for the Content Manager (same project as the admin panel).
# Copy this file to ".env" and fill in the values — they're the same as the
# NEXT_PUBLIC_FIREBASE_… values in the admin panel's .env.local.
# Also add them to your hosting provider's environment variables, so the
# live build can load the client logos.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
